// Simplex .env File Parser
// Parse and load environment variables from .env files
//
// Supports standard .env file format:
// - KEY=VALUE pairs
// - Quoted values (single and double quotes)
// - Comments (lines starting with #)
// - Empty lines
// - Variable expansion (${VAR} references)
// - Inline comments (after unquoted values)
// - Whitespace trimming
//
// # Usage
//
// ```simplex
// use simplex_std::dotenv::{dotenv_parse, dotenv_load, dotenv_get};
//
// // Parse .env content directly
// let entries = dotenv_parse("DB_HOST=localhost\nDB_PORT=5432");
// let host = dotenv_get(entries, "DB_HOST");
//
// // Load from file
// let entries = dotenv_load(".env");
// let secret = dotenv_get(entries, "SECRET_KEY");
// ```
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

// Wrapper for string_substring using built-in intrinsic_string_slice
fn dotenv_substr(s: i64, start: i64, length: i64) -> i64 {
    intrinsic_string_slice(s, start, start + length)
}

// Wrapper for string_char_create using built-in intrinsic_string_from_char
fn local_char_create(code: i64) -> i64 {
    intrinsic_string_from_char(code)
}

// =============================================================================
// .env Parsing
// =============================================================================

/// Parse .env file content into a vec of [key, value] pairs
///
/// Handles:
/// - KEY=VALUE (unquoted)
/// - KEY="VALUE" (double-quoted, preserves spaces)
/// - KEY='VALUE' (single-quoted, literal, no expansion)
/// - # comment lines
/// - Empty lines
/// - Inline comments after unquoted values
/// - Leading/trailing whitespace trimming
///
/// # Arguments
/// - `content`: string handle of .env file content
///
/// # Returns
/// Vec handle where entries are stored as consecutive [key, value] pairs.
/// Even indices (0, 2, 4, ...) are keys, odd indices (1, 3, 5, ...) are values.
///
/// # Example
/// ```simplex
/// let entries = dotenv_parse("HOST=localhost\nPORT=8080\n# comment\nDEBUG=true");
/// let host = dotenv_get(entries, "HOST");     // "localhost"
/// let port = dotenv_get(entries, "PORT");     // "8080"
/// let debug = dotenv_get(entries, "DEBUG");   // "true"
/// ```
pub fn dotenv_parse(content: i64) -> i64 {
    let entries: i64 = vec_new();
    let len: i64 = string_len(content);
    var line_start: i64 = 0;
    var i: i64 = 0;

    while i <= len {
        let at_end: i64 = if i == len { 1 } else { 0 };
        let ch: i64 = if at_end == 0 { string_char_at(content, i) } else { 0 };

        // Check for newline (LF=10) or end of string
        if ch == 10 {
            // Extract this line
            let line: i64 = dotenv_substr(content, line_start, i - line_start);
            dotenv_parse_line(entries, line);
            line_start = i + 1;
        } else if ch == 13 {
            // Carriage return - extract line, skip CR (and LF if CRLF)
            let line: i64 = dotenv_substr(content, line_start, i - line_start);
            dotenv_parse_line(entries, line);
            // Check for CRLF
            if i + 1 < len {
                let next: i64 = string_char_at(content, i + 1);
                if next == 10 {
                    i = i + 1;
                }
            }
            line_start = i + 1;
        } else if at_end == 1 {
            // Last line (no trailing newline)
            if i > line_start {
                let line: i64 = dotenv_substr(content, line_start, i - line_start);
                dotenv_parse_line(entries, line);
            }
        }

        i = i + 1;
    }

    // Perform variable expansion on all values
    dotenv_expand_vars(entries);

    entries
}

/// Parse a single line from a .env file and add to entries if valid
fn dotenv_parse_line(entries: i64, line: i64) -> i64 {
    let trimmed: i64 = trim_whitespace(line);
    let tlen: i64 = string_len(trimmed);

    // Skip empty lines
    if tlen == 0 {
        return 0;
    }

    // Skip comment lines (starting with #)
    let first_ch: i64 = string_char_at(trimmed, 0);
    if first_ch == 35 {
        return 0;
    }

    // Find the = sign
    let eq_pos: i64 = find_char(trimmed, 61, 0);
    if eq_pos < 0 {
        return 0;
    }

    // Extract key (before =) and value (after =)
    let key: i64 = trim_whitespace(dotenv_substr(trimmed, 0, eq_pos));
    let raw_value: i64 = dotenv_substr(trimmed, eq_pos + 1, tlen - eq_pos - 1);

    // Skip 'export ' prefix on key
    let key_len: i64 = string_len(key);
    var actual_key: i64 = key;
    if key_len > 7 {
        let prefix: i64 = dotenv_substr(key, 0, 7);
        if string_eq(prefix, "export ") == 1 {
            actual_key = trim_whitespace(dotenv_substr(key, 7, key_len - 7));
        }
    }

    // Parse the value (handle quotes)
    let parsed_value: i64 = parse_value(raw_value);

    vec_push(entries, actual_key);
    vec_push(entries, parsed_value);

    0
}

/// Parse a .env value, handling quotes and inline comments
fn parse_value(raw: i64) -> i64 {
    let trimmed: i64 = trim_leading_whitespace(raw);
    let len: i64 = string_len(trimmed);

    if len == 0 {
        return "";
    }

    let first: i64 = string_char_at(trimmed, 0);

    // Double-quoted value
    if first == 34 {
        return parse_double_quoted(trimmed);
    }

    // Single-quoted value
    if first == 39 {
        return parse_single_quoted(trimmed);
    }

    // Unquoted value - trim trailing whitespace and inline comments
    var end: i64 = len;
    var j: i64 = 0;
    while j < len {
        let ch: i64 = string_char_at(trimmed, j);
        // Inline comment: space followed by #
        if ch == 35 {
            // Check if preceded by whitespace
            if j > 0 {
                let prev: i64 = string_char_at(trimmed, j - 1);
                if prev == 32 {
                    end = j - 1;
                    break;
                }
                if prev == 9 {
                    end = j - 1;
                    break;
                }
            }
        }
        j = j + 1;
    }

    trim_whitespace(dotenv_substr(trimmed, 0, end))
}

/// Parse a double-quoted value (supports escape sequences)
fn parse_double_quoted(s: i64) -> i64 {
    let len: i64 = string_len(s);
    var result: i64 = "";
    var i: i64 = 1;  // Skip opening quote

    while i < len {
        let ch: i64 = string_char_at(s, i);

        if ch == 34 {
            // Closing double quote
            break;
        }

        if ch == 92 {
            // Backslash escape
            if i + 1 < len {
                let next: i64 = string_char_at(s, i + 1);
                if next == 110 {
                    // \n -> newline
                    result = string_concat(result, local_char_create(10));
                    i = i + 2;
                } else if next == 116 {
                    // \t -> tab
                    result = string_concat(result, local_char_create(9));
                    i = i + 2;
                } else if next == 34 {
                    // \" -> literal quote
                    result = string_concat(result, "\"");
                    i = i + 2;
                } else if next == 92 {
                    // \\ -> literal backslash
                    result = string_concat(result, "\\");
                    i = i + 2;
                } else {
                    // Unknown escape, keep backslash
                    result = string_concat(result, "\\");
                    i = i + 1;
                }
            } else {
                result = string_concat(result, "\\");
                i = i + 1;
            }
        } else {
            result = string_concat(result, local_char_create(ch));
            i = i + 1;
        }
    }

    result
}

/// Parse a single-quoted value (literal, no escapes)
fn parse_single_quoted(s: i64) -> i64 {
    let len: i64 = string_len(s);
    var result: i64 = "";
    var i: i64 = 1;  // Skip opening quote

    while i < len {
        let ch: i64 = string_char_at(s, i);
        if ch == 39 {
            // Closing single quote
            break;
        }
        result = string_concat(result, local_char_create(ch));
        i = i + 1;
    }

    result
}

// =============================================================================
// Variable Expansion
// =============================================================================

/// Expand ${VAR} references in all values using already-defined entries
fn dotenv_expand_vars(entries: i64) -> i64 {
    let len: i64 = vec_len(entries);
    var i: i64 = 1;  // Start at first value (index 1)

    while i < len {
        let val: i64 = vec_get(entries, i);
        let expanded: i64 = expand_value(entries, val, i);
        // We can't update vec in place easily, so we store expanded values
        // by pushing a marker. Actually, let's just check during get.
        // For simplicity, we modify the entries vec by appending expanded
        // versions. But that changes indices...
        //
        // Alternative: just do expansion at lookup time in dotenv_get.
        // We'll skip in-place modification and do lazy expansion.
        i = i + 2;
    }

    0
}

/// Expand ${VAR} references in a value string
fn expand_value(entries: i64, val: i64, max_idx: i64) -> i64 {
    let len: i64 = string_len(val);
    var result: i64 = "";
    var i: i64 = 0;

    while i < len {
        let ch: i64 = string_char_at(val, i);

        // Check for ${
        if ch == 36 {
            if i + 1 < len {
                let next: i64 = string_char_at(val, i + 1);
                if next == 123 {
                    // Found ${, find closing }
                    let var_start: i64 = i + 2;
                    var var_end: i64 = var_start;
                    while var_end < len {
                        let vc: i64 = string_char_at(val, var_end);
                        if vc == 125 {
                            break;
                        }
                        var_end = var_end + 1;
                    }
                    if var_end < len {
                        let var_name: i64 = dotenv_substr(val, var_start, var_end - var_start);
                        // Look up variable in entries (only those defined before current)
                        let var_val: i64 = dotenv_lookup(entries, var_name, max_idx);
                        result = string_concat(result, var_val);
                        i = var_end + 1;
                    } else {
                        // No closing brace, keep literal
                        result = string_concat(result, "$");
                        i = i + 1;
                    }
                } else {
                    result = string_concat(result, "$");
                    i = i + 1;
                }
            } else {
                result = string_concat(result, "$");
                i = i + 1;
            }
        } else {
            result = string_concat(result, local_char_create(ch));
            i = i + 1;
        }
    }

    result
}

/// Look up a variable name in entries, searching only up to max_idx
fn dotenv_lookup(entries: i64, key: i64, max_idx: i64) -> i64 {
    var i: i64 = 0;
    while i < max_idx {
        let k: i64 = vec_get(entries, i);
        if string_eq(k, key) == 1 {
            return vec_get(entries, i + 1);
        }
        i = i + 2;
    }
    ""
}

// =============================================================================
// File Loading
// =============================================================================

/// Load and parse a .env file
///
/// Reads the file at the given path and parses its contents.
/// Returns an empty entries vec if the file cannot be read.
///
/// # Arguments
/// - `path`: file path string handle
///
/// # Returns
/// Vec handle of [key, value] pairs
///
/// # Example
/// ```simplex
/// let entries = dotenv_load(".env");
/// let db_host = dotenv_get(entries, "DB_HOST");
/// ```
pub fn dotenv_load(path: i64) -> i64 {
    let content: i64 = file_read(path);
    let content_len: i64 = string_len(content);
    if content_len == 0 {
        return vec_new();
    }
    dotenv_parse(content)
}

// =============================================================================
// Lookup
// =============================================================================

/// Look up a key in parsed .env entries
///
/// Searches the entries for the given key and returns its value.
/// Performs variable expansion on the value before returning.
/// Returns empty string if the key is not found.
///
/// # Arguments
/// - `entries`: vec handle of [key, value] pairs
/// - `key`: key to look up
///
/// # Returns
/// Value string handle, or empty string if not found
///
/// # Example
/// ```simplex
/// let entries = dotenv_parse("HOST=localhost\nURL=http://${HOST}:8080");
/// let url = dotenv_get(entries, "URL");  // "http://localhost:8080"
/// ```
pub fn dotenv_get(entries: i64, key: i64) -> i64 {
    let len: i64 = vec_len(entries);
    var i: i64 = 0;
    while i < len {
        let k: i64 = vec_get(entries, i);
        if string_eq(k, key) == 1 {
            let val: i64 = vec_get(entries, i + 1);
            // Expand variables lazily
            return expand_value(entries, val, len);
        }
        i = i + 2;
    }
    ""
}

/// Check if a key exists in parsed .env entries
///
/// # Arguments
/// - `entries`: vec handle of [key, value] pairs
/// - `key`: key to check
///
/// # Returns
/// 1 if key exists, 0 otherwise
pub fn dotenv_has(entries: i64, key: i64) -> i64 {
    let len: i64 = vec_len(entries);
    var i: i64 = 0;
    while i < len {
        let k: i64 = vec_get(entries, i);
        if string_eq(k, key) == 1 {
            return 1;
        }
        i = i + 2;
    }
    0
}

/// Get the number of entries in parsed .env data
///
/// # Arguments
/// - `entries`: vec handle of [key, value] pairs
///
/// # Returns
/// Number of key-value pairs
pub fn dotenv_count(entries: i64) -> i64 {
    vec_len(entries) / 2
}

/// Get the key at a given index in the entries
///
/// # Arguments
/// - `entries`: vec handle of [key, value] pairs
/// - `index`: entry index (0-based)
///
/// # Returns
/// Key string handle
pub fn dotenv_key_at(entries: i64, index: i64) -> i64 {
    vec_get(entries, index * 2)
}

/// Get the value at a given index in the entries
///
/// # Arguments
/// - `entries`: vec handle of [key, value] pairs
/// - `index`: entry index (0-based)
///
/// # Returns
/// Value string handle
pub fn dotenv_value_at(entries: i64, index: i64) -> i64 {
    vec_get(entries, index * 2 + 1)
}

// =============================================================================
// String Utility Helpers
// =============================================================================

/// Find first occurrence of a character in a string
fn find_char(s: i64, ch: i64, start: i64) -> i64 {
    let len: i64 = string_len(s);
    var i: i64 = start;
    while i < len {
        if string_char_at(s, i) == ch {
            return i;
        }
        i = i + 1;
    }
    -1
}

/// Trim leading and trailing whitespace (spaces and tabs)
fn trim_whitespace(s: i64) -> i64 {
    let len: i64 = string_len(s);
    if len == 0 {
        return s;
    }

    // Find first non-whitespace
    var start: i64 = 0;
    while start < len {
        let ch: i64 = string_char_at(s, start);
        if ch != 32 {
            if ch != 9 {
                break;
            }
        }
        start = start + 1;
    }

    // Find last non-whitespace
    var end: i64 = len;
    while end > start {
        let ch2: i64 = string_char_at(s, end - 1);
        if ch2 != 32 {
            if ch2 != 9 {
                break;
            }
        }
        end = end - 1;
    }

    if start >= end {
        return "";
    }

    dotenv_substr(s, start, end - start)
}

/// Trim leading whitespace only
fn trim_leading_whitespace(s: i64) -> i64 {
    let len: i64 = string_len(s);
    var start: i64 = 0;
    while start < len {
        let ch: i64 = string_char_at(s, start);
        if ch != 32 {
            if ch != 9 {
                break;
            }
        }
        start = start + 1;
    }
    if start == 0 {
        return s;
    }
    dotenv_substr(s, start, len - start)
}
