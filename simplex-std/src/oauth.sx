// Simplex OAuth 2.0 Library
// OAuth 2.0 Authorization Code flow with PKCE support
//
// Implements the OAuth 2.0 Authorization Code Grant (RFC 6749) with
// Proof Key for Code Exchange (PKCE, RFC 7636) for secure authorization.
//
// # Usage
//
// ```simplex
// use simplex_std::oauth::{oauth_config_new, oauth_auth_url, oauth_exchange_code};
//
// // Configure OAuth client
// let config = oauth_config_new(
//     "client_id", "client_secret",
//     "https://auth.example.com/authorize",
//     "https://auth.example.com/token",
//     "https://myapp.com/callback"
// );
// let config = oauth_add_scope(config, "openid");
// let config = oauth_add_scope(config, "profile");
//
// // Generate authorization URL with PKCE
// let auth = oauth_auth_url(config, "random-state-value");
// // Redirect user to auth URL...
//
// // Exchange authorization code for tokens
// let token = oauth_exchange_code(config, "auth-code-from-callback");
// let access = oauth_token_access(token);
// ```
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

