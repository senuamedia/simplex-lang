// Runtime Extern Declarations
// =============================================================================

/// SHA-256 hash returning hex string
extern fn sha256_hex(data: i64) -> i64;

/// Generate cryptographic random token (hex string)
extern fn generate_token(len: i64) -> i64;

/// String concatenation
extern fn string_concat(a: i64, b: i64) -> i64;

/// String equality check
extern fn intrinsic_string_eq(a: i64, b: i64) -> i64;

/// String length
extern fn string_length(s: i64) -> i64;

/// Get character at position (returns ASCII code)
extern fn string_char_at(s: i64, idx: i64) -> i64;

/// Get substring
extern fn string_substring(s: i64, start: i64, len: i64) -> i64;

/// Print to stdout
extern fn println(s: i64) -> i64;

/// Create a vec (runtime handle)
extern fn vec_new() -> i64;

/// Push value to vec
extern fn vec_push(v: i64, val: i64) -> i64;

/// Get vec element
extern fn vec_get(v: i64, idx: i64) -> i64;

/// Get vec length
extern fn vec_len(v: i64) -> i64;

/// Integer to string
extern fn int_to_string(n: i64) -> i64;

/// String to integer
extern fn string_to_int(s: i64) -> i64;

/// Create a single-character string from ASCII code
extern fn string_char_create(code: i64) -> i64;

/// HTTP POST request
extern fn http_request_new(method: i64, url: i64) -> i64;
extern fn http_request_header(req: i64, name: i64, value: i64) -> i64;
extern fn http_request_body(req: i64, body: i64) -> i64;
extern fn http_request_send(req: i64) -> i64;
extern fn http_request_free(req: i64) -> i64;
