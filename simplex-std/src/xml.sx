// Simplex XML Library
// XML parser and serializer
//
// Provides pure Simplex XML manipulation using vec handles (i64) for all
// data structures. Supports elements, attributes, text nodes, CDATA sections,
// comments, entity references, and namespace prefixes.
//
// # Usage
//
// ```simplex
// use simplex_std::xml::{xml_parse, xml_stringify, xml_get_attr, xml_find};
//
// let doc = xml_parse("<root><item id=\"1\">Hello</item></root>");
// let item = xml_find(doc, "item");
// let id = xml_get_attr(item, "id");
// let output = xml_stringify(doc);
// ```
//
// # Data Model
//
// All XML nodes are stored as tagged vecs:
//   - Element: [NODE_ELEMENT, tag_string, attrs_vec, children_vec]
//     - attrs_vec: vec of [name, value] pairs
//   - Text:    [NODE_TEXT, text_string]
//   - CDATA:   [NODE_CDATA, text_string]
//   - Comment: [NODE_COMMENT, text_string]
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

// Wrapper for string_substring using built-in intrinsic_string_slice
fn xml_substr(s: i64, start: i64, length: i64) -> i64 {
    intrinsic_string_slice(s, start, start + length)
}

// =============================================================================
// Node Type Constants
// =============================================================================

/// Element node type
fn NODE_ELEMENT() -> i64 { 1 }

/// Text node type
fn NODE_TEXT() -> i64 { 2 }

/// CDATA section node type
fn NODE_CDATA() -> i64 { 3 }

/// Comment node type
fn NODE_COMMENT() -> i64 { 4 }

// Node vec indices for elements
fn ELEM_TYPE() -> i64 { 0 }
fn ELEM_TAG() -> i64 { 1 }
fn ELEM_ATTRS() -> i64 { 2 }
fn ELEM_CHILDREN() -> i64 { 3 }

// Character constants
fn CH_LT() -> i64 { 60 }
fn CH_GT() -> i64 { 62 }
fn CH_AMP() -> i64 { 38 }
fn CH_SEMI() -> i64 { 59 }
fn CH_SLASH() -> i64 { 47 }
fn CH_EQ() -> i64 { 61 }
fn CH_DQUOTE() -> i64 { 34 }
fn CH_SQUOTE() -> i64 { 39 }
fn CH_EXCL() -> i64 { 33 }
fn CH_DASH() -> i64 { 45 }
fn CH_QUESTION() -> i64 { 63 }
fn CH_SPACE() -> i64 { 32 }
fn CH_TAB() -> i64 { 9 }
fn CH_LF() -> i64 { 10 }
fn CH_CR() -> i64 { 13 }
fn CH_LBRACKET() -> i64 { 91 }
fn CH_RBRACKET() -> i64 { 93 }

// =============================================================================
// Node Constructor API
// =============================================================================

/// Create a new element node with the given tag name.
///
/// # Example
/// ```simplex
/// let elem = xml_element_new("div");
/// ```
pub fn xml_element_new(tag: i64) -> i64 {
    let node: i64 = vec_new();
    vec_push(node, NODE_ELEMENT());
    vec_push(node, tag);
    vec_push(node, vec_new());   // attrs
    vec_push(node, vec_new());   // children
    node
}

/// Create a text node.
pub fn xml_text_new(text: i64) -> i64 {
    let node: i64 = vec_new();
    vec_push(node, NODE_TEXT());
    vec_push(node, text);
    node
}

/// Create a CDATA section node.
pub fn xml_cdata_new(text: i64) -> i64 {
    let node: i64 = vec_new();
    vec_push(node, NODE_CDATA());
    vec_push(node, text);
    node
}

/// Create a comment node.
pub fn xml_comment_new(text: i64) -> i64 {
    let node: i64 = vec_new();
    vec_push(node, NODE_COMMENT());
    vec_push(node, text);
    node
}

// =============================================================================
// Node Type Checking
// =============================================================================

/// Get the node type tag
pub fn xml_node_type(node: i64) -> i64 {
    if node == 0 { return 0; }
    if vec_len(node) < 1 { return 0; }
    vec_get(node, 0)
}

/// Check if a node is an element
pub fn xml_is_element(node: i64) -> i64 {
    if xml_node_type(node) == NODE_ELEMENT() { 1 } else { 0 }
}

/// Check if a node is a text node
pub fn xml_is_text(node: i64) -> i64 {
    if xml_node_type(node) == NODE_TEXT() { 1 } else { 0 }
}

/// Check if a node is a CDATA section
pub fn xml_is_cdata(node: i64) -> i64 {
    if xml_node_type(node) == NODE_CDATA() { 1 } else { 0 }
}

/// Check if a node is a comment
pub fn xml_is_comment(node: i64) -> i64 {
    if xml_node_type(node) == NODE_COMMENT() { 1 } else { 0 }
}

// =============================================================================
// Element Accessor API
// =============================================================================

/// Get the tag name of an element
pub fn xml_tag(element: i64) -> i64 {
    if xml_is_element(element) == 0 { return ""; }
    vec_get(element, ELEM_TAG())
}

/// Get the children vec of an element
pub fn xml_children(element: i64) -> i64 {
    if xml_is_element(element) == 0 { return vec_new(); }
    vec_get(element, ELEM_CHILDREN())
}

/// Get the number of children
pub fn xml_child_count(element: i64) -> i64 {
    if xml_is_element(element) == 0 { return 0; }
    let children: i64 = vec_get(element, ELEM_CHILDREN());
    vec_len(children)
}

/// Get a child node by index
pub fn xml_child_at(element: i64, index: i64) -> i64 {
    if xml_is_element(element) == 0 { return 0; }
    let children: i64 = vec_get(element, ELEM_CHILDREN());
    if index < 0 { return 0; }
    if index >= vec_len(children) { return 0; }
    vec_get(children, index)
}

/// Get the text content of a node (text/CDATA content, or concatenated text of element children)
pub fn xml_text(node: i64) -> i64 {
    var i: i64 = 0;
    let ntype: i64 = xml_node_type(node);
    if ntype == NODE_TEXT() {
        return vec_get(node, 1);
    }
    if ntype == NODE_CDATA() {
        return vec_get(node, 1);
    }
    if ntype == NODE_ELEMENT() {
        let sb: i64 = sb_new();
        let children: i64 = vec_get(node, ELEM_CHILDREN());
        let count: i64 = vec_len(children);
        i = 0;
        while i < count {
            let child: i64 = vec_get(children, i);
            let ct: i64 = xml_node_type(child);
            if ct == NODE_TEXT() {
                sb_append(sb, vec_get(child, 1));
            } else if ct == NODE_CDATA() {
                sb_append(sb, vec_get(child, 1));
            } else if ct == NODE_ELEMENT() {
                sb_append(sb, xml_text(child));
            }
            i = i + 1;
        }
        return sb_to_string(sb);
    }
    ""
}

// =============================================================================
// Attribute API
// =============================================================================

/// Get the attributes vec of an element
pub fn xml_attrs(element: i64) -> i64 {
    if xml_is_element(element) == 0 { return vec_new(); }
    vec_get(element, ELEM_ATTRS())
}

/// Get the number of attributes
pub fn xml_attr_count(element: i64) -> i64 {
    if xml_is_element(element) == 0 { return 0; }
    let attrs: i64 = vec_get(element, ELEM_ATTRS());
    vec_len(attrs)
}

/// Get an attribute value by name. Returns empty string if not found.
pub fn xml_get_attr(element: i64, name: i64) -> i64 {
    if xml_is_element(element) == 0 { return ""; }
    let attrs: i64 = vec_get(element, ELEM_ATTRS());
    let count: i64 = vec_len(attrs);
    var i: i64 = 0;
    while i < count {
        let pair: i64 = vec_get(attrs, i);
        let attr_name: i64 = vec_get(pair, 0);
        if string_eq(attr_name, name) == 1 {
            return vec_get(pair, 1);
        }
        i = i + 1;
    }
    ""
}

/// Check if an element has an attribute
pub fn xml_has_attr(element: i64, name: i64) -> i64 {
    if xml_is_element(element) == 0 { return 0; }
    let attrs: i64 = vec_get(element, ELEM_ATTRS());
    let count: i64 = vec_len(attrs);
    var i: i64 = 0;
    while i < count {
        let pair: i64 = vec_get(attrs, i);
        if string_eq(vec_get(pair, 0), name) == 1 {
            return 1;
        }
        i = i + 1;
    }
    0
}

/// Set an attribute on an element. Updates existing or adds new.
pub fn xml_set_attr(element: i64, name: i64, value: i64) -> i64 {
    if xml_is_element(element) == 0 { return element; }
    let attrs: i64 = vec_get(element, ELEM_ATTRS());
    let count: i64 = vec_len(attrs);

    // Check for existing attribute
    var i: i64 = 0;
    while i < count {
        let pair: i64 = vec_get(attrs, i);
        if string_eq(vec_get(pair, 0), name) == 1 {
            vec_set(pair, 1, value);
            return element;
        }
        i = i + 1;
    }

    // Add new attribute
    let pair: i64 = vec_new();
    vec_push(pair, name);
    vec_push(pair, value);
    vec_push(attrs, pair);
    element
}

/// Remove an attribute by name
pub fn xml_remove_attr(element: i64, name: i64) -> i64 {
    if xml_is_element(element) == 0 { return element; }
    let attrs: i64 = vec_get(element, ELEM_ATTRS());
    let count: i64 = vec_len(attrs);
    let new_attrs: i64 = vec_new();

    var i: i64 = 0;
    while i < count {
        let pair: i64 = vec_get(attrs, i);
        if string_eq(vec_get(pair, 0), name) == 0 {
            vec_push(new_attrs, pair);
        }
        i = i + 1;
    }
    vec_set(element, ELEM_ATTRS(), new_attrs);
    element
}

// =============================================================================
// Tree Mutation API
// =============================================================================

/// Add a child node to an element.
pub fn xml_add_child(parent: i64, child: i64) -> i64 {
    if xml_is_element(parent) == 0 { return parent; }
    let children: i64 = vec_get(parent, ELEM_CHILDREN());
    vec_push(children, child);
    parent
}

/// Add a text child to an element.
pub fn xml_add_text(parent: i64, text: i64) -> i64 {
    let text_node: i64 = xml_text_new(text);
    xml_add_child(parent, text_node)
}

// =============================================================================
// Entity Reference Handling
// =============================================================================

/// Decode XML entity references in a string
fn xml_decode_entities(s: i64) -> i64 {
    let len: i64 = string_len(s);
    let sb: i64 = sb_new();
    var i: i64 = 0;

    while i < len {
        let c: i64 = string_char_at(s, i);
        if c == CH_AMP() {
            // Try to match an entity reference
            let entity_result: i64 = parse_entity(s, i);
            let decoded_char: i64 = vec_get(entity_result, 0);
            let new_pos: i64 = vec_get(entity_result, 1);
            if new_pos > i {
                sb_append_char(sb, decoded_char);
                i = new_pos;
            } else {
                sb_append_char(sb, c);
                i = i + 1;
            }
        } else {
            sb_append_char(sb, c);
            i = i + 1;
        }
    }
    sb_to_string(sb)
}

/// Parse a single entity reference starting at &
/// Returns vec: [decoded_char, end_position]
fn parse_entity(s: i64, start: i64) -> i64 {
    let len: i64 = string_len(s);
    let result: i64 = vec_new();

    // Find the semicolon
    var i: i64 = start + 1;
    while i < len {
        if string_char_at(s, i) == CH_SEMI() {
            break;
        }
        i = i + 1;
        // Don't look too far
        if i - start > 10 {
            vec_push(result, CH_AMP());
            vec_push(result, start);
            return result;
        }
    }

    if i >= len {
        vec_push(result, CH_AMP());
        vec_push(result, start);
        return result;
    }

    // Extract entity name
    let name_len: i64 = i - start - 1;
    let entity_name: i64 = xml_substr(s, start + 1, name_len);

    // Match known entities
    if string_eq(entity_name, "amp") == 1 {
        vec_push(result, CH_AMP());
        vec_push(result, i + 1);
        return result;
    }
    if string_eq(entity_name, "lt") == 1 {
        vec_push(result, CH_LT());
        vec_push(result, i + 1);
        return result;
    }
    if string_eq(entity_name, "gt") == 1 {
        vec_push(result, CH_GT());
        vec_push(result, i + 1);
        return result;
    }
    if string_eq(entity_name, "quot") == 1 {
        vec_push(result, CH_DQUOTE());
        vec_push(result, i + 1);
        return result;
    }
    if string_eq(entity_name, "apos") == 1 {
        vec_push(result, CH_SQUOTE());
        vec_push(result, i + 1);
        return result;
    }

    // Numeric character reference &#NNN; or &#xHHH;
    if string_len(entity_name) > 0 {
        if string_char_at(entity_name, 0) == 35 {
            let num_str: i64 = xml_substr(entity_name, 1, string_len(entity_name) - 1);
            if string_len(num_str) > 0 {
                // Simple decimal parsing
                if string_char_at(num_str, 0) == 120 {
                    // hex: &#xHH; - simplified, just pass through
                    vec_push(result, CH_AMP());
                    vec_push(result, start);
                    return result;
                }
                let code: i64 = parse_decimal(num_str);
                if code > 0 {
                    vec_push(result, code);
                    vec_push(result, i + 1);
                    return result;
                }
            }
        }
    }

    // Unknown entity - pass through as-is
    vec_push(result, CH_AMP());
    vec_push(result, start);
    result
}

/// Parse a decimal integer string
fn parse_decimal(s: i64) -> i64 {
    let len: i64 = string_len(s);
    var result: i64 = 0;
    var i: i64 = 0;
    while i < len {
        let c: i64 = string_char_at(s, i);
        if c >= 48 {
            if c <= 57 {
                result = result * 10 + (c - 48);
            } else {
                return 0;
            }
        } else {
            return 0;
        }
        i = i + 1;
    }
    result
}

/// Encode special characters as XML entity references
fn xml_encode_entities(s: i64) -> i64 {
    let len: i64 = string_len(s);
    let sb: i64 = sb_new();
    var i: i64 = 0;
    while i < len {
        let c: i64 = string_char_at(s, i);
        if c == CH_AMP() {
            sb_append(sb, "&amp;");
        } else if c == CH_LT() {
            sb_append(sb, "&lt;");
        } else if c == CH_GT() {
            sb_append(sb, "&gt;");
        } else if c == CH_DQUOTE() {
            sb_append(sb, "&quot;");
        } else if c == CH_SQUOTE() {
            sb_append(sb, "&apos;");
        } else {
            sb_append_char(sb, c);
        }
        i = i + 1;
    }
    sb_to_string(sb)
}

/// Encode attribute value (same as entity encoding)
fn xml_encode_attr(s: i64) -> i64 {
    xml_encode_entities(s)
}

// =============================================================================
// XML Parser
// =============================================================================

/// Check if a character is whitespace
fn is_ws(c: i64) -> i64 {
    if c == CH_SPACE() { return 1; }
    if c == CH_TAB() { return 1; }
    if c == CH_LF() { return 1; }
    if c == CH_CR() { return 1; }
    0
}

/// Skip whitespace starting at position
fn skip_ws(s: i64, pos: i64) -> i64 {
    let len: i64 = string_len(s);
    var i: i64 = pos;
    while i < len {
        if is_ws(string_char_at(s, i)) == 0 {
            return i;
        }
        i = i + 1;
    }
    i
}

/// Check if a character is valid for XML name (simplified: alphanumeric, _, -, ., :)
fn is_name_char(c: i64) -> i64 {
    // a-z
    if c >= 97 {
        if c <= 122 { return 1; }
    }
    // A-Z
    if c >= 65 {
        if c <= 90 { return 1; }
    }
    // 0-9
    if c >= 48 {
        if c <= 57 { return 1; }
    }
    if c == 95 { return 1; }    // _
    if c == CH_DASH() { return 1; }  // -
    if c == 46 { return 1; }    // .
    if c == 58 { return 1; }    // : (namespaces)
    0
}

/// Parse an XML name (tag name or attribute name)
/// Returns vec: [name_string, end_position]
fn parse_name(s: i64, start: i64) -> i64 {
    let len: i64 = string_len(s);
    let sb: i64 = sb_new();
    var i: i64 = start;

    while i < len {
        let c: i64 = string_char_at(s, i);
        if is_name_char(c) == 1 {
            sb_append_char(sb, c);
            i = i + 1;
        } else {
            break;
        }
    }

    let result: i64 = vec_new();
    vec_push(result, sb_to_string(sb));
    vec_push(result, i);
    result
}

/// Parse an attribute value (quoted string after =)
/// Returns vec: [value_string, end_position]
fn parse_attr_value(s: i64, start: i64) -> i64 {
    let len: i64 = string_len(s);
    var i: i64 = start;

    if i >= len {
        let result: i64 = vec_new();
        vec_push(result, "");
        vec_push(result, i);
        return result;
    }

    let quote: i64 = string_char_at(s, i);
    if quote != CH_DQUOTE() {
        if quote != CH_SQUOTE() {
            // Unquoted value (non-standard but handle gracefully)
            let name_result: i64 = parse_name(s, i);
            return name_result;
        }
    }

    // Quoted value
    i = i + 1;
    let sb: i64 = sb_new();
    while i < len {
        let c: i64 = string_char_at(s, i);
        if c == quote {
            let raw: i64 = sb_to_string(sb);
            let decoded: i64 = xml_decode_entities(raw);
            let result: i64 = vec_new();
            vec_push(result, decoded);
            vec_push(result, i + 1);
            return result;
        }
        sb_append_char(sb, c);
        i = i + 1;
    }

    let raw: i64 = sb_to_string(sb);
    let decoded: i64 = xml_decode_entities(raw);
    let result: i64 = vec_new();
    vec_push(result, decoded);
    vec_push(result, i);
    result
}

/// Parse attributes from within a tag (after the tag name)
/// Returns vec: [attrs_vec, end_position]
fn parse_attributes(s: i64, start: i64) -> i64 {
    let attrs: i64 = vec_new();
    let len: i64 = string_len(s);
    var i: i64 = start;

    var done: i64 = 0;
    while done == 0 {
        i = skip_ws(s, i);
        if i >= len {
            done = 1;
        } else {
            let c: i64 = string_char_at(s, i);
            if c == CH_GT() {
                done = 1;
            } else if c == CH_SLASH() {
                done = 1;
            } else if c == CH_QUESTION() {
                done = 1;
            } else {
                // Parse attribute name
                let name_result: i64 = parse_name(s, i);
                let attr_name: i64 = vec_get(name_result, 0);
                i = vec_get(name_result, 1);

                if string_len(attr_name) == 0 {
                    done = 1;
                } else {
                    i = skip_ws(s, i);
                    // Expect '='
                    if i < len {
                        if string_char_at(s, i) == CH_EQ() {
                            i = i + 1;
                            i = skip_ws(s, i);
                            // Parse value
                            let val_result: i64 = parse_attr_value(s, i);
                            let attr_val: i64 = vec_get(val_result, 0);
                            i = vec_get(val_result, 1);

                            let pair: i64 = vec_new();
                            vec_push(pair, attr_name);
                            vec_push(pair, attr_val);
                            vec_push(attrs, pair);
                        } else {
                            // Attribute without value (boolean attribute)
                            let pair: i64 = vec_new();
                            vec_push(pair, attr_name);
                            vec_push(pair, attr_name);  // value = name for boolean attrs
                            vec_push(attrs, pair);
                        }
                    } else {
                        done = 1;
                    }
                }
            }
        }
    }

    let result: i64 = vec_new();
    vec_push(result, attrs);
    vec_push(result, i);
    result
}

/// Parse text content between tags
/// Returns vec: [text_string, end_position]
fn parse_text_content(s: i64, start: i64) -> i64 {
    let len: i64 = string_len(s);
    let sb: i64 = sb_new();
    var i: i64 = start;

    while i < len {
        let c: i64 = string_char_at(s, i);
        if c == CH_LT() {
            break;
        }
        sb_append_char(sb, c);
        i = i + 1;
    }

    let raw: i64 = sb_to_string(sb);
    let decoded: i64 = xml_decode_entities(raw);
    let result: i64 = vec_new();
    vec_push(result, decoded);
    vec_push(result, i);
    result
}

/// Parse a CDATA section: <![CDATA[...]]>
/// Start is positioned after '<![CDATA['
/// Returns vec: [text_string, end_position]
fn parse_cdata_content(s: i64, start: i64) -> i64 {
    let len: i64 = string_len(s);
    let sb: i64 = sb_new();
    var i: i64 = start;

    while i < len {
        // Check for ]]>
        if i + 2 < len {
            if string_char_at(s, i) == CH_RBRACKET() {
                if string_char_at(s, i + 1) == CH_RBRACKET() {
                    if string_char_at(s, i + 2) == CH_GT() {
                        let result: i64 = vec_new();
                        vec_push(result, sb_to_string(sb));
                        vec_push(result, i + 3);
                        return result;
                    }
                }
            }
        }
        sb_append_char(sb, string_char_at(s, i));
        i = i + 1;
    }

    let result: i64 = vec_new();
    vec_push(result, sb_to_string(sb));
    vec_push(result, i);
    result
}

/// Parse a comment: <!-- ... -->
/// Start is positioned after '<!--'
/// Returns vec: [text_string, end_position]
fn parse_comment_content(s: i64, start: i64) -> i64 {
    let len: i64 = string_len(s);
    let sb: i64 = sb_new();
    var i: i64 = start;

    while i < len {
        // Check for -->
        if i + 2 < len {
            if string_char_at(s, i) == CH_DASH() {
                if string_char_at(s, i + 1) == CH_DASH() {
                    if string_char_at(s, i + 2) == CH_GT() {
                        let result: i64 = vec_new();
                        vec_push(result, sb_to_string(sb));
                        vec_push(result, i + 3);
                        return result;
                    }
                }
            }
        }
        sb_append_char(sb, string_char_at(s, i));
        i = i + 1;
    }

    let result: i64 = vec_new();
    vec_push(result, sb_to_string(sb));
    vec_push(result, i);
    result
}

/// Parse a single XML node (element, text, comment, CDATA, or PI)
/// Returns vec: [node, end_position]
fn parse_node(s: i64, start: i64) -> i64 {
    let len: i64 = string_len(s);
    var i: i64 = skip_ws(s, start);
    var di: i64 = 0;
    var pi: i64 = 0;
    var pos: i64 = 0;
    var self_closing: i64 = 0;
    var child_done: i64 = 0;
    var ci: i64 = 0;

    if i >= len {
        let result: i64 = vec_new();
        vec_push(result, 0);
        vec_push(result, i);
        return result;
    }

    let c: i64 = string_char_at(s, i);

    if c != CH_LT() {
        // Text node
        let text_result: i64 = parse_text_content(s, i);
        let text_str: i64 = vec_get(text_result, 0);
        let text_end: i64 = vec_get(text_result, 1);

        // Only create text node if non-empty after trimming
        let trimmed: i64 = string_trim(text_str);
        if string_len(trimmed) > 0 {
            let text_node: i64 = xml_text_new(text_str);
            let result: i64 = vec_new();
            vec_push(result, text_node);
            vec_push(result, text_end);
            return result;
        }
        // Whitespace-only text, skip and try next
        let result: i64 = vec_new();
        vec_push(result, 0);
        vec_push(result, text_end);
        return result;
    }

    // We have '<'
    let after_lt: i64 = i + 1;
    if after_lt >= len {
        let result: i64 = vec_new();
        vec_push(result, 0);
        vec_push(result, len);
        return result;
    }

    let nc: i64 = string_char_at(s, after_lt);

    // Closing tag </...>
    if nc == CH_SLASH() {
        // This is a closing tag - signal to caller
        let result: i64 = vec_new();
        vec_push(result, -1);  // signal: closing tag
        vec_push(result, i);
        return result;
    }

    // Comment <!-- ... -->
    if nc == CH_EXCL() {
        if after_lt + 1 < len {
            if string_char_at(s, after_lt + 1) == CH_DASH() {
                if after_lt + 2 < len {
                    if string_char_at(s, after_lt + 2) == CH_DASH() {
                        let comment_result: i64 = parse_comment_content(s, after_lt + 3);
                        let comment_text: i64 = vec_get(comment_result, 0);
                        let comment_end: i64 = vec_get(comment_result, 1);
                        let comment_node: i64 = xml_comment_new(comment_text);
                        let result: i64 = vec_new();
                        vec_push(result, comment_node);
                        vec_push(result, comment_end);
                        return result;
                    }
                }
            }
        }

        // CDATA <![CDATA[...]]>
        if after_lt + 7 < len {
            let check_cdata: i64 = xml_substr(s, after_lt, 8);
            if string_eq(check_cdata, "![CDATA[") == 1 {
                let cdata_result: i64 = parse_cdata_content(s, after_lt + 8);
                let cdata_text: i64 = vec_get(cdata_result, 0);
                let cdata_end: i64 = vec_get(cdata_result, 1);
                let cdata_node: i64 = xml_cdata_new(cdata_text);
                let result: i64 = vec_new();
                vec_push(result, cdata_node);
                vec_push(result, cdata_end);
                return result;
            }
        }

        // DOCTYPE or other declaration - skip to >
        di = after_lt;
        while di < len {
            if string_char_at(s, di) == CH_GT() {
                di = di + 1;
                break;
            }
            di = di + 1;
        }
        let result: i64 = vec_new();
        vec_push(result, 0);
        vec_push(result, di);
        return result;
    }

    // Processing instruction <?...?>
    if nc == CH_QUESTION() {
        pi = after_lt;
        while pi < len {
            if string_char_at(s, pi) == CH_QUESTION() {
                if pi + 1 < len {
                    if string_char_at(s, pi + 1) == CH_GT() {
                        pi = pi + 2;
                        break;
                    }
                }
            }
            pi = pi + 1;
        }
        let result: i64 = vec_new();
        vec_push(result, 0);
        vec_push(result, pi);
        return result;
    }

    // Opening tag <name attrs...>
    let name_result: i64 = parse_name(s, after_lt);
    let tag_name: i64 = vec_get(name_result, 0);
    pos = vec_get(name_result, 1);

    if string_len(tag_name) == 0 {
        // Invalid tag
        let result: i64 = vec_new();
        vec_push(result, 0);
        vec_push(result, pos + 1);
        return result;
    }

    // Parse attributes
    let attrs_result: i64 = parse_attributes(s, pos);
    let attrs: i64 = vec_get(attrs_result, 0);
    pos = vec_get(attrs_result, 1);

    pos = skip_ws(s, pos);

    // Check for self-closing tag />
    self_closing = 0;
    if pos < len {
        if string_char_at(s, pos) == CH_SLASH() {
            self_closing = 1;
            pos = pos + 1;
        }
    }

    // Skip past >
    if pos < len {
        if string_char_at(s, pos) == CH_GT() {
            pos = pos + 1;
        }
    }

    // Create element
    let element: i64 = vec_new();
    vec_push(element, NODE_ELEMENT());
    vec_push(element, tag_name);
    vec_push(element, attrs);
    vec_push(element, vec_new());

    if self_closing == 1 {
        let result: i64 = vec_new();
        vec_push(result, element);
        vec_push(result, pos);
        return result;
    }

    // Parse children until closing tag
    let children: i64 = vec_get(element, ELEM_CHILDREN());
    child_done = 0;
    while child_done == 0 {
        if pos >= len {
            child_done = 1;
        } else {
            // Check for text content before next tag
            let peek: i64 = string_char_at(s, pos);
            if peek != CH_LT() {
                // Text content
                let text_result: i64 = parse_text_content(s, pos);
                let text_str: i64 = vec_get(text_result, 0);
                pos = vec_get(text_result, 1);
                if string_len(text_str) > 0 {
                    vec_push(children, xml_text_new(text_str));
                }
            } else {
                // Check for closing tag
                let next_pos: i64 = pos + 1;
                if next_pos < len {
                    if string_char_at(s, next_pos) == CH_SLASH() {
                        // Closing tag - skip it
                        ci = next_pos + 1;
                        while ci < len {
                            if string_char_at(s, ci) == CH_GT() {
                                ci = ci + 1;
                                break;
                            }
                            ci = ci + 1;
                        }
                        pos = ci;
                        child_done = 1;
                    } else {
                        // Child node
                        let child_result: i64 = parse_node(s, pos);
                        let child_node: i64 = vec_get(child_result, 0);
                        let child_end: i64 = vec_get(child_result, 1);

                        if child_end <= pos {
                            pos = pos + 1;  // prevent infinite loop
                        } else {
                            pos = child_end;
                        }

                        if child_node == -1 {
                            // Closing tag signal
                            child_done = 1;
                        } else if child_node != 0 {
                            vec_push(children, child_node);
                        }
                    }
                } else {
                    child_done = 1;
                }
            }
        }
    }

    let result: i64 = vec_new();
    vec_push(result, element);
    vec_push(result, pos);
    result
}

// =============================================================================
// Public Parse API
// =============================================================================

/// Parse an XML string into a node tree.
///
/// Returns the root element node, or 0 for invalid/empty input.
///
/// # Example
/// ```simplex
/// let doc = xml_parse("<root><item>Hello</item></root>");
/// let tag = xml_tag(doc);  // "root"
/// ```
pub fn xml_parse(input: i64) -> i64 {
    let len: i64 = string_len(input);
    if len == 0 { return 0; }

    var pos: i64 = 0;
    var pi: i64 = 0;
    var di: i64 = 0;

    // Skip leading whitespace and XML declaration/DTD
    var done_skipping: i64 = 0;
    while done_skipping == 0 {
        pos = skip_ws(input, pos);
        if pos >= len {
            return 0;
        }
        let c: i64 = string_char_at(input, pos);
        if c == CH_LT() {
            let next: i64 = pos + 1;
            if next < len {
                let nc: i64 = string_char_at(input, next);
                if nc == CH_QUESTION() {
                    // PI: skip to ?>
                    pi = next;
                    while pi < len {
                        if string_char_at(input, pi) == CH_QUESTION() {
                            if pi + 1 < len {
                                if string_char_at(input, pi + 1) == CH_GT() {
                                    pi = pi + 2;
                                    break;
                                }
                            }
                        }
                        pi = pi + 1;
                    }
                    pos = pi;
                } else if nc == CH_EXCL() {
                    // Comment or DOCTYPE
                    if next + 1 < len {
                        if string_char_at(input, next + 1) == CH_DASH() {
                            // Comment
                            let cr: i64 = parse_comment_content(input, next + 3);
                            pos = vec_get(cr, 1);
                        } else {
                            // DOCTYPE - skip to >
                            di = next;
                            while di < len {
                                if string_char_at(input, di) == CH_GT() {
                                    di = di + 1;
                                    break;
                                }
                                di = di + 1;
                            }
                            pos = di;
                        }
                    } else {
                        done_skipping = 1;
                    }
                } else {
                    done_skipping = 1;
                }
            } else {
                done_skipping = 1;
            }
        } else {
            done_skipping = 1;
        }
    }

    // Parse the root element
    let node_result: i64 = parse_node(input, pos);
    let node: i64 = vec_get(node_result, 0);
    node
}

// =============================================================================
// Serialization API
// =============================================================================

/// Serialize an XML node tree to a string.
///
/// # Example
/// ```simplex
/// let output = xml_stringify(root);
/// ```
pub fn xml_stringify(node: i64) -> i64 {
    let sb: i64 = sb_new();
    xml_serialize_node(sb, node, 0, 0);
    sb_to_string(sb)
}

/// Serialize an XML node tree to a pretty-printed string.
///
/// # Example
/// ```simplex
/// let output = xml_stringify_pretty(root, 2);
/// ```
pub fn xml_stringify_pretty(node: i64, indent: i64) -> i64 {
    let sb: i64 = sb_new();
    xml_serialize_node(sb, node, 0, indent);
    sb_to_string(sb)
}

/// Internal: serialize a node
fn xml_serialize_node(sb: i64, node: i64, depth: i64, indent: i64) -> i64 {
    var ai: i64 = 0;
    var text_only: i64 = 0;
    var ci: i64 = 0;
    if node == 0 { return 0; }
    let ntype: i64 = xml_node_type(node);

    if ntype == NODE_TEXT() {
        let text: i64 = vec_get(node, 1);
        sb_append(sb, xml_encode_entities(text));
        return 0;
    }

    if ntype == NODE_CDATA() {
        let text: i64 = vec_get(node, 1);
        sb_append(sb, "<![CDATA[");
        sb_append(sb, text);
        sb_append(sb, "]]>");
        return 0;
    }

    if ntype == NODE_COMMENT() {
        if indent > 0 {
            xml_write_indent(sb, depth, indent);
        }
        let text: i64 = vec_get(node, 1);
        sb_append(sb, "<!--");
        sb_append(sb, text);
        sb_append(sb, "-->");
        if indent > 0 {
            sb_append_char(sb, CH_LF());
        }
        return 0;
    }

    if ntype == NODE_ELEMENT() {
        let tag: i64 = vec_get(node, ELEM_TAG());
        let attrs: i64 = vec_get(node, ELEM_ATTRS());
        let children: i64 = vec_get(node, ELEM_CHILDREN());
        let child_count: i64 = vec_len(children);
        let attr_count: i64 = vec_len(attrs);

        if indent > 0 {
            xml_write_indent(sb, depth, indent);
        }

        // Opening tag
        sb_append_char(sb, CH_LT());
        sb_append(sb, tag);

        // Attributes
        ai = 0;
        while ai < attr_count {
            sb_append_char(sb, CH_SPACE());
            let pair: i64 = vec_get(attrs, ai);
            let aname: i64 = vec_get(pair, 0);
            let aval: i64 = vec_get(pair, 1);
            sb_append(sb, aname);
            sb_append_char(sb, CH_EQ());
            sb_append_char(sb, CH_DQUOTE());
            sb_append(sb, xml_encode_attr(aval));
            sb_append_char(sb, CH_DQUOTE());
            ai = ai + 1;
        }

        if child_count == 0 {
            // Self-closing tag
            sb_append(sb, "/>");
            if indent > 0 {
                sb_append_char(sb, CH_LF());
            }
            return 0;
        }

        sb_append_char(sb, CH_GT());

        // Check if children are text-only
        text_only = 1;
        ci = 0;
        while ci < child_count {
            let child: i64 = vec_get(children, ci);
            let ct: i64 = xml_node_type(child);
            if ct != NODE_TEXT() {
                if ct != NODE_CDATA() {
                    text_only = 0;
                }
            }
            ci = ci + 1;
        }

        if text_only == 1 {
            // Inline children
            ci = 0;
            while ci < child_count {
                let child: i64 = vec_get(children, ci);
                xml_serialize_node(sb, child, depth + 1, 0);
                ci = ci + 1;
            }
        } else {
            if indent > 0 {
                sb_append_char(sb, CH_LF());
            }
            ci = 0;
            while ci < child_count {
                let child: i64 = vec_get(children, ci);
                xml_serialize_node(sb, child, depth + 1, indent);
                ci = ci + 1;
            }
            if indent > 0 {
                xml_write_indent(sb, depth, indent);
            }
        }

        // Closing tag
        sb_append(sb, "</");
        sb_append(sb, tag);
        sb_append_char(sb, CH_GT());
        if indent > 0 {
            sb_append_char(sb, CH_LF());
        }
        return 0;
    }

    0
}

/// Write indentation
fn xml_write_indent(sb: i64, depth: i64, indent: i64) -> i64 {
    let total: i64 = depth * indent;
    var i: i64 = 0;
    while i < total {
        sb_append_char(sb, CH_SPACE());
        i = i + 1;
    }
    0
}

// =============================================================================
// Search / Query API
// =============================================================================

/// Find the first descendant element matching a simple path.
///
/// Path is a slash-separated tag name path, e.g. "body/div/p".
/// Returns the matched element, or 0 if not found.
///
/// # Example
/// ```simplex
/// let item = xml_find(root, "items/item");
/// ```
pub fn xml_find(node: i64, path: i64) -> i64 {
    if xml_is_element(node) == 0 { return 0; }

    // Split path on '/'
    let parts: i64 = split_path(path);
    let part_count: i64 = vec_len(parts);

    if part_count == 0 { return node; }

    xml_find_recursive(node, parts, 0)
}

/// Split a path on '/' characters
fn split_path(path: i64) -> i64 {
    let parts: i64 = vec_new();
    let len: i64 = string_len(path);
    var start: i64 = 0;
    var i: i64 = 0;

    while i < len {
        if string_char_at(path, i) == CH_SLASH() {
            if i > start {
                vec_push(parts, xml_substr(path, start, i - start));
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if start < len {
        vec_push(parts, xml_substr(path, start, len - start));
    }
    parts
}

/// Recursive path search
fn xml_find_recursive(node: i64, parts: i64, part_idx: i64) -> i64 {
    if part_idx >= vec_len(parts) { return node; }

    let target: i64 = vec_get(parts, part_idx);
    let children: i64 = vec_get(node, ELEM_CHILDREN());
    let count: i64 = vec_len(children);

    var i: i64 = 0;
    while i < count {
        let child: i64 = vec_get(children, i);
        if xml_is_element(child) == 1 {
            let child_tag: i64 = xml_tag(child);
            if string_eq(child_tag, target) == 1 {
                if part_idx + 1 >= vec_len(parts) {
                    return child;
                }
                let found: i64 = xml_find_recursive(child, parts, part_idx + 1);
                if found != 0 {
                    return found;
                }
            } else {
                // Recurse into non-matching children to search deeper
                let found: i64 = xml_find_recursive(child, parts, part_idx);
                if found != 0 {
                    return found;
                }
            }
        }
        i = i + 1;
    }
    0
}

/// Find all descendant elements matching a tag name.
///
/// Returns a vec of matching element nodes.
///
/// # Example
/// ```simplex
/// let items = xml_find_all(root, "item");
/// ```
pub fn xml_find_all(node: i64, tag: i64) -> i64 {
    let results: i64 = vec_new();
    if xml_is_element(node) == 0 { return results; }
    xml_find_all_recursive(node, tag, results);
    results
}

/// Recursive find-all by tag name
fn xml_find_all_recursive(node: i64, tag: i64, results: i64) -> i64 {
    let children: i64 = vec_get(node, ELEM_CHILDREN());
    let count: i64 = vec_len(children);

    var i: i64 = 0;
    while i < count {
        let child: i64 = vec_get(children, i);
        if xml_is_element(child) == 1 {
            if string_eq(xml_tag(child), tag) == 1 {
                vec_push(results, child);
            }
            xml_find_all_recursive(child, tag, results);
        }
        i = i + 1;
    }
    0
}

/// Get the first child element with a given tag name.
pub fn xml_first_child(element: i64, tag: i64) -> i64 {
    if xml_is_element(element) == 0 { return 0; }
    let children: i64 = vec_get(element, ELEM_CHILDREN());
    let count: i64 = vec_len(children);
    var i: i64 = 0;
    while i < count {
        let child: i64 = vec_get(children, i);
        if xml_is_element(child) == 1 {
            if string_eq(xml_tag(child), tag) == 1 {
                return child;
            }
        }
        i = i + 1;
    }
    0
}
