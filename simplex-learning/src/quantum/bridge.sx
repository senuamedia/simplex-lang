// TASK-021 Phase 6: Quantum-Classical Gradient Bridge
//
// Connects quantum measurement statistics to dual numbers for gradient
// flow across classical-quantum-classical boundaries.
//
// The parameter-shift rule gives us:
//   d<O>/d(theta) = (<O>(theta+s) - <O>(theta-s)) / (2 sin(s))
// with shift s = pi/2. This module wraps those shifted expectation
// values as dual numbers for seamless composition with classical AD.
//
// Exports:
//   quantum_to_dual           - param-shift dual conversion
//   quantum_gradient_bridge   - merge quantum+classical gradients
//   quantum_loss              - cross-entropy loss
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

// =============================================================================
// Constants
// =============================================================================

// Default parameter-shift amount (pi/2 for standard shift rule)
const DEFAULT_SHIFT: f64 = 1.5707963267948966;

// Small epsilon for numerical stability in log computations
const LOG_EPSILON: f64 = 0.000000000000001;

// =============================================================================
// Dual number (value + derivative) stored as a two-element vec
// =============================================================================
//
// Layout:
//   [0] value  f64 (as i64 bits)
//   [1] deriv  f64 (as i64 bits)

fn DUAL_VAL() -> i64 { 0 }
fn DUAL_DER() -> i64 { 1 }

fn dual_new(value: f64, deriv: f64) -> i64 {
    let v = vec_new();
    vec_push(v, f64_to_bits(value));
    vec_push(v, f64_to_bits(deriv));
    v
}

fn dual_value(d: i64) -> f64 {
    bits_to_f64(vec_get(d, DUAL_VAL()))
}

fn dual_deriv(d: i64) -> f64 {
    bits_to_f64(vec_get(d, DUAL_DER()))
}

// =============================================================================
// Quantum-to-Dual Conversion
// =============================================================================

// Convert a quantum measurement result into a dual number that carries
// gradient information via the parameter-shift rule.
//
// Given the expectation value at (theta+s) and (theta-s), the dual number is:
//   value = (f_plus + f_minus) / 2   (midpoint estimate)
//   deriv = (f_plus - f_minus) / (2 * sin(shift))
//
// Arguments:
//   measurement_prob    - midpoint expectation (not used directly; kept for API)
//   param_shift_plus    - <O> evaluated at theta + shift
//   param_shift_minus   - <O> evaluated at theta - shift
//
// Returns: handle to dual number vec [value_bits, deriv_bits]
fn quantum_to_dual(measurement_prob: f64, param_shift_plus: f64, param_shift_minus: f64) -> i64 {
    let value: f64 = (param_shift_plus + param_shift_minus) / 2.0;
    let sin_shift: f64 = sin(DEFAULT_SHIFT());

    var derivative: f64 = 0.0;
    if sin_shift > LOG_EPSILON() {
        derivative = (param_shift_plus - param_shift_minus) / (2.0 * sin_shift);
    } else {
        if sin_shift < 0.0 - LOG_EPSILON() {
            derivative = (param_shift_plus - param_shift_minus) / (2.0 * sin_shift);
        }
    }

    dual_new(value, derivative)
}

// =============================================================================
// Gradient Merging
// =============================================================================

// Merge quantum and classical gradient vectors into a single unified
// gradient vector for the optimizer.
//
// Both input vecs store f64 values as i64 bits. The output vec also
// stores f64 values as i64 bits. The blend_weight controls how much
// quantum vs classical: merged = w*quantum + (1-w)*classical.
//
// Arguments:
//   quantum_grads_vec   - vec of f64-as-bits quantum gradients
//   classical_grads_vec - vec of f64-as-bits classical gradients
//   blend_weight        - 0.0 = all classical, 1.0 = all quantum
//
// Returns: handle to merged gradient vec (f64 stored as i64 bits)
fn quantum_gradient_bridge(quantum_grads_vec: i64, classical_grads_vec: i64, blend_weight: f64) -> i64 {
    var w_q: f64 = blend_weight;
    if w_q < 0.0 { w_q = 0.0; }
    if w_q > 1.0 { w_q = 1.0; }
    let w_c: f64 = 1.0 - w_q;

    let q_len: i64 = vec_len(quantum_grads_vec);
    let c_len: i64 = vec_len(classical_grads_vec);

    // Use the longer of the two as total size
    var total: i64 = q_len;
    if c_len > total { total = c_len; }

    let merged = vec_new();
    var i: i64 = 0;
    while i < total {
        var q_val: f64 = 0.0;
        var c_val: f64 = 0.0;

        if i < q_len {
            q_val = bits_to_f64(vec_get(quantum_grads_vec, i));
        }
        if i < c_len {
            c_val = bits_to_f64(vec_get(classical_grads_vec, i));
        }

        let blended: f64 = w_q * q_val + w_c * c_val;
        vec_push(merged, f64_to_bits(blended));
        i = i + 1;
    }

    merged
}

// =============================================================================
// Quantum Loss Functions
// =============================================================================

// Cross-entropy loss between an expected distribution and measured
// quantum probabilities.
//
// L = -sum_i [ p_expected_i * log(p_measured_i + epsilon) ]
//
// Both vecs store f64 values as i64 bits.
//
// Arguments:
//   expected_vec  - target probability distribution (f64-as-bits)
//   measured_vec  - measured probability distribution (f64-as-bits)
//
// Returns: cross-entropy loss as f64 (lower is better)
fn quantum_loss(expected_vec: i64, measured_vec: i64) -> f64 {
    let n: i64 = vec_len(expected_vec);
    var loss: f64 = 0.0;

    var i: i64 = 0;
    while i < n {
        let p_exp: f64 = bits_to_f64(vec_get(expected_vec, i));
        var p_meas: f64 = bits_to_f64(vec_get(measured_vec, i));

        if p_exp > 0.0 {
            // Clamp measured probability to avoid log(0)
            if p_meas < LOG_EPSILON() {
                p_meas = LOG_EPSILON();
            }
            // loss -= p_exp * ln(p_meas)
            // We use the identity: ln(x) = 2 * atanh((x-1)/(x+1))
            // But sxc does not have ln(). Approximate via log base change:
            //   ln(x) ~ log2(x) / log2(e)
            // sxc does not have log2 either. Use a Taylor series for
            // ln(x) around x=1 is not practical for arbitrary x.
            //
            // Alternative: store the loss components as bit-level computation.
            // Actually, use the sqrt-based approximation or precompute.
            //
            // For a practical cross-entropy, we use the numerical trick:
            //   ln(x) = (x - 1) - (x-1)^2/2 + (x-1)^3/3 - ...
            // This converges for 0 < x <= 2. For larger x, use:
            //   ln(x) = ln(x/2^k) + k*ln(2)
            //
            // Simplification: use a piecewise ln approximation.
            let ln_meas: f64 = approx_ln(p_meas);
            loss = loss - p_exp * ln_meas;
        }
        i = i + 1;
    }

    loss
}

// =============================================================================
// Helpers
// =============================================================================

// Approximate natural log using range reduction and polynomial.
// ln(x) = ln(m * 2^k) = ln(m) + k * ln(2)
// where m is in [0.5, 1.0).
//
// For the [0.5, 1.0) range we use a minimax polynomial.
fn approx_ln(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 - 30.0; }

    // Range reduction: find k such that x = m * 2^k, 0.5 <= m < 1.0
    let ln2: f64 = 0.6931471805599453;
    var m: f64 = x;
    var k: i64 = 0;

    // Scale down if m >= 1.0
    while m >= 1.0 {
        m = m / 2.0;
        k = k + 1;
    }
    // Scale up if m < 0.5
    while m < 0.5 {
        m = m * 2.0;
        k = k - 1;
    }

    // Now 0.5 <= m < 1.0
    // ln(m) approximation using Pade-like: ln(m) ~ 2*(m-1)/(m+1) + 2/3*((m-1)/(m+1))^3
    let t: f64 = (m - 1.0) / (m + 1.0);
    let t2: f64 = t * t;
    let ln_m: f64 = 2.0 * t * (1.0 + t2 / 3.0 + t2 * t2 / 5.0);

    ln_m + (k as f64) * ln2
}

fn my_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x; }
    x
}

fn main() -> i64 {
    // Smoke test: quantum_to_dual with pi/2 shift
    // param_shift_plus=0.8, param_shift_minus=0.2
    // value = (0.8+0.2)/2 = 0.5, deriv = (0.8-0.2)/(2*1.0) = 0.3
    let d = quantum_to_dual(0.5, 0.8, 0.2);
    let val: f64 = dual_value(d);
    let der: f64 = dual_deriv(d);

    if my_abs(val - 0.5) > 0.01 { return 1; }
    if my_abs(der - 0.3) > 0.01 { return 2; }

    // Gradient bridge: blend 50/50
    let qg = vec_new();
    vec_push(qg, f64_to_bits(1.0));
    vec_push(qg, f64_to_bits(3.0));
    let cg = vec_new();
    vec_push(cg, f64_to_bits(2.0));
    vec_push(cg, f64_to_bits(4.0));

    let merged = quantum_gradient_bridge(qg, cg, 0.5);
    // merged[0] = 0.5*1.0 + 0.5*2.0 = 1.5
    // merged[1] = 0.5*3.0 + 0.5*4.0 = 3.5
    let m0: f64 = bits_to_f64(vec_get(merged, 0));
    let m1: f64 = bits_to_f64(vec_get(merged, 1));
    if my_abs(m0 - 1.5) > 0.01 { return 3; }
    if my_abs(m1 - 3.5) > 0.01 { return 4; }

    // Quantum loss: identical distributions => -sum(0.25 * ln(0.25)) = ln(4) ~ 1.386
    let ev = vec_new();
    vec_push(ev, f64_to_bits(0.25));
    vec_push(ev, f64_to_bits(0.25));
    vec_push(ev, f64_to_bits(0.25));
    vec_push(ev, f64_to_bits(0.25));
    let mv = vec_new();
    vec_push(mv, f64_to_bits(0.25));
    vec_push(mv, f64_to_bits(0.25));
    vec_push(mv, f64_to_bits(0.25));
    vec_push(mv, f64_to_bits(0.25));
    let loss: f64 = quantum_loss(ev, mv);
    if my_abs(loss - 1.386) > 0.05 { return 5; }

    println(string_from("bridge: all checks passed"));
    0
}
