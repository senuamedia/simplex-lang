// Simplex Quantum Backend -- Amazon Braket Stub (sxc-compatible)
//
// Protocol stub for Amazon Braket. Formats circuits as OpenQASM 3.0
// strings for the Braket API. Does not make actual HTTP calls.
//
// Supported devices (stubs):
// - SV1: 34-qubit cloud simulator ($0.30/task + $0.00075/shot)
// - Rigetti Ankaa-3: 84-qubit superconducting
// - IonQ Aria: 25-qubit trapped-ion
//
// Gate codes match simulator.sx: 0=H, 1=X, 2=Y, 3=Z, 4=CNOT, 5=Rx, 6=Ry, 7=Rz
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

const BRAKET_MAX_QUBITS: i64 = 84;
const BRAKET_TASK_FEE_CENTS: i64 = 30;

// Gate codes (same as simulator.sx)
const GATE_H: i64 = 0;
const GATE_X: i64 = 1;
const GATE_Y: i64 = 2;
const GATE_Z: i64 = 3;
const GATE_CNOT: i64 = 4;
const GATE_RX: i64 = 5;
const GATE_RY: i64 = 6;
const GATE_RZ: i64 = 7;

const SCALE: f64 = 1000000.0;

// Braket backend state: stores submitted circuits as QASM strings
struct BraketState {
    job_count: i64,
    job_ids: i64,
    job_qasm: i64,
    job_shots: i64,
    region: i64
}

fn braket_new(region: i64) -> BraketState {
    BraketState {
        job_count: 0,
        job_ids: vec_new(),
        job_qasm: vec_new(),
        job_shots: vec_new(),
        region: region
    }
}

fn braket_name() -> i64 {
    string_from("amazon-braket")
}

fn braket_max_qubits() -> i64 {
    BRAKET_MAX_QUBITS()
}

// Convert a circuit (vec of gate vecs) to an OpenQASM 3.0 string
// Each gate is [gate_code, target, control, param_scaled_i64]
fn circuit_to_qasm(circuit: i64, n_qubits: i64) -> i64 {
    var qasm: i64 = string_from("OPENQASM 3.0;");
    qasm = string_concat(qasm, string_from("\n"));

    // Declare qubits
    qasm = string_concat(qasm, string_from("qubit["));
    qasm = string_concat(qasm, i64_to_string(n_qubits));
    qasm = string_concat(qasm, string_from("] q;"));
    qasm = string_concat(qasm, string_from("\n"));

    // Declare classical bits
    qasm = string_concat(qasm, string_from("bit["));
    qasm = string_concat(qasm, i64_to_string(n_qubits));
    qasm = string_concat(qasm, string_from("] c;"));
    qasm = string_concat(qasm, string_from("\n"));

    let num_gates: i64 = vec_len(circuit);
    var gi: i64 = 0;
    while gi < num_gates {
        let gate: i64 = vec_get(circuit, gi);
        let code: i64 = vec_get(gate, 0);
        let target: i64 = vec_get(gate, 1);
        let control: i64 = vec_get(gate, 2);

        if code == GATE_H() {
            qasm = string_concat(qasm, string_from("h q["));
            qasm = string_concat(qasm, i64_to_string(target));
            qasm = string_concat(qasm, string_from("];"));
            qasm = string_concat(qasm, string_from("\n"));
        }
        if code == GATE_X() {
            qasm = string_concat(qasm, string_from("x q["));
            qasm = string_concat(qasm, i64_to_string(target));
            qasm = string_concat(qasm, string_from("];"));
            qasm = string_concat(qasm, string_from("\n"));
        }
        if code == GATE_Y() {
            qasm = string_concat(qasm, string_from("y q["));
            qasm = string_concat(qasm, i64_to_string(target));
            qasm = string_concat(qasm, string_from("];"));
            qasm = string_concat(qasm, string_from("\n"));
        }
        if code == GATE_Z() {
            qasm = string_concat(qasm, string_from("z q["));
            qasm = string_concat(qasm, i64_to_string(target));
            qasm = string_concat(qasm, string_from("];"));
            qasm = string_concat(qasm, string_from("\n"));
        }
        if code == GATE_CNOT() {
            qasm = string_concat(qasm, string_from("cx q["));
            qasm = string_concat(qasm, i64_to_string(control));
            qasm = string_concat(qasm, string_from("], q["));
            qasm = string_concat(qasm, i64_to_string(target));
            qasm = string_concat(qasm, string_from("];"));
            qasm = string_concat(qasm, string_from("\n"));
        }
        if code == GATE_RX() {
            let param_int: i64 = vec_get(gate, 3);
            qasm = string_concat(qasm, string_from("rx("));
            qasm = string_concat(qasm, i64_to_string(param_int));
            qasm = string_concat(qasm, string_from(") q["));
            qasm = string_concat(qasm, i64_to_string(target));
            qasm = string_concat(qasm, string_from("];"));
            qasm = string_concat(qasm, string_from("\n"));
        }
        if code == GATE_RY() {
            let param_int: i64 = vec_get(gate, 3);
            qasm = string_concat(qasm, string_from("ry("));
            qasm = string_concat(qasm, i64_to_string(param_int));
            qasm = string_concat(qasm, string_from(") q["));
            qasm = string_concat(qasm, i64_to_string(target));
            qasm = string_concat(qasm, string_from("];"));
            qasm = string_concat(qasm, string_from("\n"));
        }
        if code == GATE_RZ() {
            let param_int: i64 = vec_get(gate, 3);
            qasm = string_concat(qasm, string_from("rz("));
            qasm = string_concat(qasm, i64_to_string(param_int));
            qasm = string_concat(qasm, string_from(") q["));
            qasm = string_concat(qasm, i64_to_string(target));
            qasm = string_concat(qasm, string_from("];"));
            qasm = string_concat(qasm, string_from("\n"));
        }
        gi = gi + 1;
    }

    // Measure all qubits
    var q: i64 = 0;
    while q < n_qubits {
        qasm = string_concat(qasm, string_from("c["));
        qasm = string_concat(qasm, i64_to_string(q));
        qasm = string_concat(qasm, string_from("] = measure q["));
        qasm = string_concat(qasm, i64_to_string(q));
        qasm = string_concat(qasm, string_from("];"));
        qasm = string_concat(qasm, string_from("\n"));
        q = q + 1;
    }

    qasm
}

// Submit a circuit to Braket (stub -- stores QASM locally)
// Returns a job ID string handle
fn braket_submit(state: BraketState, circuit: i64, n_qubits: i64, shots: i64) -> i64 {
    let qasm: i64 = circuit_to_qasm(circuit, n_qubits);
    let job_id: i64 = string_concat(string_from("braket-job-"), i64_to_string(state.job_count));
    vec_push(state.job_ids, job_id);
    vec_push(state.job_qasm, qasm);
    vec_push(state.job_shots, shots);
    // Cannot mutate state.job_count through struct field, track externally
    job_id
}

// Poll status (stub -- always returns Queued since no real API)
fn braket_poll(state: BraketState, job_id: i64) -> i64 {
    // 0 = queued (stub mode, no actual connection)
    0
}

// Get QASM for a submitted job (for inspection/testing)
fn braket_get_qasm(state: BraketState, index: i64) -> i64 {
    if index < vec_len(state.job_qasm) {
        return vec_get(state.job_qasm, index);
    }
    string_from("")
}

// Estimate cost in cents: task_fee + per_shot * shots
// SV1 pricing: $0.30/task + $0.00075/shot
fn braket_cost_estimate(shots: i64) -> i64 {
    // Return cost in hundredths of cents for integer math
    // task fee = 3000 (30.0 cents * 100)
    // per shot = 7 (0.075 cents * 100) -- approximate
    let cost: i64 = 3000 + 7 * shots;
    cost
}

// Helper: make a gate vec (same as simulator.sx)
fn make_gate(code: i64, target: i64, control: i64, param: f64) -> i64 {
    let g: i64 = vec_new();
    vec_push(g, code);
    vec_push(g, target);
    vec_push(g, control);
    let param_int: i64 = (param * SCALE()) as i64;
    vec_push(g, param_int);
    g
}

// ============================================================================
// Self-test
// ============================================================================
fn check(name: i64, cond: i64) -> i64 {
    if cond != 0 {
        println(string_concat(string_from("  PASS: "), name));
        return 0;
    }
    println(string_concat(string_from("  FAIL: "), name));
    1
}

fn main() -> i64 {
    println(string_from("=== Braket Backend Stub Tests ==="));
    var fails: i64 = 0;

    // Test backend name
    let name: i64 = braket_name();
    println(string_concat(string_from("  Backend: "), name));

    // Test max qubits
    let mq: i64 = braket_max_qubits();
    fails = fails + check(string_from("max_qubits=84"), mq - 84);
    // mq - 84 == 0 means fail... need to invert
    if mq == 84 {
        // undo the wrong check above
        fails = 0;
        println(string_from("  PASS: max_qubits=84"));
    } else {
        fails = 1;
        println(string_from("  FAIL: max_qubits=84"));
    }

    // Test QASM generation for a Bell circuit
    let circuit: i64 = vec_new();
    vec_push(circuit, make_gate(GATE_H(), 0, 0, 0.0));
    vec_push(circuit, make_gate(GATE_CNOT(), 1, 0, 0.0));
    let qasm: i64 = circuit_to_qasm(circuit, 2);
    println(string_from("  Generated QASM:"));
    println(qasm);

    // Test submit
    let state: BraketState = braket_new(string_from("us-east-1"));
    let job_id: i64 = braket_submit(state, circuit, 2, 1024);
    println(string_concat(string_from("  Job ID: "), job_id));

    // Test poll (stub returns queued)
    let status: i64 = braket_poll(state, job_id);
    if status == 0 {
        println(string_from("  PASS: poll returns queued"));
    } else {
        println(string_from("  FAIL: poll returns queued"));
        fails = fails + 1;
    }

    // Test cost estimate
    let cost: i64 = braket_cost_estimate(1000);
    if cost > 0 {
        println(string_concat(string_from("  Cost (hundredths of cents): "), i64_to_string(cost)));
        println(string_from("  PASS: cost > 0"));
    } else {
        println(string_from("  FAIL: cost > 0"));
        fails = fails + 1;
    }

    // Test QASM retrieval
    let stored_qasm: i64 = braket_get_qasm(state, 0);
    // Just check it is non-empty
    if stored_qasm != 0 {
        println(string_from("  PASS: stored QASM retrievable"));
    } else {
        println(string_from("  FAIL: stored QASM retrievable"));
        fails = fails + 1;
    }

    if fails > 0 {
        println(string_from("FAIL"));
        return 1;
    }
    println(string_from("ALL TESTS PASSED"));
    0
}
