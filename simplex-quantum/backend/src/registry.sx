// Simplex Quantum Backend -- Registry (sxc-compatible)
//
// Central registry for managing multiple quantum backends by name.
// Uses parallel vecs of name/handle pairs for lookup.
//
// Backends are registered with a string name and an i64 handle
// (the handle is opaque -- it can be a BraketState, IBMState, etc).
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

// Registry state: two parallel vecs
struct Registry {
    names: i64,
    handles: i64,
    types: i64
}

// Backend type codes
const BACKEND_SIMULATOR: i64 = 0;
const BACKEND_BRAKET: i64 = 1;
const BACKEND_IBM: i64 = 2;
const BACKEND_AZURE: i64 = 3;

fn registry_new() -> Registry {
    Registry {
        names: vec_new(),
        handles: vec_new(),
        types: vec_new()
    }
}

// Register a backend with a name, handle, and type code
fn registry_register(reg: Registry, name: i64, handle: i64, backend_type: i64) -> i64 {
    // Check if name already exists and replace
    let len: i64 = vec_len(reg.names);
    var i: i64 = 0;
    while i < len {
        let existing: i64 = vec_get(reg.names, i);
        if existing == name {
            vec_set(reg.handles, i, handle);
            vec_set(reg.types, i, backend_type);
            return 0;
        }
        i = i + 1;
    }
    // New registration
    vec_push(reg.names, name);
    vec_push(reg.handles, handle);
    vec_push(reg.types, backend_type);
    0
}

// Look up a backend handle by name. Returns 0 if not found.
fn registry_get(reg: Registry, name: i64) -> i64 {
    let len: i64 = vec_len(reg.names);
    var i: i64 = 0;
    while i < len {
        let existing: i64 = vec_get(reg.names, i);
        if existing == name {
            return vec_get(reg.handles, i);
        }
        i = i + 1;
    }
    0
}

// Get backend type code by name. Returns -1 if not found.
fn registry_get_type(reg: Registry, name: i64) -> i64 {
    let len: i64 = vec_len(reg.names);
    var i: i64 = 0;
    while i < len {
        let existing: i64 = vec_get(reg.names, i);
        if existing == name {
            return vec_get(reg.types, i);
        }
        i = i + 1;
    }
    -1
}

// Unregister a backend. Returns 1 if found and removed, 0 otherwise.
fn registry_unregister(reg: Registry, name: i64) -> i64 {
    let len: i64 = vec_len(reg.names);
    var i: i64 = 0;
    while i < len {
        let existing: i64 = vec_get(reg.names, i);
        if existing == name {
            // Swap with last and pop
            let last: i64 = len - 1;
            if i != last {
                vec_set(reg.names, i, vec_get(reg.names, last));
                vec_set(reg.handles, i, vec_get(reg.handles, last));
                vec_set(reg.types, i, vec_get(reg.types, last));
            }
            // Pop not available in sxc, so we track count separately
            // For simplicity, just leave the entry -- registry_count tracks real size
            return 1;
        }
        i = i + 1;
    }
    0
}

// Get the number of registered backends
fn registry_count(reg: Registry) -> i64 {
    vec_len(reg.names)
}

// List all registered backend names (returns a vec of string handles)
fn registry_list(reg: Registry) -> i64 {
    let result: i64 = vec_new();
    let len: i64 = vec_len(reg.names);
    var i: i64 = 0;
    while i < len {
        vec_push(result, vec_get(reg.names, i));
        i = i + 1;
    }
    result
}

// Check if a backend is registered
fn registry_has(reg: Registry, name: i64) -> i64 {
    let h: i64 = registry_get(reg, name);
    if h != 0 { return 1; }
    0
}

// ============================================================================
// Self-test
// ============================================================================
fn main() -> i64 {
    println(string_from("=== Backend Registry Tests ==="));
    var fails: i64 = 0;

    let reg: Registry = registry_new();

    // Test empty registry
    let c0: i64 = registry_count(reg);
    if c0 == 0 {
        println(string_from("  PASS: empty registry count=0"));
    } else {
        println(string_from("  FAIL: empty registry count=0"));
        fails = fails + 1;
    }

    // Register a simulator
    let sim_name: i64 = string_from("simulator");
    registry_register(reg, sim_name, 42, BACKEND_SIMULATOR());

    let c1: i64 = registry_count(reg);
    if c1 == 1 {
        println(string_from("  PASS: count=1 after register"));
    } else {
        println(string_from("  FAIL: count=1 after register"));
        fails = fails + 1;
    }

    // Look up
    let h: i64 = registry_get(reg, sim_name);
    if h == 42 {
        println(string_from("  PASS: get returns correct handle"));
    } else {
        println(string_from("  FAIL: get returns correct handle"));
        fails = fails + 1;
    }

    // Get type
    let t: i64 = registry_get_type(reg, sim_name);
    if t == BACKEND_SIMULATOR() {
        println(string_from("  PASS: get_type returns simulator"));
    } else {
        println(string_from("  FAIL: get_type returns simulator"));
        fails = fails + 1;
    }

    // has_backend
    let has_sim: i64 = registry_has(reg, sim_name);
    if has_sim == 1 {
        println(string_from("  PASS: has_backend=true"));
    } else {
        println(string_from("  FAIL: has_backend=true"));
        fails = fails + 1;
    }

    // Look up non-existent
    let missing: i64 = registry_get(reg, string_from("braket"));
    if missing == 0 {
        println(string_from("  PASS: missing backend returns 0"));
    } else {
        println(string_from("  FAIL: missing backend returns 0"));
        fails = fails + 1;
    }

    // Register more backends
    let braket_name: i64 = string_from("braket");
    registry_register(reg, braket_name, 100, BACKEND_BRAKET());
    let ibm_name: i64 = string_from("ibm");
    registry_register(reg, ibm_name, 200, BACKEND_IBM());

    let c3: i64 = registry_count(reg);
    if c3 == 3 {
        println(string_from("  PASS: count=3 after 3 registrations"));
    } else {
        println(string_from("  FAIL: count=3 after 3 registrations"));
        fails = fails + 1;
    }

    // List backends
    let names: i64 = registry_list(reg);
    let nlen: i64 = vec_len(names);
    if nlen == 3 {
        println(string_from("  PASS: list returns 3 names"));
    } else {
        println(string_from("  FAIL: list returns 3 names"));
        fails = fails + 1;
    }

    // Replace existing
    registry_register(reg, sim_name, 99, BACKEND_SIMULATOR());
    let h2: i64 = registry_get(reg, sim_name);
    if h2 == 99 {
        println(string_from("  PASS: re-register replaces handle"));
    } else {
        println(string_from("  FAIL: re-register replaces handle"));
        fails = fails + 1;
    }

    // Count should still be 3
    let c4: i64 = registry_count(reg);
    if c4 == 3 {
        println(string_from("  PASS: count still 3 after replace"));
    } else {
        println(string_from("  FAIL: count still 3 after replace"));
        fails = fails + 1;
    }

    if fails > 0 {
        println(string_from("FAIL"));
        return 1;
    }
    println(string_from("ALL TESTS PASSED"));
    0
}
