// Simplex Quantum Backend -- Azure Quantum Stub (sxc-compatible)
//
// Protocol stub for Azure Quantum. Formats circuits as IonQ JSON
// for the Azure Quantum REST API. Does not make actual HTTP calls.
//
// Supported providers (stubs):
// - IonQ Simulator: 29-qubit (free)
// - IonQ Aria: 25-qubit trapped-ion
// - Quantinuum H1-1: 20-qubit trapped-ion
// - Quantinuum H2: 56-qubit trapped-ion
// - Rigetti Ankaa-3: 84-qubit superconducting
//
// Gate codes match simulator.sx: 0=H, 1=X, 2=Y, 3=Z, 4=CNOT, 5=Rx, 6=Ry, 7=Rz
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

const AZURE_MAX_QUBITS: i64 = 84;

// Gate codes (same as simulator.sx)
const GATE_H: i64 = 0;
const GATE_X: i64 = 1;
const GATE_Y: i64 = 2;
const GATE_Z: i64 = 3;
const GATE_CNOT: i64 = 4;
const GATE_RX: i64 = 5;
const GATE_RY: i64 = 6;
const GATE_RZ: i64 = 7;

const SCALE: f64 = 1000000.0;

// Azure backend state
struct AzureState {
    job_count: i64,
    job_ids: i64,
    job_payloads: i64,
    job_shots: i64,
    subscription_id: i64,
    resource_group: i64,
    workspace: i64,
    target: i64
}

fn azure_new(subscription_id: i64, resource_group: i64, workspace: i64) -> AzureState {
    AzureState {
        job_count: 0,
        job_ids: vec_new(),
        job_payloads: vec_new(),
        job_shots: vec_new(),
        subscription_id: subscription_id,
        resource_group: resource_group,
        workspace: workspace,
        target: string_from("ionq.simulator")
    }
}

fn azure_name() -> i64 {
    string_from("azure-quantum")
}

fn azure_max_qubits() -> i64 {
    AZURE_MAX_QUBITS()
}

// Map gate code to IonQ gate name string
fn ionq_gate_name(code: i64) -> i64 {
    if code == GATE_H() { return string_from("h"); }
    if code == GATE_X() { return string_from("not"); }
    if code == GATE_Y() { return string_from("y"); }
    if code == GATE_Z() { return string_from("z"); }
    if code == GATE_CNOT() { return string_from("cnot"); }
    if code == GATE_RX() { return string_from("rx"); }
    if code == GATE_RY() { return string_from("ry"); }
    if code == GATE_RZ() { return string_from("rz"); }
    string_from("unknown")
}

// Convert a circuit to IonQ JSON format
// Format: {"qubits":N,"circuit":[{"gate":"h","target":0}, ...]}
fn circuit_to_ionq_json(circuit: i64, n_qubits: i64) -> i64 {
    var json: i64 = string_from("{\"qubits\":");
    json = string_concat(json, i64_to_string(n_qubits));
    json = string_concat(json, string_from(",\"circuit\":["));

    let num_gates: i64 = vec_len(circuit);
    var gi: i64 = 0;
    while gi < num_gates {
        if gi > 0 {
            json = string_concat(json, string_from(","));
        }
        let gate: i64 = vec_get(circuit, gi);
        let code: i64 = vec_get(gate, 0);
        let target: i64 = vec_get(gate, 1);
        let control: i64 = vec_get(gate, 2);
        let gname: i64 = ionq_gate_name(code);

        json = string_concat(json, string_from("{\"gate\":\""));
        json = string_concat(json, gname);
        json = string_concat(json, string_from("\""));

        if code == GATE_CNOT() {
            json = string_concat(json, string_from(",\"control\":"));
            json = string_concat(json, i64_to_string(control));
            json = string_concat(json, string_from(",\"target\":"));
            json = string_concat(json, i64_to_string(target));
        } else {
            json = string_concat(json, string_from(",\"target\":"));
            json = string_concat(json, i64_to_string(target));
        }

        // Rotation parameter
        if code == GATE_RX() {
            let param_int: i64 = vec_get(gate, 3);
            json = string_concat(json, string_from(",\"rotation\":"));
            json = string_concat(json, i64_to_string(param_int));
        }
        if code == GATE_RY() {
            let param_int: i64 = vec_get(gate, 3);
            json = string_concat(json, string_from(",\"rotation\":"));
            json = string_concat(json, i64_to_string(param_int));
        }
        if code == GATE_RZ() {
            let param_int: i64 = vec_get(gate, 3);
            json = string_concat(json, string_from(",\"rotation\":"));
            json = string_concat(json, i64_to_string(param_int));
        }

        json = string_concat(json, string_from("}"));
        gi = gi + 1;
    }

    json = string_concat(json, string_from("]}"));
    json
}

// Build workspace URL path
fn azure_workspace_url(state: AzureState, path: i64) -> i64 {
    var url: i64 = string_from("/subscriptions/");
    url = string_concat(url, state.subscription_id);
    url = string_concat(url, string_from("/resourceGroups/"));
    url = string_concat(url, state.resource_group);
    url = string_concat(url, string_from("/providers/Microsoft.Quantum/workspaces/"));
    url = string_concat(url, state.workspace);
    url = string_concat(url, string_from("/"));
    url = string_concat(url, path);
    url
}

// Submit a circuit to Azure (stub -- stores JSON payload locally)
fn azure_submit(state: AzureState, circuit: i64, n_qubits: i64, shots: i64) -> i64 {
    let payload: i64 = circuit_to_ionq_json(circuit, n_qubits);
    let job_id: i64 = string_concat(string_from("azure-job-"), i64_to_string(state.job_count));
    vec_push(state.job_ids, job_id);
    vec_push(state.job_payloads, payload);
    vec_push(state.job_shots, shots);
    job_id
}

// Poll status (stub -- always queued)
fn azure_poll(state: AzureState, job_id: i64) -> i64 {
    0
}

// Get stored payload for inspection
fn azure_get_payload(state: AzureState, index: i64) -> i64 {
    if index < vec_len(state.job_payloads) {
        return vec_get(state.job_payloads, index);
    }
    string_from("")
}

// Cost estimate: IonQ simulator is free; QPU varies
// Returns cost in hundredths of cents
fn azure_cost_estimate(target: i64, shots: i64) -> i64 {
    // ionq.simulator is free
    // For QPU targets, approximate: $0.30/task + $0.01/shot
    // We just return 0 for the simulator stub
    0
}

// Helper: make a gate vec
fn make_gate(code: i64, target: i64, control: i64, param: f64) -> i64 {
    let g: i64 = vec_new();
    vec_push(g, code);
    vec_push(g, target);
    vec_push(g, control);
    let param_int: i64 = (param * SCALE()) as i64;
    vec_push(g, param_int);
    g
}

// ============================================================================
// Self-test
// ============================================================================
fn main() -> i64 {
    println(string_from("=== Azure Quantum Backend Stub Tests ==="));
    var fails: i64 = 0;

    let name: i64 = azure_name();
    println(string_concat(string_from("  Backend: "), name));

    let mq: i64 = azure_max_qubits();
    if mq == 84 {
        println(string_from("  PASS: max_qubits=84"));
    } else {
        println(string_from("  FAIL: max_qubits=84"));
        fails = fails + 1;
    }

    // Build Bell circuit
    let circuit: i64 = vec_new();
    vec_push(circuit, make_gate(GATE_H(), 0, 0, 0.0));
    vec_push(circuit, make_gate(GATE_CNOT(), 1, 0, 0.0));

    // Test IonQ JSON generation
    let json: i64 = circuit_to_ionq_json(circuit, 2);
    println(string_from("  Generated IonQ JSON:"));
    println(json);

    // Test submit
    let state: AzureState = azure_new(
        string_from("sub-123"),
        string_from("rg-quantum"),
        string_from("ws-test")
    );
    let job_id: i64 = azure_submit(state, circuit, 2, 1024);
    println(string_concat(string_from("  Job ID: "), job_id));

    // Test poll
    let status: i64 = azure_poll(state, job_id);
    if status == 0 {
        println(string_from("  PASS: poll returns queued"));
    } else {
        println(string_from("  FAIL: poll returns queued"));
        fails = fails + 1;
    }

    // Test workspace URL
    let url: i64 = azure_workspace_url(state, string_from("jobs/test-123"));
    println(string_concat(string_from("  Workspace URL: "), url));

    // Test payload retrieval
    let stored: i64 = azure_get_payload(state, 0);
    if stored != 0 {
        println(string_from("  PASS: stored payload retrievable"));
    } else {
        println(string_from("  FAIL: stored payload retrievable"));
        fails = fails + 1;
    }

    // Test cost (free for simulator)
    let cost: i64 = azure_cost_estimate(string_from("ionq.simulator"), 1000);
    if cost == 0 {
        println(string_from("  PASS: cost=0 (simulator free)"));
    } else {
        println(string_from("  FAIL: cost=0"));
        fails = fails + 1;
    }

    if fails > 0 {
        println(string_from("FAIL"));
        return 1;
    }
    println(string_from("ALL TESTS PASSED"));
    0
}
