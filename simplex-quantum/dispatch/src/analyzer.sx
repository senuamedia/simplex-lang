// simplex-quantum-dispatch::analyzer - Problem Complexity Analyzer
// Analyzes computational problems to determine quantum vs classical trade-offs.
// Copyright (c) 2025-2026 Rod Higgins -- AGPL-3.0

// Problem type constants
fn PROBLEM_COMBINATORIAL() -> i64 { 0 }
fn PROBLEM_SIMULATION() -> i64 { 1 }
fn PROBLEM_SAMPLING() -> i64 { 2 }
fn PROBLEM_SEARCH() -> i64 { 3 }

// ProblemAnalysis stored as vec:
//   [0] problem_type  [1] problem_size  [2] classical_runtime_us (f64 bits)
//   [3] required_qubits  [4] circuit_depth  [5] quantum_advantage (f64 bits)
//   [6] constraints

fn analysis_new(ptype: i64, psize: i64, crt_bits: i64, qubits: i64, depth: i64, adv_bits: i64, constraints: i64) -> i64 {
    let v: i64 = vec_new();
    vec_push(v, ptype);
    vec_push(v, psize);
    vec_push(v, crt_bits);
    vec_push(v, qubits);
    vec_push(v, depth);
    vec_push(v, adv_bits);
    vec_push(v, constraints);
    v
}

fn analysis_problem_type(a: i64) -> i64 { vec_get(a, 0) }
fn analysis_problem_size(a: i64) -> i64 { vec_get(a, 1) }
fn analysis_classical_runtime_bits(a: i64) -> i64 { vec_get(a, 2) }
fn analysis_required_qubits(a: i64) -> i64 { vec_get(a, 3) }
fn analysis_circuit_depth(a: i64) -> i64 { vec_get(a, 4) }
fn analysis_quantum_advantage_bits(a: i64) -> i64 { vec_get(a, 5) }
fn analysis_constraints(a: i64) -> i64 { vec_get(a, 6) }

// Estimate classical runtime in microseconds. Returns f64 bits.
fn estimate_classical_runtime(problem_size: i64, problem_type: i64) -> i64 {
    let n: i64 = problem_size;
    if problem_type == PROBLEM_COMBINATORIAL() {
        if problem_size > 50 {
            return f64_to_bits(1000000000000000.0);
        }
        let ops: i64 = 1 << n;
        let us: f64 = (ops as f64) * 0.001;
        return f64_to_bits(us);
    }
    if problem_type == PROBLEM_SIMULATION() {
        if problem_size > 25 {
            return f64_to_bits(1000000000000000.0);
        }
        let ops: i64 = 1 << (n * 2);
        let us: f64 = (ops as f64) * 0.001;
        return f64_to_bits(us);
    }
    if problem_type == PROBLEM_SAMPLING() {
        if problem_size > 50 {
            return f64_to_bits(1000000000000000.0);
        }
        let ops: i64 = 1 << n;
        let us: f64 = (ops as f64) * 0.010;
        return f64_to_bits(us);
    }
    if problem_type == PROBLEM_SEARCH() {
        let us: f64 = (n as f64) * 0.001;
        return f64_to_bits(us);
    }
    let nf: f64 = n as f64;
    let us: f64 = nf * nf * nf * 0.001;
    f64_to_bits(us)
}

// Estimate required qubits
fn estimate_required_qubits(problem_size: i64, problem_type: i64) -> i64 {
    if problem_type == PROBLEM_COMBINATORIAL() {
        return problem_size + 1;
    }
    if problem_type == PROBLEM_SIMULATION() {
        return problem_size;
    }
    if problem_type == PROBLEM_SAMPLING() {
        return problem_size;
    }
    if problem_type == PROBLEM_SEARCH() {
        var qubits: i64 = 1;
        while (1 << qubits) < problem_size {
            qubits = qubits + 1;
        }
        return qubits;
    }
    problem_size
}

// Estimate circuit depth
fn estimate_circuit_depth(problem_size: i64, problem_type: i64) -> i64 {
    let n: i64 = problem_size;
    if problem_type == PROBLEM_COMBINATORIAL() {
        return 8 * n;
    }
    if problem_type == PROBLEM_SIMULATION() {
        return 10 * n * n;
    }
    if problem_type == PROBLEM_SAMPLING() {
        return n * n;
    }
    if problem_type == PROBLEM_SEARCH() {
        var sq: i64 = 1;
        while sq * sq < n {
            sq = sq + 1;
        }
        var log2n: i64 = 1;
        var tmp: i64 = n;
        while tmp > 1 {
            tmp = tmp / 2;
            log2n = log2n + 1;
        }
        return sq * log2n;
    }
    n * n
}

// Estimate quantum advantage. Returns f64 bits.
// Value > 1.0 means quantum is faster.
fn estimate_quantum_advantage(problem_size: i64, problem_type: i64) -> i64 {
    let gate_overhead: f64 = 1000.0;
    let nisq_discount: f64 = 0.5;
    let submission_latency_us: f64 = 10000000.0;
    let classical_us: f64 = bits_to_f64(estimate_classical_runtime(problem_size, problem_type));
    let n: i64 = problem_size;
    if problem_type == PROBLEM_COMBINATORIAL() {
        if problem_size > 50 {
            return f64_to_bits(1000.0);
        }
        let half: i64 = n / 2;
        let quantum_ops: i64 = 1 << half;
        let quantum_us: f64 = (quantum_ops as f64) * gate_overhead * 0.001 + submission_latency_us;
        if quantum_us < 1.0 {
            return f64_to_bits(1.0);
        }
        let raw: f64 = classical_us / quantum_us;
        return f64_to_bits(raw * nisq_discount);
    }
    if problem_type == PROBLEM_SIMULATION() {
        if problem_size > 25 {
            return f64_to_bits(10000.0);
        }
        let nf: f64 = n as f64;
        let quantum_ops: f64 = nf * nf * nf * 10.0;
        let quantum_us: f64 = quantum_ops * gate_overhead * 0.001 + submission_latency_us;
        if quantum_us < 1.0 {
            return f64_to_bits(1.0);
        }
        let raw: f64 = classical_us / quantum_us;
        return f64_to_bits(raw * nisq_discount);
    }
    if problem_type == PROBLEM_SAMPLING() {
        if problem_size > 50 {
            return f64_to_bits(5000.0);
        }
        let nf: f64 = n as f64;
        let quantum_ops: f64 = nf * nf;
        let quantum_us: f64 = quantum_ops * gate_overhead * 0.001 + submission_latency_us;
        if quantum_us < 1.0 {
            return f64_to_bits(1.0);
        }
        let raw: f64 = classical_us / quantum_us;
        return f64_to_bits(raw * nisq_discount);
    }
    if problem_type == PROBLEM_SEARCH() {
        var sq: i64 = 1;
        while sq * sq < n {
            sq = sq + 1;
        }
        let quantum_us: f64 = (sq as f64) * gate_overhead * 0.001 + submission_latency_us;
        if quantum_us < 1.0 {
            return f64_to_bits(1.0);
        }
        let raw: f64 = classical_us / quantum_us;
        return f64_to_bits(raw * nisq_discount);
    }
    f64_to_bits(1.0)
}

// Main entry point: analyze a problem
fn analyze_problem(problem_size: i64, problem_type: i64, constraints: i64) -> i64 {
    let crt_bits: i64 = estimate_classical_runtime(problem_size, problem_type);
    let qubits: i64 = estimate_required_qubits(problem_size, problem_type);
    let depth: i64 = estimate_circuit_depth(problem_size, problem_type);
    let adv_bits: i64 = estimate_quantum_advantage(problem_size, problem_type);
    analysis_new(problem_type, problem_size, crt_bits, qubits, depth, adv_bits, constraints)
}

fn f64_to_bits(value: f64) -> i64 { value as i64 }
fn bits_to_f64(bits: i64) -> f64 { bits as f64 }
