// simplex-quantum::circuit-opt::depth - Depth Reduction
//
// Compute circuit depth and reduce it via ASAP layer assignment
// using the circuit DAG representation.
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

// Gate opcodes
const OP_H: i64 = 1;
const OP_X: i64 = 2;
const OP_Y: i64 = 3;
const OP_Z: i64 = 4;
const OP_S: i64 = 5;
const OP_T: i64 = 6;
const OP_RX: i64 = 7;
const OP_RY: i64 = 8;
const OP_RZ: i64 = 9;
const OP_CNOT: i64 = 10;
const OP_CZ: i64 = 11;
const OP_SWAP: i64 = 12;
const OP_CRZ: i64 = 13;

const INSTR_STRIDE: i64 = 4;

// DAG offsets
const DAG_NQUBITS: i64 = 0;
const DAG_NNODES: i64 = 1;
const DAG_NODES: i64 = 2;
const DAG_ADJ: i64 = 3;
const DAG_LAST: i64 = 4;

const NODE_OP: i64 = 0;
const NODE_Q0: i64 = 1;
const NODE_Q1: i64 = 2;
const NODE_THETA: i64 = 3;
const NODE_INDEG: i64 = 4;

// Compute circuit depth from flat instruction list.
// Depth = maximum number of gates on any single qubit's timeline,
// accounting for two-qubit gate synchronization.
fn compute_depth(instrs: i64, n_qubits: i64) -> i64 {
    let n: i64 = vec_len(instrs) / INSTR_STRIDE();
    if n == 0 { return 0; }

    // Track depth per qubit
    let depths: i64 = vec_new();
    var i: i64 = 0;
    while i < n_qubits {
        vec_push(depths, 0);
        i = i + 1;
    }

    i = 0;
    while i < n {
        let base: i64 = i * INSTR_STRIDE();
        let op: i64 = vec_get(instrs, base);
        let q0: i64 = vec_get(instrs, base + 1);
        let q1: i64 = vec_get(instrs, base + 2);

        if q1 >= 0 {
            // Two-qubit gate: both qubits advance to max + 1
            let d0: i64 = vec_get(depths, q0);
            let d1: i64 = vec_get(depths, q1);
            var nd: i64 = d0 + 1;
            if d1 + 1 > nd { nd = d1 + 1; }
            vec_set(depths, q0, nd);
            vec_set(depths, q1, nd);
        } else {
            // Single-qubit gate
            let d: i64 = vec_get(depths, q0);
            vec_set(depths, q0, d + 1);
        }
        i = i + 1;
    }

    // Max depth across all qubits
    var max_d: i64 = 0;
    i = 0;
    while i < n_qubits {
        let d: i64 = vec_get(depths, i);
        if d > max_d { max_d = d; }
        i = i + 1;
    }
    max_d
}

// ASAP layer assignment on DAG.
// Returns vec where layers[i] = layer number for node i.
// Layer 0 = earliest possible.
fn assign_layers(dag: i64) -> i64 {
    let n: i64 = vec_get(dag, DAG_NNODES());
    let nodes: i64 = vec_get(dag, DAG_NODES());
    let adj: i64 = vec_get(dag, DAG_ADJ());

    let layers: i64 = vec_new();
    var i: i64 = 0;
    while i < n {
        vec_push(layers, 0);
        i = i + 1;
    }

    // Topological order
    let in_deg: i64 = vec_new();
    i = 0;
    while i < n {
        let node: i64 = vec_get(nodes, i);
        vec_push(in_deg, vec_get(node, NODE_INDEG()));
        i = i + 1;
    }

    let queue: i64 = vec_new();
    i = 0;
    while i < n {
        if vec_get(in_deg, i) == 0 { vec_push(queue, i); }
        i = i + 1;
    }

    var front: i64 = 0;
    while front < vec_len(queue) {
        let u: i64 = vec_get(queue, front);
        front = front + 1;
        let u_layer: i64 = vec_get(layers, u);

        let succs: i64 = vec_get(adj, u);
        var s: i64 = 0;
        while s < vec_len(succs) {
            let v: i64 = vec_get(succs, s);
            let new_layer: i64 = u_layer + 1;
            if new_layer > vec_get(layers, v) {
                vec_set(layers, v, new_layer);
            }
            let deg: i64 = vec_get(in_deg, v) - 1;
            vec_set(in_deg, v, deg);
            if deg == 0 { vec_push(queue, v); }
            s = s + 1;
        }
    }
    layers
}

// Depth reduction: build DAG, compute ASAP layers, emit gates layer by layer.
// This reorders gates to minimize depth while preserving dependencies.
fn depth_reduce(instrs: i64, n_qubits: i64) -> i64 {
    let n: i64 = vec_len(instrs) / INSTR_STRIDE();
    if n < 2 { return instrs; }

    let dag: i64 = dag_from_instructions(instrs, n_qubits);
    let nn: i64 = vec_get(dag, DAG_NNODES());
    let nodes: i64 = vec_get(dag, DAG_NODES());
    let layers: i64 = assign_layers(dag);

    // Find max layer
    var max_layer: i64 = 0;
    var i: i64 = 0;
    while i < nn {
        let l: i64 = vec_get(layers, i);
        if l > max_layer { max_layer = l; }
        i = i + 1;
    }

    // Emit gates layer by layer
    let result: i64 = vec_new();
    var layer: i64 = 0;
    while layer <= max_layer {
        i = 0;
        while i < nn {
            if vec_get(layers, i) == layer {
                let node: i64 = vec_get(nodes, i);
                vec_push(result, vec_get(node, NODE_OP()));
                vec_push(result, vec_get(node, NODE_Q0()));
                vec_push(result, vec_get(node, NODE_Q1()));
                vec_push(result, vec_get(node, NODE_THETA()));
            }
            i = i + 1;
        }
        layer = layer + 1;
    }
    result
}

// Helper: build DAG from instructions (duplicated here for standalone use)
fn dag_from_instructions(instrs: i64, n_qubits: i64) -> i64 {
    let dag: i64 = vec_new();
    vec_push(dag, n_qubits);
    vec_push(dag, 0);
    vec_push(dag, vec_new());
    vec_push(dag, vec_new());
    let last: i64 = vec_new();
    var k: i64 = 0;
    while k < n_qubits {
        vec_push(last, 0 - 1);
        k = k + 1;
    }
    vec_push(dag, last);

    let n: i64 = vec_len(instrs) / INSTR_STRIDE();
    var i: i64 = 0;
    while i < n {
        let base: i64 = i * INSTR_STRIDE();
        let op: i64 = vec_get(instrs, base);
        let q0: i64 = vec_get(instrs, base + 1);
        let q1: i64 = vec_get(instrs, base + 2);
        let tb: i64 = vec_get(instrs, base + 3);

        let nodes: i64 = vec_get(dag, DAG_NODES());
        let adj: i64 = vec_get(dag, DAG_ADJ());
        let idx: i64 = vec_get(dag, DAG_NNODES());

        let node: i64 = vec_new();
        vec_push(node, op);
        vec_push(node, q0);
        vec_push(node, q1);
        vec_push(node, tb);
        vec_push(node, 0);
        vec_push(nodes, node);
        vec_push(adj, vec_new());

        let prev_q0: i64 = vec_get(last, q0);
        if prev_q0 >= 0 {
            let prev_adj: i64 = vec_get(adj, prev_q0);
            vec_push(prev_adj, idx);
            let ideg: i64 = vec_get(node, NODE_INDEG());
            vec_set(node, NODE_INDEG(), ideg + 1);
        }

        if q1 >= 0 {
            let prev_q1: i64 = vec_get(last, q1);
            if prev_q1 >= 0 {
                if prev_q1 != prev_q0 {
                    let prev_adj1: i64 = vec_get(adj, prev_q1);
                    vec_push(prev_adj1, idx);
                    let ideg1: i64 = vec_get(node, NODE_INDEG());
                    vec_set(node, NODE_INDEG(), ideg1 + 1);
                }
            }
            vec_set(last, q1, idx);
        }
        vec_set(last, q0, idx);
        vec_set(dag, DAG_NNODES(), idx + 1);
        i = i + 1;
    }
    dag
}

fn main() -> i64 {
    // Test: compute depth of a simple circuit
    let instrs: i64 = vec_new();
    // H(0), H(1), CNOT(0,1), H(0)
    vec_push(instrs, 1); vec_push(instrs, 0); vec_push(instrs, 0 - 1); vec_push(instrs, 0);
    vec_push(instrs, 1); vec_push(instrs, 1); vec_push(instrs, 0 - 1); vec_push(instrs, 0);
    vec_push(instrs, 10); vec_push(instrs, 0); vec_push(instrs, 1); vec_push(instrs, 0);
    vec_push(instrs, 1); vec_push(instrs, 0); vec_push(instrs, 0 - 1); vec_push(instrs, 0);

    let d: i64 = compute_depth(instrs, 2);
    println(string_concat(string_from("depth: "), int_to_string(d)));

    let reduced: i64 = depth_reduce(instrs, 2);
    let d2: i64 = compute_depth(reduced, 2);
    println(string_concat(string_from("reduced depth: "), int_to_string(d2)));
    println(string_from("circuit-opt/depth.sx OK"));
    0
}
