// simplex-quantum::circuit-opt::fusion - Gate Fusion Passes
//
// Identity elimination, rotation merging, and single-qubit fusion.
// All passes operate on flat instruction lists (stride-4 format).
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

const PI: f64 = 3.14159265358979323846;
const TWO_PI: f64 = 6.28318530717958647692;
const EPSILON: f64 = 0.000000001;

// Gate opcodes
const OP_H: i64 = 1;
const OP_X: i64 = 2;
const OP_Y: i64 = 3;
const OP_Z: i64 = 4;
const OP_S: i64 = 5;
const OP_T: i64 = 6;
const OP_RX: i64 = 7;
const OP_RY: i64 = 8;
const OP_RZ: i64 = 9;
const OP_CNOT: i64 = 10;
const OP_CZ: i64 = 11;
const OP_SWAP: i64 = 12;
const OP_CRZ: i64 = 13;

const INSTR_STRIDE: i64 = 4;

// Check if gate is self-inverse (applying twice = identity)
fn is_self_inverse(op: i64) -> i64 {
    if op == OP_H() { return 1; }
    if op == OP_X() { return 1; }
    if op == OP_Y() { return 1; }
    if op == OP_Z() { return 1; }
    0
}

// Check if gate is a rotation gate
fn is_rotation(op: i64) -> i64 {
    if op == OP_RX() { return 1; }
    if op == OP_RY() { return 1; }
    if op == OP_RZ() { return 1; }
    0
}

// Check if gate is single-qubit
fn is_single_qubit(op: i64) -> i64 {
    if op >= OP_H() {
        if op <= OP_RZ() {
            return 1;
        }
    }
    0
}

// Check if gate is two-qubit
fn is_two_qubit(op: i64) -> i64 {
    if op == OP_CNOT() { return 1; }
    if op == OP_CZ() { return 1; }
    if op == OP_SWAP() { return 1; }
    if op == OP_CRZ() { return 1; }
    0
}

// Helper: absolute value for f64
fn fabs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x; }
    x
}

// Helper: get instruction fields at gate index i
fn instr_op(instrs: i64, i: i64) -> i64 { vec_get(instrs, i * INSTR_STRIDE()); }
fn instr_q0(instrs: i64, i: i64) -> i64 { vec_get(instrs, i * INSTR_STRIDE() + 1); }
fn instr_q1(instrs: i64, i: i64) -> i64 { vec_get(instrs, i * INSTR_STRIDE() + 2); }
fn instr_theta_bits(instrs: i64, i: i64) -> i64 { vec_get(instrs, i * INSTR_STRIDE() + 3); }
fn instr_theta(instrs: i64, i: i64) -> f64 { bits_to_f64(vec_get(instrs, i * INSTR_STRIDE() + 3)); }

fn instr_count(instrs: i64) -> i64 { vec_len(instrs) / INSTR_STRIDE(); }

// Copy one instruction from src at gate index si to dst
fn copy_instr(dst: i64, src: i64, si: i64) -> i64 {
    let base: i64 = si * INSTR_STRIDE();
    vec_push(dst, vec_get(src, base));
    vec_push(dst, vec_get(src, base + 1));
    vec_push(dst, vec_get(src, base + 2));
    vec_push(dst, vec_get(src, base + 3));
    0
}

// Push a new instruction
fn push_instr(dst: i64, op: i64, q0: i64, q1: i64, theta_bits: i64) -> i64 {
    vec_push(dst, op);
    vec_push(dst, q0);
    vec_push(dst, q1);
    vec_push(dst, theta_bits);
    0
}

// ---- Identity Elimination ----
// Remove consecutive pairs of self-inverse gates on the same qubit.
// Also removes consecutive identical CNOT pairs on the same control/target.
fn identity_elimination(instrs: i64) -> i64 {
    let n: i64 = instr_count(instrs);
    if n < 2 { return instrs; }

    // Mark gates for removal: 0 = keep, 1 = remove
    let marks: i64 = vec_new();
    var i: i64 = 0;
    while i < n {
        vec_push(marks, 0);
        i = i + 1;
    }

    // Scan for adjacent cancelling pairs
    i = 0;
    while i < n - 1 {
        if vec_get(marks, i) == 0 {
            let op1: i64 = instr_op(instrs, i);
            let q0_1: i64 = instr_q0(instrs, i);
            let q1_1: i64 = instr_q1(instrs, i);

            // Find next unmarked gate
            var j: i64 = i + 1;
            while j < n {
                if vec_get(marks, j) == 0 {
                    let op2: i64 = instr_op(instrs, j);
                    let q0_2: i64 = instr_q0(instrs, j);
                    let q1_2: i64 = instr_q1(instrs, j);

                    // Check self-inverse single-qubit cancellation
                    if is_self_inverse(op1) != 0 {
                        if op1 == op2 {
                            if q0_1 == q0_2 {
                                vec_set(marks, i, 1);
                                vec_set(marks, j, 1);
                            }
                        }
                    }

                    // Check CNOT-CNOT cancellation
                    if op1 == OP_CNOT() {
                        if op2 == OP_CNOT() {
                            if q0_1 == q0_2 {
                                if q1_1 == q1_2 {
                                    vec_set(marks, i, 1);
                                    vec_set(marks, j, 1);
                                }
                            }
                        }
                    }

                    // Check SWAP-SWAP cancellation
                    if op1 == OP_SWAP() {
                        if op2 == OP_SWAP() {
                            if q0_1 == q0_2 {
                                if q1_1 == q1_2 {
                                    vec_set(marks, i, 1);
                                    vec_set(marks, j, 1);
                                }
                            }
                        }
                    }

                    // Only check immediately adjacent on same qubit
                    j = n;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }

    // Build result without marked gates
    let result: i64 = vec_new();
    i = 0;
    while i < n {
        if vec_get(marks, i) == 0 {
            copy_instr(result, instrs, i);
        }
        i = i + 1;
    }
    result
}

// ---- Rotation Merge ----
// Merge consecutive rotation gates of the same type on the same qubit.
// Rz(a) . Rz(b) -> Rz(a+b). If sum is ~0 (mod 2pi), remove entirely.
fn rotation_merge(instrs: i64) -> i64 {
    let n: i64 = instr_count(instrs);
    if n < 2 { return instrs; }

    let marks: i64 = vec_new();
    // Store merged theta values (f64 bits) per gate; -1 means not merged
    let merged_theta: i64 = vec_new();
    var i: i64 = 0;
    while i < n {
        vec_push(marks, 0);
        vec_push(merged_theta, instr_theta_bits(instrs, i));
        i = i + 1;
    }

    i = 0;
    while i < n - 1 {
        if vec_get(marks, i) == 0 {
            let op1: i64 = instr_op(instrs, i);
            if is_rotation(op1) != 0 {
                let q0_1: i64 = instr_q0(instrs, i);
                var j: i64 = i + 1;
                // Find next gate on same qubit
                while j < n {
                    if vec_get(marks, j) == 0 {
                        let op2: i64 = instr_op(instrs, j);
                        let q0_2: i64 = instr_q0(instrs, j);

                        if op1 == op2 {
                            if q0_1 == q0_2 {
                                // Merge: sum the angles
                                let theta1: f64 = bits_to_f64(vec_get(merged_theta, i));
                                let theta2: f64 = bits_to_f64(vec_get(merged_theta, j));
                                let sum: f64 = theta1 + theta2;
                                vec_set(merged_theta, i, f64_to_bits(sum));
                                vec_set(marks, j, 1);
                                // Continue scanning for more merges
                                j = j + 1;
                            } else {
                                // Different qubit, stop scanning
                                j = n;
                            }
                        } else {
                            // Different gate on same qubit blocks merge
                            if is_single_qubit(op2) != 0 {
                                if q0_2 == q0_1 {
                                    j = n;
                                } else {
                                    j = j + 1;
                                }
                            } else {
                                // Two-qubit gate: check if it touches our qubit
                                if q0_2 == q0_1 {
                                    j = n;
                                } else {
                                    let q1_2: i64 = instr_q1(instrs, j);
                                    if q1_2 == q0_1 {
                                        j = n;
                                    } else {
                                        j = j + 1;
                                    }
                                }
                            }
                        }
                    } else {
                        j = j + 1;
                    }
                }
            }
        }
        i = i + 1;
    }

    // Build result, skipping removed and checking for zero-angle rotations
    let result: i64 = vec_new();
    i = 0;
    while i < n {
        if vec_get(marks, i) == 0 {
            let op: i64 = instr_op(instrs, i);
            if is_rotation(op) != 0 {
                let theta: f64 = bits_to_f64(vec_get(merged_theta, i));
                // Normalize to [-pi, pi]
                var norm_theta: f64 = theta;
                while norm_theta > PI() {
                    norm_theta = norm_theta - TWO_PI();
                }
                while norm_theta < 0.0 - PI() {
                    norm_theta = norm_theta + TWO_PI();
                }
                // If angle is ~0, skip the gate entirely
                if fabs(norm_theta) > EPSILON() {
                    push_instr(result, op, instr_q0(instrs, i), instr_q1(instrs, i), f64_to_bits(norm_theta));
                }
            } else {
                copy_instr(result, instrs, i);
            }
        }
        i = i + 1;
    }
    result
}

// ---- Single Qubit Fusion ----
// Merge consecutive single-qubit gates on the same qubit into Rz.Ry.Rz
// (ZYZ decomposition). We multiply 2x2 unitary matrices and extract angles.
//
// Matrix representation: [a_re, a_im, b_re, b_im, c_re, c_im, d_re, d_im]
// for [[a, b], [c, d]]
fn single_qubit_fusion(instrs: i64) -> i64 {
    let n: i64 = instr_count(instrs);
    if n < 2 { return instrs; }

    let result: i64 = vec_new();
    let marks: i64 = vec_new();
    var i: i64 = 0;
    while i < n {
        vec_push(marks, 0);
        i = i + 1;
    }

    i = 0;
    while i < n {
        if vec_get(marks, i) == 0 {
            let op: i64 = instr_op(instrs, i);
            if is_single_qubit(op) != 0 {
                let qubit: i64 = instr_q0(instrs, i);
                // Collect consecutive single-qubit gates on this qubit
                let run: i64 = vec_new();
                vec_push(run, i);
                vec_set(marks, i, 1);
                var j: i64 = i + 1;
                while j < n {
                    let op_j: i64 = instr_op(instrs, j);
                    if vec_get(marks, j) != 0 {
                        j = j + 1;
                    } else {
                        if is_single_qubit(op_j) != 0 {
                            if instr_q0(instrs, j) == qubit {
                                vec_push(run, j);
                                vec_set(marks, j, 1);
                                j = j + 1;
                            } else {
                                j = j + 1;
                            }
                        } else {
                            // Two-qubit gate: if it touches our qubit, stop
                            let q0_j: i64 = instr_q0(instrs, j);
                            let q1_j: i64 = instr_q1(instrs, j);
                            if q0_j == qubit {
                                j = n;
                            } else {
                                if q1_j == qubit {
                                    j = n;
                                } else {
                                    j = j + 1;
                                }
                            }
                        }
                    }
                }

                let run_len: i64 = vec_len(run);
                if run_len < 2 {
                    // Single gate, just copy it
                    copy_instr(result, instrs, vec_get(run, 0));
                } else {
                    // Multiply matrices: start with identity
                    var m_a_re: f64 = 1.0;
                    var m_a_im: f64 = 0.0;
                    var m_b_re: f64 = 0.0;
                    var m_b_im: f64 = 0.0;
                    var m_c_re: f64 = 0.0;
                    var m_c_im: f64 = 0.0;
                    var m_d_re: f64 = 1.0;
                    var m_d_im: f64 = 0.0;

                    var k: i64 = 0;
                    while k < run_len {
                        let gi: i64 = vec_get(run, k);
                        // Get gate matrix
                        var g_a_re: f64 = 0.0;
                        var g_a_im: f64 = 0.0;
                        var g_b_re: f64 = 0.0;
                        var g_b_im: f64 = 0.0;
                        var g_c_re: f64 = 0.0;
                        var g_c_im: f64 = 0.0;
                        var g_d_re: f64 = 0.0;
                        var g_d_im: f64 = 0.0;
                        let gop: i64 = instr_op(instrs, gi);
                        let gtheta: f64 = instr_theta(instrs, gi);
                        gate_to_matrix(gop, gtheta);
                        // gate_to_matrix stores result in global-like return via a temp vec
                        let mat: i64 = gate_to_matrix(gop, gtheta);
                        g_a_re = bits_to_f64(vec_get(mat, 0));
                        g_a_im = bits_to_f64(vec_get(mat, 1));
                        g_b_re = bits_to_f64(vec_get(mat, 2));
                        g_b_im = bits_to_f64(vec_get(mat, 3));
                        g_c_re = bits_to_f64(vec_get(mat, 4));
                        g_c_im = bits_to_f64(vec_get(mat, 5));
                        g_d_re = bits_to_f64(vec_get(mat, 6));
                        g_d_im = bits_to_f64(vec_get(mat, 7));

                        // Multiply: result = gate * current
                        let na_re: f64 = g_a_re * m_a_re - g_a_im * m_a_im + g_b_re * m_c_re - g_b_im * m_c_im;
                        let na_im: f64 = g_a_re * m_a_im + g_a_im * m_a_re + g_b_re * m_c_im + g_b_im * m_c_re;
                        let nb_re: f64 = g_a_re * m_b_re - g_a_im * m_b_im + g_b_re * m_d_re - g_b_im * m_d_im;
                        let nb_im: f64 = g_a_re * m_b_im + g_a_im * m_b_re + g_b_re * m_d_im + g_b_im * m_d_re;
                        let nc_re: f64 = g_c_re * m_a_re - g_c_im * m_a_im + g_d_re * m_c_re - g_d_im * m_c_im;
                        let nc_im: f64 = g_c_re * m_a_im + g_c_im * m_a_re + g_d_re * m_c_im + g_d_im * m_c_re;
                        let nd_re: f64 = g_c_re * m_b_re - g_c_im * m_b_im + g_d_re * m_d_re - g_d_im * m_d_im;
                        let nd_im: f64 = g_c_re * m_b_im + g_c_im * m_b_re + g_d_re * m_d_im + g_d_im * m_d_re;

                        m_a_re = na_re;
                        m_a_im = na_im;
                        m_b_re = nb_re;
                        m_b_im = nb_im;
                        m_c_re = nc_re;
                        m_c_im = nc_im;
                        m_d_re = nd_re;
                        m_d_im = nd_im;
                        k = k + 1;
                    }

                    // ZYZ decomposition: U = Rz(alpha) . Ry(beta) . Rz(gamma)
                    // beta = 2 * acos(|a|), where a = m[0,0]
                    let mag_a: f64 = sqrt_approx(m_a_re * m_a_re + m_a_im * m_a_im);
                    let mag_c: f64 = sqrt_approx(m_c_re * m_c_re + m_c_im * m_c_im);

                    var beta: f64 = 2.0 * acos_approx(mag_a);
                    var alpha: f64 = 0.0;
                    var gamma: f64 = 0.0;

                    if fabs(mag_a) > EPSILON() {
                        if fabs(mag_c) > EPSILON() {
                            // alpha = arg(a) + arg(c), gamma = arg(a) - arg(c)
                            let arg_a: f64 = atan2_approx(m_a_im, m_a_re);
                            let arg_c: f64 = atan2_approx(m_c_im, m_c_re);
                            alpha = arg_a + arg_c;
                            gamma = arg_a - arg_c;
                        } else {
                            let arg_a: f64 = atan2_approx(m_a_im, m_a_re);
                            alpha = arg_a;
                            gamma = arg_a;
                        }
                    } else {
                        let arg_c: f64 = atan2_approx(m_c_im, m_c_re);
                        alpha = arg_c;
                        gamma = 0.0 - arg_c;
                    }

                    // Emit Rz(alpha) . Ry(beta) . Rz(gamma)
                    if fabs(gamma) > EPSILON() {
                        push_instr(result, OP_RZ(), qubit, 0 - 1, f64_to_bits(gamma));
                    }
                    if fabs(beta) > EPSILON() {
                        push_instr(result, OP_RY(), qubit, 0 - 1, f64_to_bits(beta));
                    }
                    if fabs(alpha) > EPSILON() {
                        push_instr(result, OP_RZ(), qubit, 0 - 1, f64_to_bits(alpha));
                    }
                }
            } else {
                copy_instr(result, instrs, i);
            }
        }
        i = i + 1;
    }
    result
}

// Get 2x2 unitary matrix for a single-qubit gate as a vec of 8 f64-bits
// [a_re, a_im, b_re, b_im, c_re, c_im, d_re, d_im]
fn gate_to_matrix(op: i64, theta: f64) -> i64 {
    let m: i64 = vec_new();
    let inv_sqrt2: f64 = 0.70710678118654752;

    if op == OP_H() {
        vec_push(m, f64_to_bits(inv_sqrt2));  vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(inv_sqrt2));  vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(inv_sqrt2));  vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0 - inv_sqrt2)); vec_push(m, f64_to_bits(0.0));
        return m;
    }
    if op == OP_X() {
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(1.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(1.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        return m;
    }
    if op == OP_Y() {
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0 - 1.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(1.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        return m;
    }
    if op == OP_Z() {
        vec_push(m, f64_to_bits(1.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0 - 1.0)); vec_push(m, f64_to_bits(0.0));
        return m;
    }
    if op == OP_S() {
        vec_push(m, f64_to_bits(1.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(1.0));
        return m;
    }
    if op == OP_T() {
        let angle: f64 = PI() / 4.0;
        vec_push(m, f64_to_bits(1.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(cos(angle))); vec_push(m, f64_to_bits(sin(angle)));
        return m;
    }
    if op == OP_RX() {
        let c: f64 = cos(theta / 2.0);
        let s: f64 = sin(theta / 2.0);
        vec_push(m, f64_to_bits(c)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0 - s));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0 - s));
        vec_push(m, f64_to_bits(c)); vec_push(m, f64_to_bits(0.0));
        return m;
    }
    if op == OP_RY() {
        let c: f64 = cos(theta / 2.0);
        let s: f64 = sin(theta / 2.0);
        vec_push(m, f64_to_bits(c)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0 - s)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(s)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(c)); vec_push(m, f64_to_bits(0.0));
        return m;
    }
    if op == OP_RZ() {
        let half: f64 = theta / 2.0;
        vec_push(m, f64_to_bits(cos(0.0 - half))); vec_push(m, f64_to_bits(sin(0.0 - half)));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
        vec_push(m, f64_to_bits(cos(half))); vec_push(m, f64_to_bits(sin(half)));
        return m;
    }
    // Default: identity
    vec_push(m, f64_to_bits(1.0)); vec_push(m, f64_to_bits(0.0));
    vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
    vec_push(m, f64_to_bits(0.0)); vec_push(m, f64_to_bits(0.0));
    vec_push(m, f64_to_bits(1.0)); vec_push(m, f64_to_bits(0.0));
    m
}

// Approximate sqrt via Newton's method
fn sqrt_approx(x: f64) -> f64 {
    if x <= 0.0 { return 0.0; }
    var guess: f64 = x / 2.0;
    if guess < 0.001 { guess = 0.001; }
    var iter: i64 = 0;
    while iter < 20 {
        guess = (guess + x / guess) / 2.0;
        iter = iter + 1;
    }
    guess
}

// Approximate acos using asin identity: acos(x) = pi/2 - asin(x)
fn acos_approx(x: f64) -> f64 {
    var cx: f64 = x;
    if cx > 1.0 { cx = 1.0; }
    if cx < 0.0 - 1.0 { cx = 0.0 - 1.0; }
    PI() / 2.0 - asin_approx(cx)
}

// Approximate asin via polynomial (Chebyshev-like)
fn asin_approx(x: f64) -> f64 {
    var ax: f64 = x;
    if ax < 0.0 { ax = 0.0 - ax; }
    if ax > 1.0 { ax = 1.0; }
    // Use the identity: asin(x) = atan2(x, sqrt(1 - x*x))
    let sq: f64 = sqrt_approx(1.0 - ax * ax);
    let result: f64 = atan2_approx(ax, sq);
    if x < 0.0 { return 0.0 - result; }
    result
}

// Approximate atan2 via CORDIC-like series
fn atan2_approx(y: f64, x: f64) -> f64 {
    if fabs(x) < EPSILON() {
        if fabs(y) < EPSILON() { return 0.0; }
        if y > 0.0 { return PI() / 2.0; }
        return 0.0 - PI() / 2.0;
    }
    let ratio: f64 = y / x;
    let a: f64 = atan_approx(ratio);
    if x > 0.0 { return a; }
    if y >= 0.0 { return a + PI(); }
    a - PI()
}

// Approximate atan via series expansion for |x| <= 1,
// identity atan(x) = pi/2 - atan(1/x) for |x| > 1
fn atan_approx(x: f64) -> f64 {
    if fabs(x) > 1.0 {
        let a: f64 = atan_approx(1.0 / x);
        if x > 0.0 { return PI() / 2.0 - a; }
        return 0.0 - PI() / 2.0 - a;
    }
    // Taylor series: x - x^3/3 + x^5/5 - x^7/7 + ...
    var result: f64 = 0.0;
    var term: f64 = x;
    var x2: f64 = x * x;
    var sign: f64 = 1.0;
    var k: i64 = 0;
    while k < 15 {
        let denom: f64 = (2 * k + 1) as f64;
        result = result + sign * term / denom;
        term = term * x2;
        sign = 0.0 - sign;
        k = k + 1;
    }
    result
}

fn main() -> i64 {
    println(string_from("circuit-opt/fusion.sx OK"));
    0
}
