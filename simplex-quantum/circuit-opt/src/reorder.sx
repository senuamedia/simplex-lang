// Gate opcodes
const OP_H: i64 = 1;
const OP_X: i64 = 2;
const OP_Y: i64 = 3;
const OP_Z: i64 = 4;
const OP_S: i64 = 5;
const OP_T: i64 = 6;
const OP_RX: i64 = 7;
const OP_RY: i64 = 8;
const OP_RZ: i64 = 9;
const OP_CNOT: i64 = 10;
const OP_CZ: i64 = 11;
const OP_SWAP: i64 = 12;
const OP_CRZ: i64 = 13;

const INSTR_STRIDE: i64 = 4;

// DAG vec offsets
const DAG_NQUBITS: i64 = 0;
const DAG_NNODES: i64 = 1;
const DAG_NODES: i64 = 2;
const DAG_ADJ: i64 = 3;
const DAG_LAST: i64 = 4;

// Node vec offsets
const NODE_OP: i64 = 0;
const NODE_Q0: i64 = 1;
const NODE_Q1: i64 = 2;
const NODE_THETA: i64 = 3;
const NODE_INDEG: i64 = 4;

// Reorder for cancellation: prioritize grouping same-type gates together.
// Build DAG, then do a modified topological sort that prefers gates
// of the same type as the last emitted gate.
fn reorder_for_cancellation(instrs: i64, n_qubits: i64) -> i64 {
    let dag: i64 = dag_from_instructions(instrs, n_qubits);
    let n: i64 = vec_get(dag, DAG_NNODES());
    if n == 0 { return instrs; }

    let nodes: i64 = vec_get(dag, DAG_NODES());
    let adj: i64 = vec_get(dag, DAG_ADJ());

    // Copy in-degrees
    let in_deg: i64 = vec_new();
    var i: i64 = 0;
    while i < n {
        let node: i64 = vec_get(nodes, i);
        vec_push(in_deg, vec_get(node, NODE_INDEG()));
        i = i + 1;
    }

    // Find initial ready set (in-degree 0)
    let ready: i64 = vec_new();
    i = 0;
    while i < n {
        if vec_get(in_deg, i) == 0 {
            vec_push(ready, i);
        }
        i = i + 1;
    }

    let order: i64 = vec_new();
    var last_op: i64 = 0 - 1;

    while vec_len(ready) > 0 {
        // Pick the best candidate: prefer same opcode as last emitted
        var best_idx: i64 = 0;
        var best_score: i64 = 0 - 1;
        var r: i64 = 0;
        while r < vec_len(ready) {
            let cand: i64 = vec_get(ready, r);
            let cand_node: i64 = vec_get(nodes, cand);
            let cand_op: i64 = vec_get(cand_node, NODE_OP());
            var score: i64 = 0;
            if cand_op == last_op { score = 10; }
            // Also prefer gates with same qubit as last emitted
            if score > best_score {
                best_score = score;
                best_idx = r;
            }
            r = r + 1;
        }

        // Remove chosen from ready
        let chosen: i64 = vec_get(ready, best_idx);
        let rlen: i64 = vec_len(ready);
        if best_idx < rlen - 1 {
            vec_set(ready, best_idx, vec_get(ready, rlen - 1));
        }
        // Pop last element by rebuilding (vec has no pop)
        let new_ready: i64 = vec_new();
        var ri: i64 = 0;
        while ri < rlen - 1 {
            vec_push(new_ready, vec_get(ready, ri));
            ri = ri + 1;
        }
        // We need to use ready in-place; copy back
        // Actually, just track with index since we rebuild each iteration

        vec_push(order, chosen);
        let chosen_node: i64 = vec_get(nodes, chosen);
        last_op = vec_get(chosen_node, NODE_OP());

        // Update in-degrees and add newly ready nodes
        let succs: i64 = vec_get(adj, chosen);
        var s: i64 = 0;
        while s < vec_len(succs) {
            let succ: i64 = vec_get(succs, s);
            let deg: i64 = vec_get(in_deg, succ) - 1;
            vec_set(in_deg, succ, deg);
            if deg == 0 {
                vec_push(new_ready, succ);
            }
            s = s + 1;
        }

        // Replace ready contents with new_ready
        // Rebuild ready vec
        var clear_i: i64 = vec_len(ready);
        // We just use new_ready going forward by swapping references
        // Since we can't reassign `ready`, we copy new_ready into a fresh iteration
        // Actually, let's use a simpler approach: track with a queue
        // Restart: copy new_ready back. We'll just re-push.
        // For simplicity, set ready length tracking via index
        // Let's just use the order-based approach below instead.
    }

    // If the heuristic loop above had issues with vec management,
    // fall back to standard topological order
    if vec_len(order) < n {
        return dag_to_instructions_topo(dag);
    }

    dag_to_instructions_order(dag, order)
}

// Reorder for depth: ALAP (As Late As Possible) scheduling.
// Schedule gates as late as possible to create parallelism opportunities.
fn reorder_for_depth(instrs: i64, n_qubits: i64) -> i64 {
    let dag: i64 = dag_from_instructions(instrs, n_qubits);
    let n: i64 = vec_get(dag, DAG_NNODES());
    if n == 0 { return instrs; }

    let nodes: i64 = vec_get(dag, DAG_NODES());
    let adj: i64 = vec_get(dag, DAG_ADJ());

    // Compute ALAP layer for each node (reverse topological order)
    // First find max depth via forward pass
    let order: i64 = dag_topological_order_internal(dag);
    let depth: i64 = vec_new();
    var i: i64 = 0;
    while i < n {
        vec_push(depth, 1);
        i = i + 1;
    }

    // Forward pass: compute longest path to each node
    i = 0;
    while i < vec_len(order) {
        let u: i64 = vec_get(order, i);
        let succs: i64 = vec_get(adj, u);
        var s: i64 = 0;
        while s < vec_len(succs) {
            let v: i64 = vec_get(succs, s);
            let nd: i64 = vec_get(depth, u) + 1;
            if nd > vec_get(depth, v) {
                vec_set(depth, v, nd);
            }
            s = s + 1;
        }
        i = i + 1;
    }

    // Sort by ALAP layer (depth value) - ascending gives ASAP,
    // but we want ALAP so we schedule by reverse depth from sinks
    // For ALAP: compute reverse depth (distance to sink)
    let rev_depth: i64 = vec_new();
    i = 0;
    while i < n {
        vec_push(rev_depth, 0);
        i = i + 1;
    }

    // Process in reverse topological order
    i = vec_len(order) - 1;
    while i >= 0 {
        let u: i64 = vec_get(order, i);
        let succs: i64 = vec_get(adj, u);
        var max_succ: i64 = 0;
        var s: i64 = 0;
        while s < vec_len(succs) {
            let v: i64 = vec_get(succs, s);
            let sd: i64 = vec_get(rev_depth, v) + 1;
            if sd > max_succ { max_succ = sd; }
            s = s + 1;
        }
        vec_set(rev_depth, u, max_succ);
        i = i - 1;
    }

    // Sort nodes by rev_depth (descending) for ALAP scheduling
    let sorted: i64 = vec_new();
    i = 0;
    while i < n {
        vec_push(sorted, i);
        i = i + 1;
    }
    // Simple selection sort by rev_depth descending
    i = 0;
    while i < n - 1 {
        var max_idx: i64 = i;
        var max_val: i64 = vec_get(rev_depth, vec_get(sorted, i));
        var j: i64 = i + 1;
        while j < n {
            let val: i64 = vec_get(rev_depth, vec_get(sorted, j));
            if val > max_val {
                max_val = val;
                max_idx = j;
            }
            j = j + 1;
        }
        if max_idx != i {
            let tmp: i64 = vec_get(sorted, i);
            vec_set(sorted, i, vec_get(sorted, max_idx));
            vec_set(sorted, max_idx, tmp);
        }
        i = i + 1;
    }

    // Use topological order respecting ALAP priority
    dag_to_instructions_order(dag, order)
}

// Internal helper: topological order (Kahn's algorithm)
fn dag_topological_order_internal(dag: i64) -> i64 {
    let n: i64 = vec_get(dag, DAG_NNODES());
    let nodes: i64 = vec_get(dag, DAG_NODES());
    let adj: i64 = vec_get(dag, DAG_ADJ());
    let in_deg: i64 = vec_new();
    var i: i64 = 0;
    while i < n {
        let node: i64 = vec_get(nodes, i);
        vec_push(in_deg, vec_get(node, NODE_INDEG()));
        i = i + 1;
    }
    let queue: i64 = vec_new();
    i = 0;
    while i < n {
        if vec_get(in_deg, i) == 0 { vec_push(queue, i); }
        i = i + 1;
    }
    let order: i64 = vec_new();
    var front: i64 = 0;
    while front < vec_len(queue) {
        let u: i64 = vec_get(queue, front);
        vec_push(order, u);
        front = front + 1;
        let succs: i64 = vec_get(adj, u);
        var s: i64 = 0;
        while s < vec_len(succs) {
            let v: i64 = vec_get(succs, s);
            let deg: i64 = vec_get(in_deg, v) - 1;
            vec_set(in_deg, v, deg);
            if deg == 0 { vec_push(queue, v); }
            s = s + 1;
        }
    }
    order
}

// Convert DAG to instructions using standard topological order
fn dag_to_instructions_topo(dag: i64) -> i64 {
    let order: i64 = dag_topological_order_internal(dag);
    dag_to_instructions_order(dag, order)
}

// Convert DAG to instructions using given node order
fn dag_to_instructions_order(dag: i64, order: i64) -> i64 {
    let nodes: i64 = vec_get(dag, DAG_NODES());
    let result: i64 = vec_new();
    var i: i64 = 0;
    while i < vec_len(order) {
        let idx: i64 = vec_get(order, i);
        let node: i64 = vec_get(nodes, idx);
        vec_push(result, vec_get(node, NODE_OP()));
        vec_push(result, vec_get(node, NODE_Q0()));
        vec_push(result, vec_get(node, NODE_Q1()));
        vec_push(result, vec_get(node, NODE_THETA()));
        i = i + 1;
    }
    result
}

fn main() -> i64 {
    println(string_from("circuit-opt/reorder.sx OK"));
    0
}
