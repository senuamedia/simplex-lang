// Amplitude and Phase Damping Channels
// Amplitude damping: T1 decay (energy relaxation)
//   K0 = [[1, 0], [0, sqrt(1-gamma)]]
//   K1 = [[0, sqrt(gamma)], [0, 0]]
// Phase damping: T2 dephasing
//   K0 = [[1, 0], [0, sqrt(1-lambda)]]
//   K1 = [[0, 0], [0, sqrt(lambda)]]
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

const CHANNEL_AMPLITUDE_DAMPING: i64 = 2;
const CHANNEL_PHASE_DAMPING: i64 = 3;

fn amplitude_damping_new(gamma: f64) -> i64 {
    let ch: i64 = vec_new();
    vec_push(ch, CHANNEL_AMPLITUDE_DAMPING);
    vec_push(ch, f64_to_bits(gamma));
    ch
}

fn amplitude_damping_gamma(channel: i64) -> f64 {
    bits_to_f64(vec_get(channel, 1))
}

// Apply amplitude damping: |1> decays to |0> with probability gamma
fn amplitude_damping_apply(state_re: i64, state_im: i64, dim: i64, qubit: i64, gamma: f64) -> i64 {
    let sqrt_1mg: f64 = sqrt(1.0 - gamma);
    let sqrt_g: f64 = sqrt(gamma);
    let stride: i64 = 1 << qubit;
    var i: i64 = 0;
    while i < dim {
        if (i >> qubit) % 2 == 0 {
            let j: i64 = i + stride;
            let re_i: f64 = bits_to_f64(load_ptr(state_re, i));
            let im_i: f64 = bits_to_f64(load_ptr(state_im, i));
            let re_j: f64 = bits_to_f64(load_ptr(state_re, j));
            let im_j: f64 = bits_to_f64(load_ptr(state_im, j));

            let p0: f64 = re_i * re_i + im_i * im_i;
            let p1: f64 = re_j * re_j + im_j * im_j;

            // After damping: p0' = p0 + gamma*p1, p1' = (1-gamma)*p1
            let new_p0: f64 = p0 + gamma * p1;
            let new_p1: f64 = (1.0 - gamma) * p1;

            // Update amplitudes preserving phase where possible
            store_ptr(state_re, i, f64_to_bits(sqrt(new_p0)));
            store_ptr(state_im, i, f64_to_bits(0.0));
            store_ptr(state_re, j, f64_to_bits(sqrt(new_p1)));
            store_ptr(state_im, j, f64_to_bits(0.0));
        }
        i = i + 1;
    }
    0
}

fn phase_damping_new(lambda: f64) -> i64 {
    let ch: i64 = vec_new();
    vec_push(ch, CHANNEL_PHASE_DAMPING);
    vec_push(ch, f64_to_bits(lambda));
    ch
}

fn phase_damping_lambda(channel: i64) -> f64 {
    bits_to_f64(vec_get(channel, 1))
}

// Apply phase damping: coherences decay by sqrt(1-lambda)
fn phase_damping_apply(state_re: i64, state_im: i64, dim: i64, qubit: i64, lambda: f64) -> i64 {
    let damp: f64 = sqrt(1.0 - lambda);
    let stride: i64 = 1 << qubit;
    var i: i64 = 0;
    while i < dim {
        if (i >> qubit) % 2 == 0 {
            let j: i64 = i + stride;
            // Damp the |1> component phase (off-diagonal elements)
            let re_j: f64 = bits_to_f64(load_ptr(state_re, j));
            let im_j: f64 = bits_to_f64(load_ptr(state_im, j));
            store_ptr(state_re, j, f64_to_bits(re_j * damp));
            store_ptr(state_im, j, f64_to_bits(im_j * damp));
        }
        i = i + 1;
    }
    0
}

// Combined T1/T2 thermal relaxation model
fn thermal_relaxation_new(t1: f64, t2: f64, gate_time: f64) -> i64 {
    let ch: i64 = vec_new();
    vec_push(ch, CHANNEL_AMPLITUDE_DAMPING);  // combined type
    // gamma = 1 - exp(-gate_time/T1)
    let gamma: f64 = 1.0 - exp(0.0 - gate_time / t1);
    // lambda = 1 - exp(-gate_time/T2) (but T2 <= 2*T1)
    let t2_eff: f64 = if t2 > 2.0 * t1 { 2.0 * t1 } else { t2 };
    let lambda: f64 = 1.0 - exp(0.0 - gate_time / t2_eff);
    vec_push(ch, f64_to_bits(gamma));
    vec_push(ch, f64_to_bits(lambda));
    ch
}

fn main() -> i64 {
    println(string_from("damping.sx OK"));
    0
}
