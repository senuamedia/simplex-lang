// simplex-training::schedules::curriculum - Learnable Curriculum Schedule
//
// Implements differentiable curriculum learning with:
// - Difficulty-based specialist ordering
// - Multi-task mixing matrix
// - Meta-gradient integration for schedule adaptation
// - Progressive difficulty scaling
//
// The curriculum learns optimal task ordering and mixing through
// meta-gradient descent, adapting to model capacity and learning dynamics.

use simplex_std::dual::dual;
use simplex_std::{Clone, Default, Vec};

// =============================================================================
// Curriculum Gradient
// =============================================================================

/// Gradient for curriculum parameters
#[derive(Clone)]
pub struct CurriculumGradient {
    /// Gradient w.r.t. difficulty weights per specialist
    pub d_difficulty_weights: Vec<f64>,
    /// Gradient w.r.t. mixing matrix entries (flattened row-major)
    pub d_mixing_matrix: Vec<f64>,
    /// Gradient w.r.t. progression rate
    pub d_progression_rate: f64,
    /// Gradient w.r.t. difficulty sensitivity
    pub d_difficulty_sensitivity: f64,
    /// Gradient w.r.t. mixing temperature
    pub d_mixing_temperature: f64,
}

impl CurriculumGradient {
    /// Create zero gradient for given number of specialists
    pub fn zero(num_specialists: usize) -> CurriculumGradient {
        CurriculumGradient {
            d_difficulty_weights: vec![0.0; num_specialists],
            d_mixing_matrix: vec![0.0; num_specialists * num_specialists],
            d_progression_rate: 0.0,
            d_difficulty_sensitivity: 0.0,
            d_mixing_temperature: 0.0,
        }
    }

    /// Scale all gradients by factor
    pub fn scale(&mut self, factor: f64) {
        for w in self.d_difficulty_weights.iter_mut() {
            *w = *w * factor;
        }
        for m in self.d_mixing_matrix.iter_mut() {
            *m = *m * factor;
        }
        self.d_progression_rate = self.d_progression_rate * factor;
        self.d_difficulty_sensitivity = self.d_difficulty_sensitivity * factor;
        self.d_mixing_temperature = self.d_mixing_temperature * factor;
    }

    /// Compute L2 norm
    pub fn norm(&self) -> f64 {
        var sum = 0.0;
        for w in self.d_difficulty_weights.iter() {
            sum = sum + w * w;
        }
        for m in self.d_mixing_matrix.iter() {
            sum = sum + m * m;
        }
        sum = sum + self.d_progression_rate * self.d_progression_rate;
        sum = sum + self.d_difficulty_sensitivity * self.d_difficulty_sensitivity;
        sum = sum + self.d_mixing_temperature * self.d_mixing_temperature;
        sum.sqrt()
    }

    /// Add another gradient
    pub fn add(&mut self, other: &CurriculumGradient) {
        for i in 0..self.d_difficulty_weights.len().min(other.d_difficulty_weights.len()) {
            self.d_difficulty_weights[i] = self.d_difficulty_weights[i] + other.d_difficulty_weights[i];
        }
        for i in 0..self.d_mixing_matrix.len().min(other.d_mixing_matrix.len()) {
            self.d_mixing_matrix[i] = self.d_mixing_matrix[i] + other.d_mixing_matrix[i];
        }
        self.d_progression_rate = self.d_progression_rate + other.d_progression_rate;
        self.d_difficulty_sensitivity = self.d_difficulty_sensitivity + other.d_difficulty_sensitivity;
        self.d_mixing_temperature = self.d_mixing_temperature + other.d_mixing_temperature;
    }
}

impl Default for CurriculumGradient {
    fn default() -> CurriculumGradient {
        CurriculumGradient::zero(0)
    }
}

// =============================================================================
// Specialist Task Descriptor
// =============================================================================

/// Describes a specialist task in the curriculum
#[derive(Clone)]
pub struct TaskDescriptor {
    /// Task identifier (index into specialist list)
    pub task_id: usize,
    /// Task name
    pub name: String,
    /// Base difficulty (0.0 = easy, 1.0 = hard)
    pub base_difficulty: f64,
    /// Current loss for this task
    pub current_loss: f64,
    /// Number of steps trained on this task
    pub steps_trained: u64,
}

impl TaskDescriptor {
    pub fn new(task_id: usize, name: &str, difficulty: f64) -> TaskDescriptor {
        TaskDescriptor {
            task_id,
            name: name.to_string(),
            base_difficulty: difficulty,
            current_loss: f64::MAX,
            steps_trained: 0,
        }
    }

    /// Effective difficulty accounting for current performance
    pub fn effective_difficulty(&self) -> f64 {
        if self.current_loss < f64::MAX {
            // Combine base difficulty with actual performance
            self.base_difficulty * 0.5 + (self.current_loss / (1.0 + self.current_loss)) * 0.5
        } else {
            self.base_difficulty
        }
    }
}

// =============================================================================
// Learnable Curriculum
// =============================================================================

/// Learnable curriculum for multi-task training with meta-gradient support.
///
/// Manages specialist ordering, difficulty progression, and multi-task mixing.
/// All learnable parameters use dual numbers for gradient tracking.
#[derive(Clone)]
pub struct LearnableCurriculum {
    /// Difficulty weight per specialist (learnable, controls ordering)
    pub difficulty_weights: Vec<dual>,
    /// Multi-task mixing matrix (learnable, n x n)
    /// Entry [i][j] = how much task j contributes when training task i
    pub mixing_matrix: Vec<Vec<dual>>,
    /// Progression rate: how fast to advance difficulty
    pub progression_rate: dual,
    /// Difficulty sensitivity: how sharply difficulty affects ordering
    pub difficulty_sensitivity: dual,
    /// Mixing temperature: controls mixing sharpness (higher = more uniform)
    pub mixing_temperature: dual,
    /// Number of specialists
    pub num_specialists: usize,
    /// Task descriptors
    pub tasks: Vec<TaskDescriptor>,
    /// Current curriculum step
    pub step: u64,
    /// Training progress (0.0 to 1.0)
    pub progress: f64,
}

impl LearnableCurriculum {
    /// Create curriculum for given number of specialists
    pub fn new(num_specialists: usize) -> LearnableCurriculum {
        // Initialize difficulty weights uniformly
        var difficulty_weights = Vec::new();
        for i in 0..num_specialists {
            let w = (i as f64 + 1.0) / (num_specialists as f64);
            difficulty_weights.push(dual::variable(w));
        }

        // Initialize mixing matrix as identity-biased
        var mixing_matrix = Vec::new();
        for i in 0..num_specialists {
            var row = Vec::new();
            for j in 0..num_specialists {
                if i == j {
                    row.push(dual::variable(0.8));  // Primary task weight
                } else {
                    // Uniform off-diagonal: share remaining 0.2
                    let off_diag = if num_specialists > 1 {
                        0.2 / ((num_specialists - 1) as f64)
                    } else {
                        0.0
                    };
                    row.push(dual::variable(off_diag));
                }
            }
            mixing_matrix.push(row);
        }

        // Initialize empty task descriptors
        var tasks = Vec::new();
        for i in 0..num_specialists {
            let difficulty = (i as f64 + 1.0) / (num_specialists as f64);
            tasks.push(TaskDescriptor::new(i, &format!("task_{}", i), difficulty));
        }

        LearnableCurriculum {
            difficulty_weights,
            mixing_matrix,
            progression_rate: dual::variable(0.01),
            difficulty_sensitivity: dual::variable(2.0),
            mixing_temperature: dual::variable(1.0),
            num_specialists,
            tasks,
            step: 0,
            progress: 0.0,
        }
    }

    /// Create curriculum with named tasks
    pub fn with_tasks(tasks: Vec<TaskDescriptor>) -> LearnableCurriculum {
        let n = tasks.len();
        var curriculum = LearnableCurriculum::new(n);
        // Set difficulty weights from task descriptors
        for i in 0..n {
            curriculum.difficulty_weights[i] = dual::variable(tasks[i].base_difficulty);
        }
        curriculum.tasks = tasks;
        curriculum
    }

    /// Set training progress (0.0 to 1.0)
    pub fn set_progress(&mut self, progress: f64) {
        self.progress = progress.max(0.0).min(1.0);
    }

    /// Get the current difficulty threshold based on progress
    ///
    /// Returns a dual value for gradient tracking.
    /// Early in training, only easy tasks are exposed.
    /// As training progresses, harder tasks are introduced.
    pub fn difficulty_threshold(&self) -> dual {
        let progress_dual = dual::constant(self.progress);
        // Sigmoid-shaped curriculum: smooth transition
        let raw = progress_dual * self.difficulty_sensitivity;
        // Map through sigmoid so threshold starts low and grows
        raw.sigmoid()
    }

    /// Compute specialist ordering based on current difficulty weights
    ///
    /// Returns indices sorted by effective difficulty (easy first).
    /// The ordering adapts through meta-gradient updates.
    pub fn specialist_ordering(&self) -> Vec<usize> {
        // Compute effective score for each specialist
        var scores: Vec<(usize, f64)> = Vec::new();
        let threshold = self.difficulty_threshold();

        for i in 0..self.num_specialists {
            let weight = self.difficulty_weights[i];
            let task_difficulty = self.tasks[i].effective_difficulty();

            // Score: tasks below threshold get priority (lower score = earlier)
            // Combines learnable weight with task difficulty
            let score = weight.val * task_difficulty;
            scores.push((i, score));
        }

        // Sort by score (ascending = easy first)
        bubble_sort_pairs(&mut scores);

        var ordering = Vec::new();
        for (idx, _score) in scores.iter() {
            ordering.push(*idx);
        }
        ordering
    }

    /// Get mixing weights for training task i
    ///
    /// Returns softmax-normalized mixing weights, determining how much
    /// each task contributes to the loss when training specialist i.
    pub fn mixing_weights(&self, task_idx: usize) -> Vec<dual> {
        if task_idx >= self.num_specialists {
            return Vec::new();
        }

        let row = &self.mixing_matrix[task_idx];

        // Apply temperature-scaled softmax
        var max_val = row[0];
        for j in 1..row.len() {
            if row[j].val > max_val.val {
                max_val = row[j];
            }
        }

        var exp_sum = dual::zero();
        var exps = Vec::new();
        for j in 0..row.len() {
            let scaled = (row[j] - max_val) / self.mixing_temperature;
            let e = scaled.exp();
            exps.push(e);
            exp_sum = exp_sum + e;
        }

        var weights = Vec::new();
        for e in exps.iter() {
            weights.push(*e / exp_sum);
        }
        weights
    }

    /// Compute multi-task loss for a given specialist
    ///
    /// Combines per-task losses using the mixing weights.
    pub fn mixed_loss(&self, task_idx: usize, task_losses: &[dual]) -> dual {
        let weights = self.mixing_weights(task_idx);

        var total = dual::zero();
        for j in 0..weights.len().min(task_losses.len()) {
            total = total + weights[j] * task_losses[j];
        }
        total
    }

    /// Check if a task should be active at current progress
    pub fn is_task_active(&self, task_idx: usize) -> bool {
        if task_idx >= self.num_specialists {
            return false;
        }
        let threshold = self.difficulty_threshold().val;
        let task_difficulty = self.difficulty_weights[task_idx].val;
        task_difficulty <= threshold + 0.1  // Small margin for smooth transition
    }

    /// Get active task indices at current progress
    pub fn active_tasks(&self) -> Vec<usize> {
        var active = Vec::new();
        for i in 0..self.num_specialists {
            if self.is_task_active(i) {
                active.push(i);
            }
        }
        // Always ensure at least one task is active
        if active.is_empty() && self.num_specialists > 0 {
            active.push(0);
        }
        active
    }

    /// Update task loss and step count
    pub fn record_task_step(&mut self, task_idx: usize, loss: f64) {
        if task_idx < self.tasks.len() {
            self.tasks[task_idx].current_loss = loss;
            self.tasks[task_idx].steps_trained = self.tasks[task_idx].steps_trained + 1;
        }
        self.step = self.step + 1;
    }

    /// Extract gradients from all learnable parameters
    pub fn extract_gradients(&self) -> CurriculumGradient {
        var d_difficulty = Vec::new();
        for w in self.difficulty_weights.iter() {
            d_difficulty.push(w.der);
        }

        var d_mixing = Vec::new();
        for row in self.mixing_matrix.iter() {
            for m in row.iter() {
                d_mixing.push(m.der);
            }
        }

        CurriculumGradient {
            d_difficulty_weights: d_difficulty,
            d_mixing_matrix: d_mixing,
            d_progression_rate: self.progression_rate.der,
            d_difficulty_sensitivity: self.difficulty_sensitivity.der,
            d_mixing_temperature: self.mixing_temperature.der,
        }
    }

    /// Alias for extract_gradients for consistency with other schedule modules
    pub fn gradient(&self) -> CurriculumGradient {
        self.extract_gradients()
    }

    /// Apply gradients with given learning rate (meta-update)
    pub fn apply_gradients(&mut self, grads: &CurriculumGradient, lr: f64) {
        // Update difficulty weights
        for i in 0..self.difficulty_weights.len().min(grads.d_difficulty_weights.len()) {
            let new_val = self.difficulty_weights[i].val - lr * grads.d_difficulty_weights[i];
            self.difficulty_weights[i] = dual::new(new_val.max(0.0).min(1.0), 1.0);
        }

        // Update mixing matrix
        var flat_idx = 0;
        for i in 0..self.mixing_matrix.len() {
            for j in 0..self.mixing_matrix[i].len() {
                if flat_idx < grads.d_mixing_matrix.len() {
                    let new_val = self.mixing_matrix[i][j].val - lr * grads.d_mixing_matrix[flat_idx];
                    self.mixing_matrix[i][j] = dual::new(new_val.max(0.0).min(1.0), 1.0);
                }
                flat_idx = flat_idx + 1;
            }
        }

        // Update scalar parameters
        self.progression_rate = dual::new(
            (self.progression_rate.val - lr * grads.d_progression_rate).max(0.001).min(1.0),
            1.0
        );
        self.difficulty_sensitivity = dual::new(
            (self.difficulty_sensitivity.val - lr * grads.d_difficulty_sensitivity).max(0.1).min(10.0),
            1.0
        );
        self.mixing_temperature = dual::new(
            (self.mixing_temperature.val - lr * grads.d_mixing_temperature).max(0.01).min(10.0),
            1.0
        );

        // Re-normalize mixing matrix rows
        self.normalize_mixing_matrix();
    }

    /// Alias for apply_gradients for consistency
    pub fn update(&mut self, grad: &CurriculumGradient, lr: f64) {
        self.apply_gradients(grad, lr);
    }

    /// Normalize mixing matrix rows so each sums to ~1.0
    fn normalize_mixing_matrix(&mut self) {
        for i in 0..self.mixing_matrix.len() {
            var row_sum = 0.0;
            for j in 0..self.mixing_matrix[i].len() {
                row_sum = row_sum + self.mixing_matrix[i][j].val;
            }
            if row_sum > 0.0 {
                for j in 0..self.mixing_matrix[i].len() {
                    let normalized = self.mixing_matrix[i][j].val / row_sum;
                    self.mixing_matrix[i][j] = dual::new(normalized, self.mixing_matrix[i][j].der);
                }
            }
        }
    }

    /// L2 norm of all learnable parameters (for regularization)
    pub fn l2_norm(&self) -> dual {
        var norm = dual::zero();

        for w in self.difficulty_weights.iter() {
            norm = norm + *w * *w;
        }
        for row in self.mixing_matrix.iter() {
            for m in row.iter() {
                norm = norm + *m * *m;
            }
        }
        norm = norm + self.progression_rate * self.progression_rate;
        norm = norm + self.difficulty_sensitivity * self.difficulty_sensitivity;
        norm = norm + self.mixing_temperature * self.mixing_temperature;

        norm
    }

    /// Advance curriculum step
    pub fn advance(&mut self, total_steps: u64) {
        self.step = self.step + 1;
        if total_steps > 0 {
            self.progress = self.step as f64 / total_steps as f64;
        }
    }

    /// Get summary of curriculum state
    pub fn summary(&self) -> CurriculumSummary {
        let ordering = self.specialist_ordering();
        let active = self.active_tasks();

        CurriculumSummary {
            num_specialists: self.num_specialists,
            current_step: self.step,
            progress: self.progress,
            difficulty_threshold: self.difficulty_threshold().val,
            active_tasks: active.len(),
            ordering,
        }
    }
}

impl Default for LearnableCurriculum {
    fn default() -> LearnableCurriculum {
        LearnableCurriculum::new(4)  // Default 4 specialists
    }
}

// =============================================================================
// Curriculum Summary
// =============================================================================

/// Summary of current curriculum state
#[derive(Clone)]
pub struct CurriculumSummary {
    /// Number of specialists
    pub num_specialists: usize,
    /// Current curriculum step
    pub current_step: u64,
    /// Training progress (0.0 to 1.0)
    pub progress: f64,
    /// Current difficulty threshold
    pub difficulty_threshold: f64,
    /// Number of active tasks
    pub active_tasks: usize,
    /// Current specialist ordering
    pub ordering: Vec<usize>,
}

// =============================================================================
// Helpers
// =============================================================================

/// Bubble sort for (index, score) pairs by score ascending
fn bubble_sort_pairs(pairs: &mut Vec<(usize, f64)>) {
    let n = pairs.len();
    for i in 0..n {
        for j in 0..(n - i - 1) {
            if pairs[j].1 > pairs[j + 1].1 {
                let tmp = pairs[j];
                pairs[j] = pairs[j + 1];
                pairs[j + 1] = tmp;
            }
        }
    }
}

use simplex_std::string::String;

/// Format helper
fn format(template: &str, val: usize) -> String {
    let mut result = template.to_string();
    result.push_str(&val.to_string());
    result
}
