// simplex-training::trainer::meta - Meta-Learning Trainer
//
// Implements meta-optimization for hyperparameters:
// - Learns optimal schedule parameters via gradient descent on validation loss
// - Orchestrates ALL learnable schedules: LR, distillation, pruning, quantization, curriculum
// - Uses nested optimization (inner train, outer tune)
// - Gradient clipping for stability
// - History tracking for convergence analysis

use simplex_std::dual::dual;
use simplex_std::{Clone, Default, Vec};
use crate::schedules::{
    LearnedSchedules, SchedulesGradient,
    LearnableLRSchedule, LearnableDistillation,
    LearnablePruning, LearnableQuantization,
    LearnableCurriculum, CurriculumGradient,
};
use super::{StepResult, TrainingHistory, Checkpoint, EarlyStopping};

/// Configuration for meta-trainer
#[derive(Clone)]
pub struct MetaConfig {
    /// Meta learning rate
    pub meta_lr: f64,
    /// Inner loop steps per meta step
    pub inner_steps: u64,
    /// Outer loop (meta) steps
    pub meta_steps: u64,
    /// Validation frequency
    pub val_every: u64,
    /// Gradient clipping threshold
    pub grad_clip: f64,
    /// L2 regularization on schedules
    pub schedule_reg: f64,
    /// Early stopping patience
    pub patience: u64,
    /// Number of curriculum specialists
    pub num_specialists: usize,
    /// Enable curriculum learning
    pub enable_curriculum: bool,
    /// Enable distillation schedule
    pub enable_distillation: bool,
    /// Enable pruning schedule
    pub enable_pruning: bool,
    /// Enable quantization schedule
    pub enable_quantization: bool,
    /// Meta-loss convergence threshold
    pub convergence_threshold: f64,
}

impl MetaConfig {
    pub fn new() -> MetaConfig {
        MetaConfig {
            meta_lr: 0.001,
            inner_steps: 100,
            meta_steps: 50,
            val_every: 10,
            grad_clip: 1.0,
            schedule_reg: 1e-5,
            patience: 10,
            num_specialists: 4,
            enable_curriculum: true,
            enable_distillation: true,
            enable_pruning: true,
            enable_quantization: true,
            convergence_threshold: 1e-6,
        }
    }

    /// Config for fast iteration (fewer steps)
    pub fn fast() -> MetaConfig {
        var config = MetaConfig::new();
        config.inner_steps = 20;
        config.meta_steps = 10;
        config.val_every = 5;
        config
    }

    /// Config for thorough meta-optimization
    pub fn thorough() -> MetaConfig {
        var config = MetaConfig::new();
        config.inner_steps = 500;
        config.meta_steps = 200;
        config.patience = 30;
        config
    }
}

impl Default for MetaConfig {
    fn default() -> MetaConfig {
        MetaConfig::new()
    }
}

/// Meta-loss components for analysis
#[derive(Clone)]
pub struct MetaLoss {
    /// Primary validation loss
    pub val_loss: dual,
    /// Schedule regularization
    pub reg_loss: dual,
    /// Curriculum contribution
    pub curriculum_loss: dual,
    /// Total meta loss
    pub total: dual,
}

impl MetaLoss {
    pub fn new(val_loss: dual, schedules: &LearnedSchedules, reg_weight: f64) -> MetaLoss {
        let reg_loss = schedules.l2_norm() * dual::constant(reg_weight);
        MetaLoss {
            val_loss,
            reg_loss,
            curriculum_loss: dual::zero(),
            total: val_loss + reg_loss,
        }
    }

    /// Create with curriculum cost (penalizes suboptimal ordering)
    pub fn with_curriculum(
        val_loss: dual,
        schedules: &LearnedSchedules,
        reg_weight: f64,
        curriculum_cost: dual,
    ) -> MetaLoss {
        let reg_loss = schedules.l2_norm() * dual::constant(reg_weight);
        MetaLoss {
            val_loss,
            reg_loss,
            curriculum_loss: curriculum_cost,
            total: val_loss + reg_loss + curriculum_cost * dual::constant(0.1),
        }
    }
}

// =============================================================================
// Meta-Optimizer: Gradient-based schedule tuning
// =============================================================================

/// Meta-optimizer that updates all learnable schedules
///
/// Maintains running statistics and applies clipped gradient updates
/// to LR, distillation, pruning, quantization, and curriculum schedules.
pub struct MetaOptimizer {
    /// Meta learning rate
    pub lr: f64,
    /// Gradient clipping threshold
    pub grad_clip: f64,
    /// Total meta steps applied
    pub total_steps: u64,
    /// Gradient history for diagnostics
    pub grad_norms: Vec<f64>,
    /// Per-schedule update counts
    pub lr_updates: u64,
    pub distill_updates: u64,
    pub prune_updates: u64,
    pub quant_updates: u64,
    pub curriculum_updates: u64,
}

impl MetaOptimizer {
    /// Create new meta-optimizer
    pub fn new(lr: f64, grad_clip: f64) -> MetaOptimizer {
        MetaOptimizer {
            lr,
            grad_clip,
            total_steps: 0,
            grad_norms: Vec::new(),
            lr_updates: 0,
            distill_updates: 0,
            prune_updates: 0,
            quant_updates: 0,
            curriculum_updates: 0,
        }
    }

    /// Clip gradient by global norm
    pub fn clip_gradient(&self, grad: &mut SchedulesGradient) -> f64 {
        let norm = grad.norm();
        if norm > self.grad_clip {
            let scale = self.grad_clip / norm;
            grad.scale(scale);
        }
        norm
    }

    /// Apply single meta-gradient step to all schedules
    pub fn step(&mut self, schedules: &mut LearnedSchedules, grad: &SchedulesGradient) {
        // Clone and clip
        var clipped = grad.clone();
        let norm = self.clip_gradient(&mut clipped);
        self.grad_norms.push(norm);

        // Update all schedules
        schedules.update(&clipped, self.lr);

        // Track per-schedule updates
        self.lr_updates = self.lr_updates + 1;
        self.distill_updates = self.distill_updates + 1;
        self.prune_updates = self.prune_updates + 1;
        self.quant_updates = self.quant_updates + 1;
        self.curriculum_updates = self.curriculum_updates + 1;
        self.total_steps = self.total_steps + 1;
    }

    /// Apply selective update (only specified schedules)
    pub fn step_selective(
        &mut self,
        schedules: &mut LearnedSchedules,
        grad: &SchedulesGradient,
        update_lr: bool,
        update_distill: bool,
        update_prune: bool,
        update_quant: bool,
        update_curriculum: bool,
    ) {
        var clipped = grad.clone();
        let norm = self.clip_gradient(&mut clipped);
        self.grad_norms.push(norm);

        if update_lr {
            schedules.lr.update(&clipped.lr, self.lr);
            self.lr_updates = self.lr_updates + 1;
        }
        if update_distill {
            schedules.distill.update(&clipped.distill, self.lr);
            self.distill_updates = self.distill_updates + 1;
        }
        if update_prune {
            schedules.prune.update(&clipped.prune, self.lr);
            self.prune_updates = self.prune_updates + 1;
        }
        if update_quant {
            schedules.quant.update(&clipped.quant, self.lr);
            self.quant_updates = self.quant_updates + 1;
        }
        if update_curriculum {
            schedules.curriculum.apply_gradients(&clipped.curriculum, self.lr);
            self.curriculum_updates = self.curriculum_updates + 1;
        }

        self.total_steps = self.total_steps + 1;
    }

    /// Get average gradient norm
    pub fn avg_grad_norm(&self) -> f64 {
        if self.grad_norms.is_empty() {
            return 0.0;
        }
        var sum = 0.0;
        for n in self.grad_norms.iter() {
            sum = sum + n;
        }
        sum / (self.grad_norms.len() as f64)
    }

    /// Get recent gradient norm (last N)
    pub fn recent_grad_norm(&self, window: usize) -> f64 {
        let start = if self.grad_norms.len() > window {
            self.grad_norms.len() - window
        } else {
            0
        };
        let slice = &self.grad_norms[start..];
        if slice.is_empty() {
            return 0.0;
        }
        var sum = 0.0;
        for n in slice.iter() {
            sum = sum + n;
        }
        sum / (slice.len() as f64)
    }

    /// Check if gradients are vanishing
    pub fn gradients_vanishing(&self, threshold: f64) -> bool {
        self.recent_grad_norm(10) < threshold
    }

    /// Total update count across all schedules
    pub fn total_updates(&self) -> u64 {
        self.lr_updates + self.distill_updates +
        self.prune_updates + self.quant_updates +
        self.curriculum_updates
    }
}

impl Default for MetaOptimizer {
    fn default() -> MetaOptimizer {
        MetaOptimizer::new(0.001, 1.0)
    }
}

// =============================================================================
// Meta-Training State
// =============================================================================

/// Meta-trainer state with convergence tracking
#[derive(Clone)]
pub struct MetaState {
    /// Current meta step
    pub meta_step: u64,
    /// Current inner step
    pub inner_step: u64,
    /// Inner training history
    pub inner_history: TrainingHistory,
    /// Meta (outer) loss history
    pub meta_losses: Vec<f64>,
    /// Per-schedule loss contributions
    pub lr_loss_history: Vec<f64>,
    pub distill_loss_history: Vec<f64>,
    pub prune_loss_history: Vec<f64>,
    pub quant_loss_history: Vec<f64>,
    pub curriculum_loss_history: Vec<f64>,
    /// Best schedules found
    pub best_schedules: LearnedSchedules,
    /// Best meta loss
    pub best_meta_loss: f64,
    /// Convergence flag
    pub converged: bool,
}

impl MetaState {
    pub fn new() -> MetaState {
        MetaState {
            meta_step: 0,
            inner_step: 0,
            inner_history: TrainingHistory::new(),
            meta_losses: Vec::new(),
            lr_loss_history: Vec::new(),
            distill_loss_history: Vec::new(),
            prune_loss_history: Vec::new(),
            quant_loss_history: Vec::new(),
            curriculum_loss_history: Vec::new(),
            best_schedules: LearnedSchedules::new(),
            best_meta_loss: f64::MAX,
            converged: false,
        }
    }

    pub fn update_best(&mut self, loss: f64, schedules: &LearnedSchedules) -> bool {
        if loss < self.best_meta_loss {
            self.best_meta_loss = loss;
            self.best_schedules = schedules.clone();
            true
        } else {
            false
        }
    }

    /// Check if meta-loss has converged
    pub fn check_convergence(&mut self, threshold: f64, window: usize) -> bool {
        if self.meta_losses.len() < window * 2 {
            return false;
        }
        let n = self.meta_losses.len();
        let old_start = n - window * 2;
        let old_end = n - window;

        var old_avg = 0.0;
        for i in old_start..old_end {
            old_avg = old_avg + self.meta_losses[i];
        }
        old_avg = old_avg / (window as f64);

        var new_avg = 0.0;
        for i in old_end..n {
            new_avg = new_avg + self.meta_losses[i];
        }
        new_avg = new_avg / (window as f64);

        let improvement = (old_avg - new_avg).abs();
        self.converged = improvement < threshold;
        self.converged
    }

    /// Get improvement rate (last window vs previous window)
    pub fn improvement_rate(&self, window: usize) -> f64 {
        if self.meta_losses.len() < window * 2 {
            return f64::MAX;
        }
        let n = self.meta_losses.len();
        var old_avg = 0.0;
        for i in (n - window * 2)..(n - window) {
            old_avg = old_avg + self.meta_losses[i];
        }
        old_avg = old_avg / (window as f64);

        var new_avg = 0.0;
        for i in (n - window)..n {
            new_avg = new_avg + self.meta_losses[i];
        }
        new_avg = new_avg / (window as f64);

        if old_avg > 0.0 {
            (old_avg - new_avg) / old_avg
        } else {
            0.0
        }
    }
}

impl Default for MetaState {
    fn default() -> MetaState {
        MetaState::new()
    }
}

// =============================================================================
// Meta-Trainer: Full Orchestration
// =============================================================================

/// Meta-trainer for learning optimal schedules across all dimensions.
///
/// Orchestrates nested optimization:
/// 1. Inner loop: train model with current schedules
/// 2. Outer loop: compute meta-loss on validation, extract gradients, update schedules
///
/// Integrates all 5 learnable schedule types:
/// - LearnableLRSchedule: learning rate warmup, decay, plateau detection
/// - LearnableDistillation: knowledge distillation temperature and mixing
/// - LearnablePruning: progressive sparsity with importance scoring
/// - LearnableQuantization: bit-width reduction with STE
/// - LearnableCurriculum: task ordering and multi-task mixing
pub struct MetaTrainer {
    /// Configuration
    pub config: MetaConfig,
    /// Learnable schedules (all 5 types)
    pub schedules: LearnedSchedules,
    /// Meta-optimizer for gradient updates
    pub optimizer: MetaOptimizer,
    /// Training state
    pub state: MetaState,
    /// Early stopping
    pub early_stopping: EarlyStopping,
}

impl MetaTrainer {
    /// Create new meta trainer
    pub fn new(config: MetaConfig) -> MetaTrainer {
        let patience = config.patience;
        let meta_lr = config.meta_lr;
        let grad_clip = config.grad_clip;
        let num_specialists = config.num_specialists;

        MetaTrainer {
            config,
            schedules: LearnedSchedules::with_curriculum(num_specialists),
            optimizer: MetaOptimizer::new(meta_lr, grad_clip),
            state: MetaState::new(),
            early_stopping: EarlyStopping::new(patience, 1e-5),
        }
    }

    /// Create with custom schedules
    pub fn with_schedules(config: MetaConfig, schedules: LearnedSchedules) -> MetaTrainer {
        let patience = config.patience;
        let meta_lr = config.meta_lr;
        let grad_clip = config.grad_clip;

        MetaTrainer {
            config,
            schedules,
            optimizer: MetaOptimizer::new(meta_lr, grad_clip),
            state: MetaState::new(),
            early_stopping: EarlyStopping::new(patience, 1e-5),
        }
    }

    /// Run inner training loop, returns validation loss
    ///
    /// This simulates training with current schedules.
    /// In practice, this would call the actual model training.
    pub fn inner_loop<F>(&mut self, mut train_step: F) -> dual
    where
        F: FnMut(u64, f64) -> dual,  // (step, lr) -> loss
    {
        // Reset inner history
        self.state.inner_history = TrainingHistory::new();

        for i in 0..self.config.inner_steps {
            // Get current learning rate from schedule
            let step = dual::constant(i as f64);
            let lr = self.schedules.learning_rate(step,
                self.state.inner_history.losses.as_slice());

            // Perform training step
            let loss = train_step(i, lr.val);

            // Record
            let result = StepResult::new(loss, i, lr.val);
            self.state.inner_history.record(&result);
            self.state.inner_step = self.state.inner_step + 1;

            // Update curriculum progress
            if self.config.enable_curriculum {
                let total = self.config.inner_steps;
                self.schedules.curriculum.set_progress(i as f64 / total as f64);
                self.schedules.curriculum.advance(total);
            }
        }

        // Return final loss as validation proxy
        let final_loss = if self.state.inner_history.losses.len() > 0 {
            self.state.inner_history.moving_average(10)
        } else {
            0.0
        };

        dual::variable(final_loss)
    }

    /// Run inner loop with curriculum-aware task selection
    pub fn inner_loop_curriculum<F>(
        &mut self,
        mut train_step: F,
    ) -> dual
    where
        F: FnMut(u64, f64, usize) -> dual,  // (step, lr, task_idx) -> loss
    {
        self.state.inner_history = TrainingHistory::new();
        let num_tasks = self.schedules.curriculum.num_specialists;

        for i in 0..self.config.inner_steps {
            let step = dual::constant(i as f64);
            let lr = self.schedules.learning_rate(step,
                self.state.inner_history.losses.as_slice());

            // Select task based on curriculum ordering
            let ordering = self.schedules.curriculum.specialist_ordering();
            let active = self.schedules.curriculum.active_tasks();

            // Round-robin through active tasks
            let task_idx = if !active.is_empty() {
                active[(i as usize) % active.len()]
            } else if !ordering.is_empty() {
                ordering[0]
            } else {
                0
            };

            // Train on selected task
            let loss = train_step(i, lr.val, task_idx);

            // Record task performance
            self.schedules.curriculum.record_task_step(task_idx, loss.val);

            let result = StepResult::new(loss, i, lr.val);
            self.state.inner_history.record(&result);
            self.state.inner_step = self.state.inner_step + 1;

            // Update curriculum progress
            self.schedules.curriculum.set_progress(i as f64 / self.config.inner_steps as f64);
        }

        let final_loss = if self.state.inner_history.losses.len() > 0 {
            self.state.inner_history.moving_average(10)
        } else {
            0.0
        };

        dual::variable(final_loss)
    }

    /// Compute meta loss from validation result
    pub fn meta_loss(&self, val_loss: dual) -> MetaLoss {
        if self.config.enable_curriculum {
            // Include curriculum cost: penalize inactive tasks not being used
            let curriculum_summary = self.schedules.curriculum.summary();
            let unused_penalty = dual::constant(
                (self.schedules.curriculum.num_specialists - curriculum_summary.active_tasks) as f64
                * 0.01
            );
            MetaLoss::with_curriculum(
                val_loss, &self.schedules, self.config.schedule_reg, unused_penalty
            )
        } else {
            MetaLoss::new(val_loss, &self.schedules, self.config.schedule_reg)
        }
    }

    /// Meta gradient step using the optimizer
    pub fn meta_step(&mut self, grad: &SchedulesGradient) {
        self.optimizer.step(&mut self.schedules, grad);
        self.state.meta_step = self.state.meta_step + 1;
    }

    /// Meta gradient step with selective schedule updates
    pub fn meta_step_selective(&mut self, grad: &SchedulesGradient) {
        self.optimizer.step_selective(
            &mut self.schedules,
            grad,
            true,  // always update LR
            self.config.enable_distillation,
            self.config.enable_pruning,
            self.config.enable_quantization,
            self.config.enable_curriculum,
        );
        self.state.meta_step = self.state.meta_step + 1;
    }

    /// Run full meta-optimization
    ///
    /// train_step: closure that performs one inner training step
    /// val_fn: closure that computes validation loss
    pub fn optimize<F, V>(&mut self, mut train_step: F, mut val_fn: V) -> LearnedSchedules
    where
        F: FnMut(u64, f64) -> dual,  // (step, lr) -> train_loss
        V: FnMut(&LearnedSchedules) -> f64,  // schedules -> val_loss
    {
        for m in 0..self.config.meta_steps {
            // Inner loop: train with current schedules
            let inner_loss = self.inner_loop(&mut train_step);

            // Compute validation loss
            let val_loss_val = val_fn(&self.schedules);
            let val_loss = dual::variable(val_loss_val);

            // Compute meta loss
            let meta_loss = self.meta_loss(val_loss);
            self.state.meta_losses.push(meta_loss.total.val);

            // Track per-schedule losses
            self.state.lr_loss_history.push(inner_loss.val);
            self.state.distill_loss_history.push(meta_loss.reg_loss.val);
            self.state.curriculum_loss_history.push(meta_loss.curriculum_loss.val);

            // Update best
            self.state.update_best(meta_loss.total.val, &self.schedules);

            // Extract gradient and update with selective control
            let grad = self.schedules.gradient();
            self.meta_step_selective(&grad);

            // Convergence check
            if self.state.check_convergence(self.config.convergence_threshold, 5) {
                break;
            }

            // Early stopping check
            if self.early_stopping.check(meta_loss.total.val) {
                break;
            }
        }

        // Return best schedules found
        self.state.best_schedules.clone()
    }

    /// Run full meta-optimization with curriculum-aware inner loop
    pub fn optimize_curriculum<F, V>(
        &mut self,
        mut train_step: F,
        mut val_fn: V,
    ) -> LearnedSchedules
    where
        F: FnMut(u64, f64, usize) -> dual,  // (step, lr, task_idx) -> train_loss
        V: FnMut(&LearnedSchedules) -> f64,  // schedules -> val_loss
    {
        for m in 0..self.config.meta_steps {
            // Inner loop with curriculum task selection
            let inner_loss = self.inner_loop_curriculum(&mut train_step);

            // Validation
            let val_loss_val = val_fn(&self.schedules);
            let val_loss = dual::variable(val_loss_val);

            // Meta loss with curriculum
            let meta_loss = self.meta_loss(val_loss);
            self.state.meta_losses.push(meta_loss.total.val);
            self.state.curriculum_loss_history.push(meta_loss.curriculum_loss.val);

            // Update best
            self.state.update_best(meta_loss.total.val, &self.schedules);

            // Extract gradient and update
            let grad = self.schedules.gradient();
            self.meta_step_selective(&grad);

            // Convergence check
            if self.state.check_convergence(self.config.convergence_threshold, 5) {
                break;
            }

            if self.early_stopping.check(meta_loss.total.val) {
                break;
            }
        }

        self.state.best_schedules.clone()
    }

    /// Get current learning rate
    pub fn current_lr(&self, step: u64) -> f64 {
        let s = dual::constant(step as f64);
        self.schedules.learning_rate(s,
            self.state.inner_history.losses.as_slice()).val
    }

    /// Get current temperature for distillation
    pub fn current_temperature(&self, step: u64) -> f64 {
        let s = dual::constant(step as f64);
        self.schedules.distill_temperature(s).val
    }

    /// Get current sparsity target
    pub fn current_sparsity(&self, step: u64) -> f64 {
        let s = dual::constant(step as f64);
        self.schedules.sparsity(s).val
    }

    /// Get current quantization bits
    pub fn current_bits(&self, step: u64) -> f64 {
        let s = dual::constant(step as f64);
        self.schedules.bits(s).val
    }

    /// Get current curriculum ordering
    pub fn current_ordering(&self) -> Vec<usize> {
        self.schedules.curriculum.specialist_ordering()
    }

    /// Get active curriculum tasks
    pub fn active_tasks(&self) -> Vec<usize> {
        self.schedules.curriculum.active_tasks()
    }

    /// Get meta-optimizer diagnostics
    pub fn diagnostics(&self) -> MetaDiagnostics {
        MetaDiagnostics {
            meta_steps: self.state.meta_step,
            inner_steps: self.state.inner_step,
            best_meta_loss: self.state.best_meta_loss,
            current_meta_loss: self.state.meta_losses.last().copied().unwrap_or(f64::MAX),
            avg_grad_norm: self.optimizer.avg_grad_norm(),
            converged: self.state.converged,
            lr_updates: self.optimizer.lr_updates,
            distill_updates: self.optimizer.distill_updates,
            prune_updates: self.optimizer.prune_updates,
            quant_updates: self.optimizer.quant_updates,
            curriculum_updates: self.optimizer.curriculum_updates,
            improvement_rate: self.state.improvement_rate(5),
        }
    }

    /// Check if meta-training has converged
    pub fn has_converged(&self) -> bool {
        self.state.converged
    }

    /// Get the number of meta-loss history entries
    pub fn meta_loss_count(&self) -> usize {
        self.state.meta_losses.len()
    }

    /// Check if meta-loss is decreasing over time
    pub fn is_improving(&self) -> bool {
        self.state.improvement_rate(5) > 0.0
    }
}

impl Default for MetaTrainer {
    fn default() -> MetaTrainer {
        MetaTrainer::new(MetaConfig::default())
    }
}

// =============================================================================
// Meta Diagnostics
// =============================================================================

/// Diagnostic information about meta-training progress
#[derive(Clone)]
pub struct MetaDiagnostics {
    /// Total meta steps completed
    pub meta_steps: u64,
    /// Total inner steps completed
    pub inner_steps: u64,
    /// Best meta loss achieved
    pub best_meta_loss: f64,
    /// Current (most recent) meta loss
    pub current_meta_loss: f64,
    /// Average gradient norm
    pub avg_grad_norm: f64,
    /// Whether training has converged
    pub converged: bool,
    /// Per-schedule update counts
    pub lr_updates: u64,
    pub distill_updates: u64,
    pub prune_updates: u64,
    pub quant_updates: u64,
    pub curriculum_updates: u64,
    /// Recent improvement rate
    pub improvement_rate: f64,
}
