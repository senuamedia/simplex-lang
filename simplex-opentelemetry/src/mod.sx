// =============================================================================
// Public API - Module Exports
// =============================================================================

pub mod span;
pub mod context;
pub mod exporter;
pub mod processor;
pub mod trace_id;
pub mod instrumentation;

// =============================================================================
// Span Status Constants
// =============================================================================

// Span status codes (OpenTelemetry StatusCode)
// Use functions instead of const

/// Span status: Unset (default, no status set)
pub fn SPAN_UNSET() -> i64 { 0 }

/// Span status: OK (operation completed successfully)
pub fn SPAN_OK() -> i64 { 1 }

/// Span status: Error (operation failed)
pub fn SPAN_ERROR() -> i64 { 2 }

// =============================================================================
// Span Kind Constants
// =============================================================================

/// Internal span (default)
pub fn SPAN_INTERNAL() -> i64 { 0 }

/// Server span (incoming request)
pub fn SPAN_SERVER() -> i64 { 1 }

/// Client span (outgoing request)
pub fn SPAN_CLIENT() -> i64 { 2 }

/// Producer span (message producer)
pub fn SPAN_PRODUCER() -> i64 { 3 }

/// Consumer span (message consumer)
pub fn SPAN_CONSUMER() -> i64 { 4 }

// =============================================================================
// Common Extern Declarations
// =============================================================================

extern fn vec_new() -> i64;
extern fn vec_push(v: i64, val: i64) -> i64;
extern fn vec_get(v: i64, idx: i64) -> i64;
extern fn vec_set(v: i64, idx: i64, val: i64) -> i64;
extern fn vec_len(v: i64) -> i64;
extern fn string_concat(a: i64, b: i64) -> i64;
extern fn string_from(s: &str) -> i64;
extern fn i64_to_string(n: i64) -> i64;
extern fn intrinsic_string_eq(a: i64, b: i64) -> i64;
extern fn time_now() -> i64;
extern fn time_now_ms() -> i64;
extern fn print_i64(n: i64) -> i64;
extern fn string_length(s: i64) -> i64;
extern fn string_char_at(s: i64, idx: i64) -> i64;
extern fn string_substring(s: i64, start: i64, len: i64) -> i64;
