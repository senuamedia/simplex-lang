// simplex-opentelemetry - OpenTelemetry Distributed Tracing for Simplex
//
// Provides W3C-compatible distributed tracing, including span creation,
// context propagation, batch processing, and multiple export formats.
//
// # Modules
//
// - `span`: Span creation, attributes, events, and status
// - `context`: W3C Trace Context propagation (traceparent header)
// - `exporter`: Stdout and JSON span exporters
// - `processor`: Batch span processor with buffering
// - `trace_id`: Trace ID and span ID generation
// - `instrumentation`: Auto-instrumentation helpers for actors and SLM
//
// # Example
//
// ```simplex
// use simplex_opentelemetry::span::*;
// use simplex_opentelemetry::context::*;
// use simplex_opentelemetry::exporter::*;
//
// fn main() {
//     let trace_id = otel_generate_trace_id();
//     let span = otel_start_span("my-operation", trace_id, 0);
//     otel_set_attribute(span, "http.method", "GET");
//     otel_add_event(span, "processing started");
//     otel_set_status(span, SPAN_OK());
//     otel_end_span(span);
//     otel_export_stdout(span);
// }
// ```
//
// Copyright (c) 2025-2026 Rod Higgins
