// simplex-opentelemetry::trace_id - Trace and Span ID Generation
//
// Generates unique identifiers for traces and spans:
// - Trace IDs: 128-bit (stored as two i64 values: high and low)
// - Span IDs: 64-bit (stored as a single i64 value)
//
// Uses a combination of timestamp and pseudo-random hashing to produce
// unique IDs without requiring external random number generators.
//
// # Example
//
// ```simplex
// let trace = otel_generate_trace_id();
// let trace_hi = otel_trace_id_hi(trace);
// let trace_lo = otel_trace_id_lo(trace);
// let span_id = otel_generate_span_id();
// ```
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

extern fn vec_new() -> i64;
extern fn vec_push(v: i64, val: i64) -> i64;
extern fn vec_get(v: i64, idx: i64) -> i64;
extern fn vec_set(v: i64, idx: i64, val: i64) -> i64;
extern fn time_now_ms() -> i64;
extern fn time_now() -> i64;

// =============================================================================
// Internal State
// =============================================================================

/// Counter for ensuring uniqueness within the same millisecond.
static mut ID_COUNTER: i64 = 0;

/// Previous timestamp for detecting same-millisecond generation.
static mut LAST_TIMESTAMP: i64 = 0;

// =============================================================================
// Hash Functions
// =============================================================================

/// A simple hash mixing function (based on splitmix64).
///
/// Produces a well-distributed 64-bit value from an input.
///
/// # Arguments
/// - `x`: Input value
///
/// # Returns
/// Hashed value
fn hash_mix(x: i64) -> i64 {
    let x: i64 = x + 5765437489386523;
    let x: i64 = x ^ (x / 65536);
    let x: i64 = x * 2654435761;
    let x: i64 = x ^ (x / 8192);
    let x: i64 = x * 2246822519;
    let x: i64 = x ^ (x / 32768);
    // Ensure positive
    if x < 0 {
        let x: i64 = 0 - x;
    }
    x
}

/// Combine two values into a hash.
///
/// # Arguments
/// - `a`: First value
/// - `b`: Second value
///
/// # Returns
/// Combined hash value
fn hash_combine(a: i64, b: i64) -> i64 {
    let h: i64 = hash_mix(a);
    let h: i64 = h ^ (hash_mix(b) * 2654435761);
    if h < 0 {
        let h: i64 = 0 - h;
    }
    h
}

// =============================================================================
// Trace ID Generation
// =============================================================================

/// Generate a new 128-bit trace ID.
///
/// Returns a vec with two elements: [high_bits, low_bits]
///
/// The trace ID is generated from:
/// - Current timestamp (milliseconds)
/// - A monotonic counter
/// - Hash mixing for distribution
///
/// # Returns
/// Vec handle with [trace_id_hi, trace_id_lo]
pub fn otel_generate_trace_id() -> i64 {
    let now: i64 = time_now_ms();

    unsafe {
        if now == LAST_TIMESTAMP {
            ID_COUNTER = ID_COUNTER + 1;
        } else {
            ID_COUNTER = 0;
            LAST_TIMESTAMP = now;
        }
        let counter: i64 = ID_COUNTER;

        let hi: i64 = hash_combine(now, counter);
        let lo: i64 = hash_combine(counter + 1, now * 7 + 13);

        let trace: i64 = vec_new();
        vec_push(trace, hi);
        vec_push(trace, lo);
        trace
    }
}

/// Get the high bits of a generated trace ID.
///
/// # Arguments
/// - `trace`: Trace ID vec from otel_generate_trace_id()
///
/// # Returns
/// High 64 bits of trace ID
pub fn otel_trace_id_hi(trace: i64) -> i64 {
    vec_get(trace, 0)
}

/// Get the low bits of a generated trace ID.
///
/// # Arguments
/// - `trace`: Trace ID vec from otel_generate_trace_id()
///
/// # Returns
/// Low 64 bits of trace ID
pub fn otel_trace_id_lo(trace: i64) -> i64 {
    vec_get(trace, 1)
}

// =============================================================================
// Span ID Generation
// =============================================================================

/// Generate a new 64-bit span ID.
///
/// The span ID is generated from:
/// - Current timestamp
/// - Monotonic counter
/// - Hash mixing
///
/// # Returns
/// 64-bit span ID (i64)
pub fn otel_generate_span_id() -> i64 {
    let now: i64 = time_now_ms();

    unsafe {
        ID_COUNTER = ID_COUNTER + 1;
        let counter: i64 = ID_COUNTER;

        let sid: i64 = hash_combine(now, counter * 31 + 17);
        sid
    }
}

// =============================================================================
// ID Formatting
// =============================================================================

/// Format a trace ID as a 32-character hex string.
///
/// Combines the high and low bits into a single hex string.
///
/// # Arguments
/// - `trace`: Trace ID vec [hi, lo]
///
/// # Returns
/// 32-character hex string handle
pub fn otel_trace_id_hex(trace: i64) -> i64 {
    let hi: i64 = vec_get(trace, 0);
    let lo: i64 = vec_get(trace, 1);
    let hex_hi: i64 = i64_to_hex_16(hi);
    let hex_lo: i64 = i64_to_hex_16(lo);
    string_concat(hex_hi, hex_lo)
}

/// Format a span ID as a 16-character hex string.
///
/// # Arguments
/// - `span_id`: 64-bit span ID
///
/// # Returns
/// 16-character hex string handle
pub fn otel_span_id_hex(span_id: i64) -> i64 {
    i64_to_hex_16(span_id)
}

// =============================================================================
// Internal Hex Conversion
// =============================================================================

extern fn string_concat(a: i64, b: i64) -> i64;

/// Convert a nibble (0-15) to a hex character string.
fn nibble_hex(n: i64) -> i64 {
    if n == 0 { return "0"; }
    if n == 1 { return "1"; }
    if n == 2 { return "2"; }
    if n == 3 { return "3"; }
    if n == 4 { return "4"; }
    if n == 5 { return "5"; }
    if n == 6 { return "6"; }
    if n == 7 { return "7"; }
    if n == 8 { return "8"; }
    if n == 9 { return "9"; }
    if n == 10 { return "a"; }
    if n == 11 { return "b"; }
    if n == 12 { return "c"; }
    if n == 13 { return "d"; }
    if n == 14 { return "e"; }
    if n == 15 { return "f"; }
    "0"
}

/// Convert an i64 to a 16-character hex string.
fn i64_to_hex_16(value: i64) -> i64 {
    let v: i64 = value;
    if v < 0 {
        let v: i64 = 0 - v;
    }

    // Extract 16 nibbles into a vec (LSB first)
    let digits: i64 = vec_new();
    let i: i64 = 0;
    loop {
        if i >= 16 {
            break;
        }
        let nibble: i64 = v % 16;
        vec_push(digits, nibble);
        let v: i64 = v / 16;
        let i: i64 = i + 1;
    }

    // Build string in reverse (MSB first)
    let result: i64 = "";
    let i: i64 = 15;
    loop {
        if i < 0 {
            break;
        }
        let nibble: i64 = vec_get(digits, i);
        let result: i64 = string_concat(result, nibble_hex(nibble));
        let i: i64 = i - 1;
    }

    result
}
