// =============================================================================
// Helper Functions
// =============================================================================

/// Extract a string array from a RedisValue::Array
fn extract_string_array(value: &RedisValue) -> Result<Vec<String>, RedisError> {
    match value {
        RedisValue::Array(items) => {
            var result: Vec<String> = Vec::new();
            let mut i: i64 = 0;
            while i < items.len() as i64 {
                match &items[i] {
                    RedisValue::BulkString(s) => result.push(s.clone()),
                    RedisValue::SimpleString(s) => result.push(s.clone()),
                    RedisValue::Integer(n) => result.push(n.to_string()),
                    RedisValue::Null => result.push("".to_string()),
                    _ => result.push("".to_string()),
                }
                i = i + 1;
            }
            Ok(result)
        },
        RedisValue::Null => Ok(Vec::new()),
        _ => Ok(Vec::new()),
    }
}
// simplex-redis/pubsub - Publish/Subscribe Messaging
//
// Implements Redis pub/sub functionality. A connection in subscription
// mode can only receive messages and manage subscriptions -- it cannot
// execute regular commands.
//
// # Usage
//
// ```simplex
// // Publisher
// redis_publish(&mut conn, "events", "user_signup")?;
//
// // Subscriber
// redis_subscribe(&mut sub_conn, "events")?;
// loop {
//     let msg = redis_recv_message(&mut sub_conn)?;
//     println(format!("Channel: {}, Message: {}", msg.channel, msg.data));
// }
// ```
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

use crate::connection::{RedisConnection, redis_raw_command};
use crate::protocol::{
    RedisValue, RedisError, encode_command, decode_response,
};

// =============================================================================
// Pub/Sub Message
// =============================================================================

/// A message received from a subscription
pub struct PubSubMessage {
    /// Message type: "message", "subscribe", "unsubscribe"
    pub kind: String,
    /// Channel name
    pub channel: String,
    /// Message data (for "message" type) or subscription count (as string)
    pub data: String,
}

// =============================================================================
// Subscribe/Unsubscribe
// =============================================================================

/// Subscribe to one or more channels
///
/// Puts the connection into subscription mode. The connection
/// can only be used for pub/sub operations after this call.
///
/// # Arguments
/// * `conn` - Redis connection (will be put into subscribed state)
/// * `channel` - Channel name to subscribe to
pub fn redis_subscribe(
    conn: &mut RedisConnection,
    channel: &str,
) -> Result<(), RedisError> {
    let cmd = encode_command(&["SUBSCRIBE", channel]);
    tcp_send(conn.stream_handle, &cmd);

    let data = tcp_recv(conn.stream_handle, 4096);
    if data.is_empty() {
        return Err(RedisError::Connection("no response to SUBSCRIBE".to_string()));
    }

    let (value, _) = decode_response(&data, 0);
    match &value {
        RedisValue::Array(items) => {
            // Expect ["subscribe", channel, count]
            if items.len() >= 1 {
                conn.state = 2; // subscribed
                Ok(())
            } else {
                Err(RedisError::Protocol("unexpected SUBSCRIBE response".to_string()))
            }
        },
        RedisValue::Error(e) => Err(RedisError::Server(e.clone())),
        _ => {
            conn.state = 2;
            Ok(())
        },
    }
}

/// Subscribe to multiple channels at once
pub fn redis_subscribe_multi(
    conn: &mut RedisConnection,
    channels: &[&str],
) -> Result<(), RedisError> {
    var args: Vec<&str> = Vec::new();
    args.push("SUBSCRIBE");
    let mut i: i64 = 0;
    while i < channels.len() as i64 {
        args.push(channels[i]);
        i = i + 1;
    }

    let cmd = encode_command(&args);
    tcp_send(conn.stream_handle, &cmd);

    // Read subscription confirmations
    i = 0;
    while i < channels.len() as i64 {
        let data = tcp_recv(conn.stream_handle, 4096);
        if data.is_empty() {
            return Err(RedisError::Connection("lost connection during SUBSCRIBE".to_string()));
        }
        i = i + 1;
    }

    conn.state = 2;
    Ok(())
}

/// Unsubscribe from a channel
pub fn redis_unsubscribe(
    conn: &mut RedisConnection,
    channel: &str,
) -> Result<(), RedisError> {
    if !conn.is_subscribed() {
        return Err(RedisError::Command("not in subscription mode".to_string()));
    }

    let cmd = encode_command(&["UNSUBSCRIBE", channel]);
    tcp_send(conn.stream_handle, &cmd);

    let data = tcp_recv(conn.stream_handle, 4096);
    if data.is_empty() {
        return Err(RedisError::Connection("no response to UNSUBSCRIBE".to_string()));
    }

    let (value, _) = decode_response(&data, 0);
    match &value {
        RedisValue::Array(items) => {
            // Check remaining subscription count
            if items.len() >= 3 {
                if let Some(count) = items[2].as_int() {
                    if count == 0 {
                        conn.state = 1; // back to ready mode
                    }
                }
            }
        },
        _ => {},
    }

    Ok(())
}

/// Unsubscribe from all channels
pub fn redis_unsubscribe_all(conn: &mut RedisConnection) -> Result<(), RedisError> {
    if !conn.is_subscribed() {
        return Err(RedisError::Command("not in subscription mode".to_string()));
    }

    let cmd = encode_command(&["UNSUBSCRIBE"]);
    tcp_send(conn.stream_handle, &cmd);

    let data = tcp_recv(conn.stream_handle, 4096);
    conn.state = 1; // back to ready
    Ok(())
}

// =============================================================================
// Publish
// =============================================================================

/// Publish a message to a channel
///
/// Can be called from any connection (does not need to be subscribed).
///
/// # Arguments
/// * `conn` - Redis connection
/// * `channel` - Channel to publish to
/// * `message` - Message content
///
/// Returns the number of subscribers that received the message.
pub fn redis_publish(
    conn: &mut RedisConnection,
    channel: &str,
    message: &str,
) -> Result<i64, RedisError> {
    let result = redis_raw_command(conn, &["PUBLISH", channel, message])?;
    match result {
        RedisValue::Integer(n) => Ok(n),
        RedisValue::Error(e) => Err(RedisError::Server(e)),
        _ => Ok(0),
    }
}

// =============================================================================
// Receive Messages
// =============================================================================

/// Receive the next pub/sub message
///
/// Blocks until a message is received. The connection must be
/// in subscribed mode (after calling redis_subscribe).
///
/// # Arguments
/// * `conn` - Subscribed Redis connection
pub fn redis_recv_message(conn: &mut RedisConnection) -> Result<PubSubMessage, RedisError> {
    if !conn.is_subscribed() {
        return Err(RedisError::Command("not in subscription mode".to_string()));
    }

    let data = tcp_recv(conn.stream_handle, 65536);
    if data.is_empty() {
        conn.state = 3; // failed
        return Err(RedisError::Connection("connection lost".to_string()));
    }

    let (value, _) = decode_response(&data, 0);
    parse_pubsub_message(&value)
}

/// Parse a pub/sub message from a RedisValue
fn parse_pubsub_message(value: &RedisValue) -> Result<PubSubMessage, RedisError> {
    match value {
        RedisValue::Array(items) => {
            if items.len() < 3 {
                return Err(RedisError::Protocol("invalid pub/sub message".to_string()));
            }

            let kind = match &items[0] {
                RedisValue::BulkString(s) => s.clone(),
                RedisValue::SimpleString(s) => s.clone(),
                _ => "unknown".to_string(),
            };

            let channel = match &items[1] {
                RedisValue::BulkString(s) => s.clone(),
                RedisValue::SimpleString(s) => s.clone(),
                _ => "".to_string(),
            };

            let data = match &items[2] {
                RedisValue::BulkString(s) => s.clone(),
                RedisValue::SimpleString(s) => s.clone(),
                RedisValue::Integer(n) => n.to_string(),
                _ => "".to_string(),
            };

            Ok(PubSubMessage { kind, channel, data })
        },
        _ => Err(RedisError::Protocol("expected array for pub/sub message".to_string())),
    }
}

// =============================================================================
// TCP Helpers
// =============================================================================

fn tcp_send(handle: i64, data: &[i64]) {
    unsafe { net_tcp_send(handle, data.as_ptr(), data.len() as i64) }
}

fn tcp_recv(handle: i64, max_len: i64) -> Vec<i64> {
    var buf: Vec<i64> = Vec::with_capacity(max_len);
    let n = unsafe { net_tcp_recv(handle, buf.as_mut_ptr(), max_len) };
    if n > 0 {
        unsafe { buf.set_len(n as i64) };
    }
    buf
}

extern fn net_tcp_send(handle: i64, data: i64, len: i64) -> i64;
extern fn net_tcp_recv(handle: i64, buf: i64, max_len: i64) -> i64;
// simplex-redis/pipeline - Command Pipelining
//
// Allows batching multiple Redis commands into a single network
// round-trip. Commands are buffered locally and sent together,
// then all responses are read and returned.
//
// Pipelining can dramatically improve throughput when executing
// many commands in sequence.
//
// # Usage
//
// ```simplex
// let mut pipe = pipeline_new();
// pipeline_add(&mut pipe, &["SET", "a", "1"]);
// pipeline_add(&mut pipe, &["SET", "b", "2"]);
// pipeline_add(&mut pipe, &["GET", "a"]);
// pipeline_add(&mut pipe, &["GET", "b"]);
// let results = pipeline_execute(&mut conn, &pipe)?;
// // results[2] == RedisValue::BulkString("1")
// // results[3] == RedisValue::BulkString("2")
// ```
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

use crate::connection::RedisConnection;
use crate::protocol::{
    RedisValue, RedisError, encode_command, encode_commands, decode_response,
};

// =============================================================================
// Pipeline
// =============================================================================

/// A batch of Redis commands to execute in a single round-trip
pub struct RedisPipeline {
    /// Buffered commands (each is a vec of argument strings)
    pub commands: Vec<Vec<String>>,
}

/// Create a new empty pipeline
pub fn pipeline_new() -> RedisPipeline {
    RedisPipeline {
        commands: Vec::new(),
    }
}

/// Add a command to the pipeline
///
/// # Arguments
/// * `pipe` - The pipeline to add to
/// * `args` - Command arguments (e.g., ["SET", "key", "value"])
pub fn pipeline_add(pipe: &mut RedisPipeline, args: &[&str]) {
    var cmd: Vec<String> = Vec::new();
    let mut i: i64 = 0;
    while i < args.len() as i64 {
        cmd.push(args[i].to_string());
        i = i + 1;
    }
    pipe.commands.push(cmd);
}

/// Get the number of commands in the pipeline
pub fn pipeline_len(pipe: &RedisPipeline) -> i64 {
    pipe.commands.len() as i64
}

/// Clear all commands from the pipeline
pub fn pipeline_clear(pipe: &mut RedisPipeline) {
    pipe.commands.clear();
}

/// Execute all commands in the pipeline
///
/// Sends all commands in a single write, then reads all responses.
/// Returns a vector of RedisValue results, one per command.
///
/// # Arguments
/// * `conn` - Active Redis connection
/// * `pipe` - Pipeline containing commands to execute
pub fn pipeline_execute(
    conn: &mut RedisConnection,
    pipe: &RedisPipeline,
) -> Result<Vec<RedisValue>, RedisError> {
    if !conn.is_ready() {
        return Err(RedisError::Connection("connection not ready".to_string()));
    }

    if pipe.commands.is_empty() {
        return Ok(Vec::new());
    }

    // Encode all commands into a single buffer
    let encoded = encode_commands(&pipe.commands);
    tcp_send(conn.stream_handle, &encoded);

    // Read all responses
    var results: Vec<RedisValue> = Vec::new();
    let num_commands = pipe.commands.len() as i64;
    var responses_read: i64 = 0;

    // Read data in chunks until we have all responses
    var buffer: Vec<i64> = Vec::new();
    var buf_offset: i64 = 0;

    while responses_read < num_commands {
        // Read more data from socket
        let data = tcp_recv(conn.stream_handle, 65536);
        if data.is_empty() {
            conn.state = 3;
            return Err(RedisError::Connection("connection lost during pipeline".to_string()));
        }

        // Append to buffer
        let mut i: i64 = 0;
        while i < data.len() as i64 {
            buffer.push(data[i]);
            i = i + 1;
        }

        // Parse as many responses as possible from the buffer
        while responses_read < num_commands && buf_offset < buffer.len() as i64 {
            let (value, consumed) = decode_response(&buffer, buf_offset);
            if consumed == 0 {
                break; // Need more data
            }
            results.push(value);
            buf_offset = buf_offset + consumed;
            responses_read = responses_read + 1;
        }
    }

    Ok(results)
}

/// Execute a pipeline and return only the last result
///
/// Useful for pipelines where only the final command's result matters
/// (e.g., a series of SETs followed by a GET).
pub fn pipeline_execute_last(
    conn: &mut RedisConnection,
    pipe: &RedisPipeline,
) -> Result<RedisValue, RedisError> {
    let results = pipeline_execute(conn, pipe)?;
    if results.is_empty() {
        Ok(RedisValue::Null)
    } else {
        let last_idx = results.len() - 1;
        Ok(results[last_idx].clone())
    }
}

// =============================================================================
// Convenience Builders
// =============================================================================

impl RedisPipeline {
    /// Add a GET command
    pub fn get(&mut self, key: &str) -> &mut Self {
        pipeline_add(self, &["GET", key]);
        self
    }

    /// Add a SET command
    pub fn set(&mut self, key: &str, value: &str) -> &mut Self {
        pipeline_add(self, &["SET", key, value]);
        self
    }

    /// Add a DEL command
    pub fn del(&mut self, key: &str) -> &mut Self {
        pipeline_add(self, &["DEL", key]);
        self
    }

    /// Add an INCR command
    pub fn incr(&mut self, key: &str) -> &mut Self {
        pipeline_add(self, &["INCR", key]);
        self
    }

    /// Add an HSET command
    pub fn hset(&mut self, key: &str, field: &str, value: &str) -> &mut Self {
        pipeline_add(self, &["HSET", key, field, value]);
        self
    }

    /// Add an HGET command
    pub fn hget(&mut self, key: &str, field: &str) -> &mut Self {
        pipeline_add(self, &["HGET", key, field]);
        self
    }

    /// Add an LPUSH command
    pub fn lpush(&mut self, key: &str, value: &str) -> &mut Self {
        pipeline_add(self, &["LPUSH", key, value]);
        self
    }

    /// Add an RPOP command
    pub fn rpop(&mut self, key: &str) -> &mut Self {
        pipeline_add(self, &["RPOP", key]);
        self
    }
}

// =============================================================================
// TCP Helpers
// =============================================================================

fn tcp_send(handle: i64, data: &[i64]) {
    unsafe { net_tcp_send(handle, data.as_ptr(), data.len() as i64) }
}

fn tcp_recv(handle: i64, max_len: i64) -> Vec<i64> {
    var buf: Vec<i64> = Vec::with_capacity(max_len);
    let n = unsafe { net_tcp_recv(handle, buf.as_mut_ptr(), max_len) };
    if n > 0 {
        unsafe { buf.set_len(n as i64) };
    }
    buf
}

extern fn net_tcp_send(handle: i64, data: i64, len: i64) -> i64;
extern fn net_tcp_recv(handle: i64, buf: i64, max_len: i64) -> i64;
