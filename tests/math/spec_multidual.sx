    } else {
        println("FAIL: test_hessian_cubic");
        failed = failed + 1;
    }

    // Test 9
    if test_dual2_product_rule() == 1 {
        println("PASS: test_dual2_product_rule");
        passed = passed + 1;
    } else {
        println("FAIL: test_dual2_product_rule");
        failed = failed + 1;
    }

    // Test 10
    if test_directional_derivative() == 1 {
        println("PASS: test_directional_derivative");
        passed = passed + 1;
    } else {
        println("FAIL: test_directional_derivative");
        failed = failed + 1;
    }

    // Test 11
    if test_gradient_descent_step() == 1 {
        println("PASS: test_gradient_descent_step");
        passed = passed + 1;
    } else {
        println("FAIL: test_gradient_descent_step");
        failed = failed + 1;
    }

    // Test 12
    if test_multidual_chain_rule() == 1 {
        println("PASS: test_multidual_chain_rule");
        passed = passed + 1;
    } else {
        println("FAIL: test_multidual_chain_rule");
        failed = failed + 1;
    }

    // Test 13
    if test_dual2_division() == 1 {
        println("PASS: test_dual2_division");
        passed = passed + 1;
    } else {
        println("FAIL: test_dual2_division");
        failed = failed + 1;
    }

    // Test 14
    if test_newton_minimize() == 1 {
        println("PASS: test_newton_minimize");
        passed = passed + 1;
    } else {
        println("FAIL: test_newton_minimize");
        failed = failed + 1;
    }

    println(format!("\nResults: {}/{} passed", passed, total));

    if failed > 0 { 1 } else { 0 }
}
