// Unit tests for belief guard parsing and compilation (TASK-013-A)
// Tests: confidence(), .derivative, comparisons, AND/OR combinations
// v0.13.0: Validates belief-gated receive syntax and codegen

// IEEE 754 bit patterns for f64 constants used as i64
// 0.0  = 0
// 0.3  = 4599075939470750515
// 0.5  = 4602678819172646912
// 0.6  = 4603579539098312499
// 0.7  = 4604480259023978086
// 0.8  = 4604930618986332314
// 0.85 = 4605155798967509428
// 0.9  = 4606281698874543309
// -0.1 = -4616189618054758400
// -0.15 = -4610842590788288205
// 0.1  = 4591870180066957722
// 0.05 = 4587366580439210842

fn main() -> i64 {
    let passed: i64 = 0;
    let failed: i64 = 0;
    print("=== Belief Guard Syntax Tests ===\n");

    // ===================================
    // Test 1: Basic confidence comparison
    // confidence(id) > 0.5
    // ===================================
    print("Test 1: Basic confidence > threshold... ");
    let name_a: i64 = make_sx_string("sensor_a");
    let conf_08_bits: i64 = 4604930618986332314;
    let zero_bits: i64 = 0;
    let r1: i64 = belief_register_i64(name_a, conf_08_bits, zero_bits);

    // Get confidence and compare (simulating codegen output)
    let conf_val: i64 = belief_guard_get_confidence(name_a);
    // The codegen emits: bitcast i64 to double, fcmp ogt, zext i1 to i64
    // At runtime level, we compare bit patterns directly
    // 0.8 > 0.5 should be true
    let conf_05_bits: i64 = 4602678819172646912;
    if conf_val > conf_05_bits {
        print("PASS\n");
        passed = passed + 1;
    } else {
        print("FAIL\n");
        failed = failed + 1;
    }

    // ===================================
    // Test 2: Confidence less-than comparison
    // confidence(id) < 0.9
    // ===================================
    print("Test 2: Confidence < threshold... ");
    let conf_09_bits: i64 = 4606281698874543309;
    // 0.8 < 0.9 should be true
    if conf_val < conf_09_bits {
        print("PASS\n");
        passed = passed + 1;
    } else {
        print("FAIL\n");
        failed = failed + 1;
    }

    // ===================================
    // Test 3: Derivative comparison
    // confidence(id).derivative > 0.0
    // ===================================
    print("Test 3: Derivative comparison... ");
    let name_b: i64 = make_sx_string("velocity");
    let conf_06_bits: i64 = 4603579539098312499;
    let der_pos_bits: i64 = 4591870180066957722;  // 0.1
    belief_register_i64(name_b, conf_06_bits, der_pos_bits);

    let der_val: i64 = belief_guard_get_derivative(name_b);
    // 0.1 > 0.0 should be true (positive derivative)
    if der_val > zero_bits {
        print("PASS\n");
        passed = passed + 1;
    } else {
        print("FAIL\n");
        failed = failed + 1;
    }

    // ===================================
    // Test 4: Negative derivative comparison
    // confidence(id).derivative < 0.0
    // ===================================
    print("Test 4: Negative derivative... ");
    let name_c: i64 = make_sx_string("obstacle");
    let der_neg_bits: i64 = -4610842590788288205;  // -0.15
    belief_register_i64(name_c, conf_08_bits, der_neg_bits);

    let der_neg: i64 = belief_guard_get_derivative(name_c);
    // -0.15 should be negative (derivative < 0)
    // Negative f64 bit patterns have the sign bit set (MSB=1), so as i64 they are negative
    if der_neg < zero_bits {
        print("PASS\n");
        passed = passed + 1;
    } else {
        print("FAIL\n");
        failed = failed + 1;
    }

    // ===================================
    // Test 5: AND combination
    // confidence(a) > 0.5 && confidence(b) > 0.3
    // ===================================
    print("Test 5: AND combination (both true)... ");
    let conf_a: i64 = belief_guard_get_confidence(name_a);  // 0.8
    let conf_b: i64 = belief_guard_get_confidence(name_b);  // 0.6
    let conf_03_bits: i64 = 4599075939470750515;  // 0.3

    let guard_a: i64 = 0;
    if conf_a > conf_05_bits { guard_a = 1; }
    let guard_b: i64 = 0;
    if conf_b > conf_03_bits { guard_b = 1; }

    // AND: both must be true
    if guard_a == 1 && guard_b == 1 {
        print("PASS\n");
        passed = passed + 1;
    } else {
        print("FAIL\n");
        failed = failed + 1;
    }

    // ===================================
    // Test 6: AND combination with one false
    // confidence(a) > 0.9 && confidence(b) > 0.3
    // (0.8 > 0.9 is false)
    // ===================================
    print("Test 6: AND combination (one false)... ");
    let guard_a2: i64 = 0;
    if conf_a > conf_09_bits { guard_a2 = 1; }

    if guard_a2 == 1 && guard_b == 1 {
        print("FAIL (AND should be false)\n");
        failed = failed + 1;
    } else {
        print("PASS\n");
        passed = passed + 1;
    }

    // ===================================
    // Test 7: OR combination
    // confidence(a) > 0.8 || confidence(b) > 0.8
    // (0.8 > 0.8 is false, 0.6 > 0.8 is false => false)
    // ===================================
    print("Test 7: OR combination (both false)... ");
    let guard_c: i64 = 0;
    // 0.8 > 0.8 is false (not strictly greater)
    // Use >= for edge: bit pattern equality means equal
    if conf_a > conf_08_bits { guard_c = 1; }
    let guard_d: i64 = 0;
    if conf_b > conf_08_bits { guard_d = 1; }

    if guard_c == 1 || guard_d == 1 {
        print("FAIL (OR should be false)\n");
        failed = failed + 1;
    } else {
        print("PASS\n");
        passed = passed + 1;
    }

    // ===================================
    // Test 8: OR combination (one true)
    // confidence(a) > 0.5 || confidence(b) > 0.8
    // (0.8 > 0.5 is true => OR is true)
    // ===================================
    print("Test 8: OR combination (one true)... ");
    let guard_e: i64 = 0;
    if conf_a > conf_05_bits { guard_e = 1; }
    let guard_f: i64 = 0;
    if conf_b > conf_08_bits { guard_f = 1; }

    if guard_e == 1 || guard_f == 1 {
        print("PASS\n");
        passed = passed + 1;
    } else {
        print("FAIL\n");
        failed = failed + 1;
    }

    // ===================================
    // Test 9: Nested combination
    // (confidence(a) > 0.5 && confidence(a).derivative > 0.0) || confidence(b) > 0.9
    // Inner AND: 0.8 > 0.5 is true, derivative of a is 0 => false
    // So AND is false. OR rhs: 0.6 > 0.9 is false
    // Overall: false
    // ===================================
    print("Test 9: Nested combination (all false)... ");
    let der_a: i64 = belief_guard_get_derivative(name_a);
    let guard_conf_a: i64 = 0;
    if conf_a > conf_05_bits { guard_conf_a = 1; }
    let guard_der_a: i64 = 0;
    if der_a > zero_bits { guard_der_a = 1; }
    let inner_and: i64 = 0;
    if guard_conf_a == 1 && guard_der_a == 1 { inner_and = 1; }

    let guard_b_high: i64 = 0;
    if conf_b > conf_09_bits { guard_b_high = 1; }

    if inner_and == 1 || guard_b_high == 1 {
        print("FAIL (nested should be false)\n");
        failed = failed + 1;
    } else {
        print("PASS\n");
        passed = passed + 1;
    }

    // ===================================
    // Test 10: Nested combination (true via derivative)
    // Register name_a with positive derivative, re-test
    // ===================================
    print("Test 10: Nested combination (true via AND)... ");
    let name_d: i64 = make_sx_string("accel");
    let conf_07_bits: i64 = 4604480259023978086;  // 0.7
    let der_005_bits: i64 = 4587366580439210842;  // 0.05
    belief_register_i64(name_d, conf_07_bits, der_005_bits);

    let conf_d: i64 = belief_guard_get_confidence(name_d);
    let der_d: i64 = belief_guard_get_derivative(name_d);

    let g_conf_d: i64 = 0;
    if conf_d > conf_05_bits { g_conf_d = 1; }
    let g_der_d: i64 = 0;
    if der_d > zero_bits { g_der_d = 1; }

    let nested_and: i64 = 0;
    if g_conf_d == 1 && g_der_d == 1 { nested_and = 1; }

    // (0.7 > 0.5 && 0.05 > 0.0) => true
    if nested_and == 1 {
        print("PASS\n");
        passed = passed + 1;
    } else {
        print("FAIL\n");
        failed = failed + 1;
    }

    // ===================================
    // Test 11: Short-circuit AND (left false, right not evaluated)
    // ===================================
    print("Test 11: Short-circuit AND semantics... ");
    // If left of AND is false, result is 0 regardless of right
    let left_false: i64 = 0;
    let right_any: i64 = 1;
    let sc_and: i64 = 0;
    if left_false == 1 && right_any == 1 { sc_and = 1; }
    if sc_and == 0 {
        print("PASS\n");
        passed = passed + 1;
    } else {
        print("FAIL\n");
        failed = failed + 1;
    }

    // ===================================
    // Test 12: Short-circuit OR (left true, right not evaluated)
    // ===================================
    print("Test 12: Short-circuit OR semantics... ");
    let left_true: i64 = 1;
    let right_any2: i64 = 0;
    let sc_or: i64 = 0;
    if left_true == 1 || right_any2 == 1 { sc_or = 1; }
    if sc_or == 1 {
        print("PASS\n");
        passed = passed + 1;
    } else {
        print("FAIL\n");
        failed = failed + 1;
    }

    // ===================================
    // Summary
    // ===================================
    print("\n=== Summary ===\n");
    print("Passed: ");
    print_i64(passed);
    print(" / ");
    print_i64(passed + failed);
    print("\n");

    if failed == 0 {
        print("All belief guard syntax tests passed!\n");
    }

    failed
}
