use equivariant;

fn main() -> i64 {
    println(string_from("=== Equivariant Neural Network Integration Test ==="));
    var failures: i64 = 0;

    // Test 1: 2D rotation matrix (angle = 0 should be identity-like)
    let angle_zero: i64 = f64_to_bits(0.0);
    let rot0: i64 = rotation_matrix_2d(angle_zero);
    let r00: i64 = vec_get(rot0, 0);
    // cos(0) = 1.0, so r00 should be f64_to_bits(1.0) or very close
    // For positive f64: bit pattern is ordered same as value
    if r00 < f64_to_bits(0.99) {
        println(string_from("FAIL: rot(0) [0,0] should be ~1"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: rotation_matrix_2d identity"));
    }

    // Test 2: Non-trivial rotation matrix
    // pi/2 ~ 1.5708
    let angle_90: i64 = f64_to_bits(1.5708);
    let rot90: i64 = rotation_matrix_2d(angle_90);
    // cos(pi/2) ~ 0, just check we get 4 elements
    if vec_len(rot90) != 4 {
        println(string_from("FAIL: rotation matrix should have 4 elements"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: rotation_matrix_2d pi/2"));
    }

    // Test 3: Invariant mean pooling
    let features: i64 = vec_new();
    // 2 vectors of dim 3
    vec_push(features, f64_to_bits(1.0));
    vec_push(features, f64_to_bits(2.0));
    vec_push(features, f64_to_bits(3.0));
    vec_push(features, f64_to_bits(4.0));
    vec_push(features, f64_to_bits(5.0));
    vec_push(features, f64_to_bits(6.0));
    let mean: i64 = invariant_mean(features, 2, 3);
    // mean[0] = (1+4)/2 = 2.5, should be > 2.4
    let m0: i64 = vec_get(mean, 0);
    if m0 < f64_to_bits(2.4) {
        println(string_from("FAIL: mean[0] should be ~2.5"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: invariant_mean"));
    }

    // Test 4: Permutation matrix
    let perm: i64 = vec_new();
    vec_push(perm, 1);
    vec_push(perm, 2);
    vec_push(perm, 0);
    let pmat: i64 = permutation_matrix(perm, 3);
    // 3x3 matrix should have 9 entries
    if vec_len(pmat) != 9 {
        println(string_from("FAIL: perm matrix should have 9 entries"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: permutation_matrix"));
    }

    if failures == 0 {
        println(string_from("All equivariant tests passed"));
    }
    failures
}
