// Forward-Mode Automatic Differentiation using Dual Numbers
// Tests dual number arithmetic for gradient computation
// v0.12.0: Validates learning/AD subsystem foundations

// ============================================
// Dual Number Representation
// ============================================
// A dual number (val, deriv) tracks both a value and its derivative.
// For a variable x: Dual(x, 1) means d/dx(x) = 1
// For a constant c: Dual(c, 0) means d/dx(c) = 0

struct Dual {
    val: i64,
    deriv: i64
}

impl Dual {
    fn new(val: i64, deriv: i64) -> Dual {
        Dual { val: val, deriv: deriv }
    }

    fn variable(val: i64) -> Dual {
        Dual { val: val, deriv: 1 }
    }

    fn constant(val: i64) -> Dual {
        Dual { val: val, deriv: 0 }
    }
}

// ============================================
// Dual Arithmetic Operations
// ============================================

fn dual_add(a: Dual, b: Dual) -> Dual {
    // d/dx(a + b) = a' + b'
    Dual { val: a.val + b.val, deriv: a.deriv + b.deriv }
}

fn dual_sub(a: Dual, b: Dual) -> Dual {
    // d/dx(a - b) = a' - b'
    Dual { val: a.val - b.val, deriv: a.deriv - b.deriv }
}

fn dual_mul(a: Dual, b: Dual) -> Dual {
    // Product rule: d/dx(a * b) = a' * b + a * b'
    Dual { val: a.val * b.val, deriv: a.deriv * b.val + a.val * b.deriv }
}

fn dual_scale(a: Dual, s: i64) -> Dual {
    // d/dx(s * a) = s * a'
    Dual { val: s * a.val, deriv: s * a.deriv }
}

fn dual_square(a: Dual) -> Dual {
    // d/dx(a^2) = 2 * a * a' (special case of product rule)
    dual_mul(a, a)
}

// ============================================
// Test 1: Basic Dual Number Creation
// ============================================

fn test_dual_creation() -> i64 {
    let x: Dual = Dual::variable(5);
    let c: Dual = Dual::constant(3);
    if x.val == 5 && x.deriv == 1 && c.val == 3 && c.deriv == 0 { 1 } else { 0 }
}

// ============================================
// Test 2: Dual Addition - d/dx(x + 3) = 1
// ============================================

fn test_dual_addition() -> i64 {
    let x: Dual = Dual::variable(5);      // (5, 1)
    let c: Dual = Dual::constant(3);      // (3, 0)
    let result: Dual = dual_add(x, c);    // (8, 1)
    if result.val == 8 && result.deriv == 1 { 1 } else { 0 }
}

// ============================================
// Test 3: Dual Multiplication (Product Rule)
// d/dx(x * x) at x=5 should give deriv=10 (2x)
// ============================================

fn test_dual_product_rule() -> i64 {
    let x: Dual = Dual::variable(5);           // (5, 1)
    let result: Dual = dual_mul(x, x);         // (25, 5+5=10)
    // d/dx(x^2) = 2x, at x=5: deriv = 10
    if result.val == 25 && result.deriv == 10 { 1 } else { 0 }
}

// ============================================
// Test 4: Dual Scaling - d/dx(3x) = 3
// ============================================

fn test_dual_scaling() -> i64 {
    let x: Dual = Dual::variable(7);
    let result: Dual = dual_scale(x, 3);
    // 3x at x=7: val=21, d/dx(3x)=3
    if result.val == 21 && result.deriv == 3 { 1 } else { 0 }
}

// ============================================
// Test 5: Chain Rule - d/dx(3x + 2)^2
// Let u = 3x + 2, then d/dx(u^2) = 2u * du/dx = 2(3x+2)*3
// At x=1: u=5, deriv = 2*5*3 = 30
// ============================================

fn test_chain_rule() -> i64 {
    let x: Dual = Dual::variable(1);           // (1, 1)
    let three_x: Dual = dual_scale(x, 3);      // (3, 3)
    let u: Dual = dual_add(three_x, Dual::constant(2));  // (5, 3)
    let result: Dual = dual_square(u);          // (25, 2*5*3=30)
    if result.val == 25 && result.deriv == 30 { 1 } else { 0 }
}

// ============================================
// Test 6: Polynomial - d/dx(x^2 + 3x + 2) = 2x + 3
// At x=4: val = 16+12+2 = 30, deriv = 8+3 = 11
// ============================================

fn test_polynomial_derivative() -> i64 {
    let x: Dual = Dual::variable(4);
    let x_sq: Dual = dual_square(x);                     // (16, 8)
    let three_x: Dual = dual_scale(x, 3);                // (12, 3)
    let two: Dual = Dual::constant(2);                    // (2, 0)
    let poly: Dual = dual_add(dual_add(x_sq, three_x), two);  // (30, 11)
    if poly.val == 30 && poly.deriv == 11 { 1 } else { 0 }
}

// ============================================
// Test 7: Dual Vector Operations (Tensor-like)
// ============================================

struct DualVec {
    data: Vec<i64>,
    size: i64
}

fn dual_vec_new(size: i64) -> DualVec {
    let data: Vec<i64> = Vec::new();
    DualVec { data: data, size: 0 }
}

fn dual_vec_push(dv: DualVec, d: Dual) -> DualVec {
    vec_push(dv.data, d.val);
    vec_push(dv.data, d.deriv);
    DualVec { data: dv.data, size: dv.size + 1 }
}

fn dual_vec_get(dv: DualVec, i: i64) -> Dual {
    let val: i64 = vec_get(dv.data, i * 2);
    let deriv: i64 = vec_get(dv.data, i * 2 + 1);
    Dual { val: val, deriv: deriv }
}

fn dual_vec_dot(a: DualVec, b: DualVec) -> Dual {
    let result: Dual = Dual::constant(0);
    let i: i64 = 0;
    while i < a.size {
        let ai: Dual = dual_vec_get(a, i);
        let bi: Dual = dual_vec_get(b, i);
        result = dual_add(result, dual_mul(ai, bi));
        i = i + 1;
    }
    result
}

fn test_dual_vector_ops() -> i64 {
    // dot product of [x, 2x] . [3, 1] at x=2
    // = x*3 + 2x*1 = 5x, at x=2: val=10, deriv=5
    let x: Dual = Dual::variable(2);
    let two_x: Dual = dual_scale(x, 2);

    let a: DualVec = dual_vec_new(0);
    let a: DualVec = dual_vec_push(a, x);
    let a: DualVec = dual_vec_push(a, two_x);

    let b: DualVec = dual_vec_new(0);
    let b: DualVec = dual_vec_push(b, Dual::constant(3));
    let b: DualVec = dual_vec_push(b, Dual::constant(1));

    let result: Dual = dual_vec_dot(a, b);
    if result.val == 10 && result.deriv == 5 { 1 } else { 0 }
}

// ============================================
// Test 8: Gradient Descent Step
// Minimize f(x) = x^2 - 6x + 10
// f'(x) = 2x - 6, minimum at x=3
// ============================================

fn eval_loss(x_val: i64) -> Dual {
    let x: Dual = Dual::variable(x_val);
    let x_sq: Dual = dual_square(x);
    let six_x: Dual = dual_scale(x, 6);
    let ten: Dual = Dual::constant(10);
    dual_add(dual_sub(x_sq, six_x), ten)
}

fn test_gradient_step() -> i64 {
    // At x=0: f(0) = 10, f'(0) = -6
    let loss0: Dual = eval_loss(0);
    // At x=3: f(3) = 9-18+10 = 1, f'(3) = 0
    let loss3: Dual = eval_loss(3);
    // At x=6: f(6) = 36-36+10 = 10, f'(6) = 6
    let loss6: Dual = eval_loss(6);

    if loss0.val == 10 && loss0.deriv == -6 &&
       loss3.val == 1 && loss3.deriv == 0 &&
       loss6.val == 10 && loss6.deriv == 6 { 1 } else { 0 }
}

fn main() -> i64 {
    let failed: i64 = 0;
    if test_dual_creation() == 0 { failed = failed + 1; }
    if test_dual_addition() == 0 { failed = failed + 1; }
    if test_dual_product_rule() == 0 { failed = failed + 1; }
    if test_dual_scaling() == 0 { failed = failed + 1; }
    if test_chain_rule() == 0 { failed = failed + 1; }
    if test_polynomial_derivative() == 0 { failed = failed + 1; }
    if test_dual_vector_ops() == 0 { failed = failed + 1; }
    if test_gradient_step() == 0 { failed = failed + 1; }
    failed
}
