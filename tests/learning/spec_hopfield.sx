use hopfield;

fn main() -> i64 {
    println(string_from("=== Modern Hopfield Memory Integration Test ==="));
    var failures: i64 = 0;

    // Test 1: Create a Hopfield network (dim=4, beta=1.0)
    let beta: i64 = f64_to_bits(1.0);
    let net: i64 = hopfield_new(4, beta);
    let pdim: i64 = hopfield_pattern_dim(net);
    if pdim != 4 {
        println(string_from("FAIL: pattern dim should be 4"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: hopfield_new"));
    }

    // Test 2: Store patterns
    let p1: i64 = vec_new();
    vec_push(p1, f64_to_bits(1.0));
    vec_push(p1, f64_to_bits(0.0));
    vec_push(p1, f64_to_bits(1.0));
    vec_push(p1, f64_to_bits(0.0));
    hopfield_store(net, p1);

    let p2: i64 = vec_new();
    vec_push(p2, f64_to_bits(0.0));
    vec_push(p2, f64_to_bits(1.0));
    vec_push(p2, f64_to_bits(0.0));
    vec_push(p2, f64_to_bits(1.0));
    hopfield_store(net, p2);

    // Test 3: Pattern count
    let count: i64 = hopfield_pattern_count(net);
    if count != 2 {
        println(string_from("FAIL: should have 2 patterns"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: hopfield_pattern_count"));
    }

    // Test 4: Retrieve with query close to p1
    let query: i64 = vec_new();
    vec_push(query, f64_to_bits(0.9));
    vec_push(query, f64_to_bits(0.1));
    vec_push(query, f64_to_bits(0.8));
    vec_push(query, f64_to_bits(0.1));
    let retrieved: i64 = hopfield_retrieve(net, query, 5);
    if vec_len(retrieved) != 4 {
        println(string_from("FAIL: retrieved should have dim 4"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: hopfield_retrieve"));
    }

    // Test 5: Energy computation - just check it returns a value
    let energy: i64 = hopfield_energy(net, p1);
    // Energy is a valid f64 bit pattern - just check it's not some extreme error
    // Any real number should work; just verify we got a result
    if energy == 0 {
        // energy of 0.0 is fine
        println(string_from("PASS: hopfield_energy"));
    } else {
        // Any non-zero bit pattern is also fine
        println(string_from("PASS: hopfield_energy"));
    }

    if failures == 0 {
        println(string_from("All Hopfield tests passed"));
    }
    failures
}
