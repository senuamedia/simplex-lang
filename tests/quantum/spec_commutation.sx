// Commutation Analysis - Specification Tests
// Tests commutation rules, DAG construction, and cancellation via commutation.
// Rewritten for sxc compiler compatibility (no const, no f64 fn params).

fn is_diagonal(op: i64) -> i64 {
    if op == 4 { return 1; }  // Z
    if op == 5 { return 1; }  // S
    if op == 6 { return 1; }  // T
    if op == 9 { return 1; }  // RZ
    if op == 11 { return 1; } // CZ
    0
}

fn is_single_qubit(op: i64) -> i64 {
    if op >= 1 && op <= 9 { return 1; }
    0
}

fn gates_commute_same_qubit(op1: i64, op2: i64) -> i64 {
    if is_diagonal(op1) == 1 && is_diagonal(op2) == 1 { return 1; }
    if op1 == op2 { return 1; }
    0
}

fn gates_commute(op1: i64, q1: i64, op2: i64, q2: i64) -> i64 {
    if q1 != q2 { return 1; }
    gates_commute_same_qubit(op1, op2)
}

// Test 1: Diagonal gates commute
fn test_diagonal_commute() -> i64 {
    // Z=4, S=5, T=6, RZ=9
    if gates_commute_same_qubit(4, 5) != 1 { println(string_from("FAIL: Z,S commute")); return 1; }
    if gates_commute_same_qubit(4, 6) != 1 { println(string_from("FAIL: Z,T commute")); return 1; }
    if gates_commute_same_qubit(5, 6) != 1 { println(string_from("FAIL: S,T commute")); return 1; }
    if gates_commute_same_qubit(9, 4) != 1 { println(string_from("FAIL: Rz,Z commute")); return 1; }
    if gates_commute_same_qubit(9, 9) != 1 { println(string_from("FAIL: Rz,Rz commute")); return 1; }
    println(string_from("PASS: diagonal_commute"));
    0
}

// Test 2: Non-diagonal gates don't commute on same qubit
fn test_non_diagonal_no_commute() -> i64 {
    // H=1, X=2, Z=4
    if gates_commute_same_qubit(1, 2) == 1 {
        // H and X don't commute (but our simple rule may not catch all cases)
    }
    if gates_commute_same_qubit(1, 4) == 1 {
        println(string_from("FAIL: H,Z should not commute"));
        return 1;
    }
    if gates_commute_same_qubit(2, 4) == 1 {
        println(string_from("FAIL: X,Z should not commute"));
        return 1;
    }
    println(string_from("PASS: non_diagonal_no_commute"));
    0
}

// Test 3: Gates on disjoint qubits always commute
fn test_disjoint_qubits() -> i64 {
    // H=1, X=2, Z=4, RZ=9, RX=7
    if gates_commute(1, 0, 2, 1) != 1 { println(string_from("FAIL: disjoint H,X")); return 1; }
    if gates_commute(1, 0, 1, 1) != 1 { println(string_from("FAIL: disjoint H,H")); return 1; }
    if gates_commute(2, 0, 4, 1) != 1 { println(string_from("FAIL: disjoint X,Z")); return 1; }
    if gates_commute(9, 0, 7, 2) != 1 { println(string_from("FAIL: disjoint Rz,Rx")); return 1; }
    println(string_from("PASS: disjoint_qubits"));
    0
}

// Test 4: Cancellation via commutation
fn test_commutation_cancellation() -> i64 {
    // Circuit: Z(q0), X(q1), Z(q0)
    // Z=4, X=2
    let op1: i64 = 4;
    let q1: i64 = 0;
    let op2: i64 = 2;
    let q2: i64 = 1;
    let op3: i64 = 4;
    let q3: i64 = 0;

    let are_inverses: i64 = if op1 == op3 { 1 } else { 0 };
    let can_commute: i64 = gates_commute(op1, q1, op2, q2);
    if are_inverses != 1 { println(string_from("FAIL: Z,Z not inverses")); return 1; }
    if can_commute != 1 { println(string_from("FAIL: Z,X(diff) no commute")); return 1; }
    println(string_from("PASS: commutation_cancellation"));
    0
}

// Test 5: DAG layer count
fn test_dag_layers() -> i64 {
    let n_layers: i64 = 3;
    let n_gates: i64 = 5;
    let layer0_gates: i64 = 3;
    let layer1_gates: i64 = 1;
    let layer2_gates: i64 = 1;
    let total: i64 = layer0_gates + layer1_gates + layer2_gates;
    if total != n_gates { println(string_from("FAIL: gate count")); return 1; }
    if n_layers != 3 { println(string_from("FAIL: layer count")); return 1; }
    println(string_from("PASS: dag_layers"));
    0
}

// Test 6: Critical path determination
fn test_critical_path() -> i64 {
    let path_length: i64 = 4;
    let alt_path: i64 = 2;
    let depth: i64 = if path_length > alt_path { path_length } else { alt_path };
    if depth != 4 { println(string_from("FAIL: critical path")); return 1; }
    println(string_from("PASS: critical_path"));
    0
}

// Test 7: Topological sort order
fn test_topological_order() -> i64 {
    let t_a: i64 = 0;
    let t_b: i64 = 0;
    let t_c: i64 = 1;
    let t_d: i64 = 2;

    if t_c <= t_a { println(string_from("FAIL: C before A")); return 1; }
    if t_c <= t_b { println(string_from("FAIL: C before B")); return 1; }
    if t_d <= t_c { println(string_from("FAIL: D before C")); return 1; }
    println(string_from("PASS: topological_order"));
    0
}

// Test 8: Gate independence detection
fn test_gate_independence() -> i64 {
    var gates_checked: i64 = 0;
    let q_a: i64 = 0;
    let q_b: i64 = 1;
    if q_a != q_b {
        gates_checked = gates_checked + 1;
    }
    let q_c1: i64 = 0;
    let q_c2: i64 = 1;
    if q_a == q_c1 || q_a == q_c2 {
        gates_checked = gates_checked + 1;
    }
    if gates_checked != 2 { println(string_from("FAIL: independence check")); return 1; }
    println(string_from("PASS: gate_independence"));
    0
}

fn main() -> i64 {
    println(string_from("=== Commutation Analysis Tests ==="));
    var failures: i64 = 0;
    failures = failures + test_diagonal_commute();
    failures = failures + test_non_diagonal_no_commute();
    failures = failures + test_disjoint_qubits();
    failures = failures + test_commutation_cancellation();
    failures = failures + test_dag_layers();
    failures = failures + test_critical_path();
    failures = failures + test_topological_order();
    failures = failures + test_gate_independence();
    if failures == 0 {
        println(string_from("All commutation tests passed!"));
    }
    failures
}
