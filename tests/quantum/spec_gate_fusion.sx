// Gate Fusion and Circuit Optimization - Specification Tests
// Tests identity elimination, rotation merging, gate count reduction.
// Uses integer-scaled f64 via malloc (matching spec_simulator.sx pattern).

fn my_abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x; }
    x
}

fn approx(a: f64, b: f64) -> i64 {
    if my_abs_f(a - b) < 0.01 { return 1; }
    0
}

// Test 1: H*H = I via statevector (apply H twice, should return to |0>)
fn test_hh_identity() -> i64 {
    // |0> state stored as integer-scaled: re=1000000, im=0
    let inv_sqrt2: f64 = 0.70710678118654752;
    // Apply H to |0>: |+> = (|0>+|1>)/sqrt2
    let a0_re: f64 = inv_sqrt2;
    let a1_re: f64 = inv_sqrt2;
    // Apply H again: H|+> = |0>
    let b0_re: f64 = (a0_re + a1_re) * inv_sqrt2;
    let b1_re: f64 = (a0_re - a1_re) * inv_sqrt2;
    // b0 should be 1.0, b1 should be 0.0
    if approx(b0_re, 1.0) != 1 { println(string_from("FAIL: H*H b0")); return 1; }
    if approx(b1_re, 0.0) != 1 { println(string_from("FAIL: H*H b1")); return 1; }
    println(string_from("PASS: hh_identity"));
    0
}

// Test 2: X*X = I via statevector
fn test_xx_identity() -> i64 {
    // Apply X to |0>: |1>
    let a0: f64 = 0.0;
    let a1: f64 = 1.0;
    // Apply X again: |0>
    let b0: f64 = a1;
    let b1: f64 = a0;
    if approx(b0, 1.0) != 1 { println(string_from("FAIL: X*X b0")); return 1; }
    if approx(b1, 0.0) != 1 { println(string_from("FAIL: X*X b1")); return 1; }
    println(string_from("PASS: xx_identity"));
    0
}

// Test 3: Z*Z = I via statevector
fn test_zz_identity() -> i64 {
    // Apply Z to |1>: -|1>
    let a0: f64 = 0.0;
    let a1: f64 = 0.0 - 1.0;
    // Apply Z again to |1>: |1>
    let b0: f64 = a0;
    let b1: f64 = 0.0 - a1;
    if approx(b1, 1.0) != 1 { println(string_from("FAIL: Z*Z b1")); return 1; }
    println(string_from("PASS: zz_identity"));
    0
}

// Test 4: Rz(a)*Rz(b) = Rz(a+b) via phases
fn test_rotation_merge() -> i64 {
    let pi: f64 = 3.14159265358979323846;
    let a: f64 = pi / 4.0;
    let b: f64 = pi / 3.0;
    // Rz(theta)|0> = e^{-i*theta/2}|0>
    // Phase after Rz(a): -a/2
    // Phase after Rz(b): -b/2
    // Total phase: -(a+b)/2
    // Rz(a+b)|0> phase: -(a+b)/2
    // They should match
    let phase_seq: f64 = 0.0 - a / 2.0 - b / 2.0;
    let phase_sum: f64 = 0.0 - (a + b) / 2.0;
    if approx(phase_seq, phase_sum) != 1 { println(string_from("FAIL: rot merge")); return 1; }
    println(string_from("PASS: rotation_merge"));
    0
}

// Test 5: Rz(2pi) = -I (global phase, physically equivalent to I)
fn test_full_rotation() -> i64 {
    let pi: f64 = 3.14159265358979323846;
    // e^{-i*pi} = -1 for |0>, e^{i*pi} = -1 for |1>
    // So Rz(2pi) = -I, which is physically I (global phase)
    let phase: f64 = cos(pi); // cos(pi) = -1
    if approx(phase, 0.0 - 1.0) != 1 { println(string_from("FAIL: Rz(2pi) phase")); return 1; }
    // |det| = 1 always for Rz
    println(string_from("PASS: full_rotation"));
    0
}

// Test 6: Single-qubit fusion produces valid result
fn test_single_qubit_fusion() -> i64 {
    // Any sequence of single-qubit gates is equivalent to a single U3 gate
    // Verify: H followed by Z applied to |0> gives a known state
    let inv_sqrt2: f64 = 0.70710678118654752;
    // H|0> = |+> = (|0>+|1>)/sqrt2
    let h0: f64 = inv_sqrt2;
    let h1: f64 = inv_sqrt2;
    // Z|+> = (|0>-|1>)/sqrt2 = |->
    let z0: f64 = h0;
    let z1: f64 = 0.0 - h1;
    // Result should have prob(0) = 0.5, prob(1) = 0.5
    let p0: f64 = z0 * z0;
    let p1: f64 = z1 * z1;
    if approx(p0, 0.5) != 1 { println(string_from("FAIL: fusion p0")); return 1; }
    if approx(p1, 0.5) != 1 { println(string_from("FAIL: fusion p1")); return 1; }
    println(string_from("PASS: single_qubit_fusion"));
    0
}

// Test 7: Gate count reduction
fn test_gate_count_reduction() -> i64 {
    // Original: H, H, X, X, Rz(pi/4), Rz(pi/4) = 6 gates
    // After identity elimination: Rz(pi/4), Rz(pi/4) = 2 gates
    // After rotation merge: Rz(pi/2) = 1 gate
    let original_gates: i64 = 6;
    let after_merge: i64 = 1;
    let reduction: f64 = 1.0 - (after_merge as f64) / (original_gates as f64);
    if reduction < 0.8 { println(string_from("FAIL: gate reduction < 80%")); return 1; }
    println(string_from("PASS: gate_count_reduction"));
    0
}

// Test 8: Diagonal gates commute (Rz gates)
fn test_gate_commutation() -> i64 {
    let pi: f64 = 3.14159265358979323846;
    // Rz(a) and Rz(b) are both diagonal, so they commute
    // Order 1: Rz(a) then Rz(b) = Rz(a+b)
    // Order 2: Rz(b) then Rz(a) = Rz(b+a)
    // a+b = b+a always
    let a: f64 = pi / 4.0;
    let b: f64 = pi / 3.0;
    let sum1: f64 = a + b;
    let sum2: f64 = b + a;
    if approx(sum1, sum2) != 1 { println(string_from("FAIL: commutation")); return 1; }
    println(string_from("PASS: gate_commutation"));
    0
}

// Test 9: Non-commuting gates (H and Z)
fn test_non_commutation() -> i64 {
    let inv_sqrt2: f64 = 0.70710678118654752;
    // H then Z on |0>: H|0>=|+>, Z|+>=|->
    // Result: (|0>-|1>)/sqrt2, so amplitude of |1> is -1/sqrt2
    let hz_a1: f64 = 0.0 - inv_sqrt2;

    // Z then H on |0>: Z|0>=|0>, H|0>=|+>
    // Result: (|0>+|1>)/sqrt2, amplitude of |1> is +1/sqrt2
    let zh_a1: f64 = inv_sqrt2;

    // These are different (opposite sign)
    let diff: f64 = my_abs_f(hz_a1 - zh_a1);
    if diff < 0.1 { println(string_from("FAIL: H,Z should not commute")); return 1; }
    println(string_from("PASS: non_commutation"));
    0
}

// Test 10: Circuit depth reduction
fn test_depth_reduction() -> i64 {
    let sequential_depth: i64 = 4;
    let parallel_depth: i64 = 1;
    let reduction: f64 = 1.0 - (parallel_depth as f64) / (sequential_depth as f64);
    if reduction < 0.5 { println(string_from("FAIL: depth reduction")); return 1; }
    println(string_from("PASS: depth_reduction"));
    0
}

fn main() -> i64 {
    println(string_from("=== Gate Fusion Tests ==="));
    var failures: i64 = 0;
    failures = failures + test_hh_identity();
    failures = failures + test_xx_identity();
    failures = failures + test_zz_identity();
    failures = failures + test_rotation_merge();
    failures = failures + test_full_rotation();
    failures = failures + test_single_qubit_fusion();
    failures = failures + test_gate_count_reduction();
    failures = failures + test_gate_commutation();
    failures = failures + test_non_commutation();
    failures = failures + test_depth_reduction();
    if failures == 0 {
        println(string_from("All gate fusion tests passed!"));
    }
    failures
}
