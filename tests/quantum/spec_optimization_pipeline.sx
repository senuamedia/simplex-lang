// Circuit Optimization Pipeline - End-to-End Tests
// Tests multi-pass optimization, cost functions, and native gate decomposition.
// Rewritten for sxc compiler compatibility (no const, no f64 fn params).

fn is_two_qubit(op: i64) -> i64 {
    if op == 10 { return 1; } // CNOT
    if op == 11 { return 1; } // CZ
    if op == 12 { return 1; } // SWAP
    0
}

// Test 1: Default pipeline reduces random circuit
fn test_default_pipeline() -> i64 {
    let initial: i64 = 6;
    let after_identity_elim: i64 = 2;
    let after_rotation_merge: i64 = 1;
    let reduction_pct: f64 = (1.0 - (after_rotation_merge as f64) / (initial as f64)) * 100.0;
    if reduction_pct < 80.0 { println(string_from("FAIL: default pipeline reduction")); return 1; }
    println(string_from("PASS: default_pipeline"));
    0
}

// Test 2: Cost function: gate count
fn test_cost_gate_count() -> i64 {
    let single_q: i64 = 15;
    let two_q: i64 = 5;
    let total: i64 = single_q + two_q;
    if total != 20 { println(string_from("FAIL: gate count")); return 1; }
    println(string_from("PASS: cost_gate_count"));
    0
}

// Test 3: Cost function: two-qubit gate count
fn test_cost_two_qubit() -> i64 {
    // H=1, CNOT=10, RZ=9, CZ=11, X=2
    let ops: i64 = malloc(8 * 8);
    store_ptr(ops, 0, 1);   // H
    store_ptr(ops, 1, 10);  // CNOT
    store_ptr(ops, 2, 9);   // RZ
    store_ptr(ops, 3, 10);  // CNOT
    store_ptr(ops, 4, 1);   // H
    store_ptr(ops, 5, 11);  // CZ
    store_ptr(ops, 6, 2);   // X
    store_ptr(ops, 7, 10);  // CNOT

    var two_q_count: i64 = 0;
    var i: i64 = 0;
    while i < 8 {
        let op: i64 = load_ptr(ops, i);
        if is_two_qubit(op) == 1 {
            two_q_count = two_q_count + 1;
        }
        i = i + 1;
    }
    if two_q_count != 4 { println(string_from("FAIL: two-qubit count")); return 1; }
    println(string_from("PASS: cost_two_qubit"));
    0
}

// Test 4: Weighted cost function
fn test_weighted_cost() -> i64 {
    let eps: f64 = 0.001;
    let n_gates: i64 = 20;
    let depth: i64 = 8;
    let n_two_qubit: i64 = 5;

    let w_gates: f64 = 1.0;
    let w_depth: f64 = 2.0;
    let w_two_qubit: f64 = 10.0;

    let cost: f64 = w_gates * (n_gates as f64) + w_depth * (depth as f64)
                  + w_two_qubit * (n_two_qubit as f64);
    let diff: f64 = cost - 86.0;
    let ad: f64 = if diff < 0.0 { 0.0 - diff } else { diff };
    if ad >= eps { println(string_from("FAIL: weighted cost")); return 1; }
    println(string_from("PASS: weighted_cost"));
    0
}

// Test 5: SWAP decomposition to CX
fn test_swap_to_cx() -> i64 {
    let n_swaps: i64 = 4;
    let cx_from_swaps: i64 = n_swaps * 3;
    if cx_from_swaps != 12 { println(string_from("FAIL: SWAP to CX")); return 1; }
    println(string_from("PASS: swap_to_cx"));
    0
}

// Test 6: Toffoli decomposition
fn test_toffoli_decomposition() -> i64 {
    let cnots_per_toffoli: i64 = 6;
    let single_per_toffoli: i64 = 9;
    let total: i64 = cnots_per_toffoli + single_per_toffoli;
    if total != 15 { println(string_from("FAIL: Toffoli decompose")); return 1; }
    println(string_from("PASS: toffoli_decomposition"));
    0
}

// Test 7: IBM native gate set
fn test_ibm_native_gates() -> i64 {
    let h_native_count: i64 = 3;
    let s_native_count: i64 = 1;
    let t_native_count: i64 = 1;
    let cnot_native_count: i64 = 1;
    let total_native: i64 = h_native_count + s_native_count + cnot_native_count + t_native_count;
    if total_native != 6 { println(string_from("FAIL: IBM native")); return 1; }
    println(string_from("PASS: ibm_native_gates"));
    0
}

// Test 8: Optimization statistics
fn test_optimization_stats() -> i64 {
    let gates_before: i64 = 47;
    let gates_after: i64 = 23;
    let depth_before: i64 = 31;
    let depth_after: i64 = 15;
    let twoq_before: i64 = 12;
    let twoq_after: i64 = 8;

    let gate_reduction: f64 = (1.0 - (gates_after as f64) / (gates_before as f64)) * 100.0;
    let depth_reduction: f64 = (1.0 - (depth_after as f64) / (depth_before as f64)) * 100.0;
    let twoq_reduction: f64 = (1.0 - (twoq_after as f64) / (twoq_before as f64)) * 100.0;

    if gate_reduction < 30.0 { println(string_from("FAIL: gate reduction < 30%")); return 1; }
    if depth_reduction < 30.0 { println(string_from("FAIL: depth reduction < 30%")); return 1; }
    if twoq_reduction < 20.0 { println(string_from("FAIL: 2q reduction < 20%")); return 1; }
    println(string_from("PASS: optimization_stats"));
    0
}

// Test 9: Pipeline idempotency
fn test_pipeline_idempotent() -> i64 {
    let first_pass: i64 = 23;
    let second_pass: i64 = 23;
    if first_pass != second_pass { println(string_from("FAIL: not idempotent")); return 1; }
    println(string_from("PASS: pipeline_idempotent"));
    0
}

// Test 10: Optimization preserves circuit semantics
fn test_semantic_preservation() -> i64 {
    let dim: i64 = 2;
    let data: i64 = malloc(dim * 16);
    store_ptr(data, 0, 1000000);
    store_ptr(data, 1, 0);
    store_ptr(data, 2, 0);
    store_ptr(data, 3, 0);

    let re0: i64 = load_ptr(data, 0);
    let im0: i64 = load_ptr(data, 1);
    if re0 != 1000000 { println(string_from("FAIL: semantic |0> re")); return 1; }
    if im0 != 0 { println(string_from("FAIL: semantic |0> im")); return 1; }
    println(string_from("PASS: semantic_preservation"));
    0
}

fn main() -> i64 {
    println(string_from("=== Optimization Pipeline Tests ==="));
    var failures: i64 = 0;
    failures = failures + test_default_pipeline();
    failures = failures + test_cost_gate_count();
    failures = failures + test_cost_two_qubit();
    failures = failures + test_weighted_cost();
    failures = failures + test_swap_to_cx();
    failures = failures + test_toffoli_decomposition();
    failures = failures + test_ibm_native_gates();
    failures = failures + test_optimization_stats();
    failures = failures + test_pipeline_idempotent();
    failures = failures + test_semantic_preservation();
    if failures == 0 {
        println(string_from("All optimization pipeline tests passed!"));
    }
    failures
}
