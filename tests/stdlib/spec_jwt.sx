use jwt;

fn main() -> i64 {
    println(string_from("=== JWT Library Integration Test ==="));
    var failures: i64 = 0;

    // Test 1: Create a payload and add claims
    let payload: i64 = jwt_payload_new();
    let p1: i64 = jwt_add_claim(payload, string_from("sub"), string_from("user42"));
    let p2: i64 = jwt_add_claim(p1, string_from("role"), string_from("admin"));

    // Test 2: Get claim back
    let sub: i64 = jwt_get_claim(p2, string_from("sub"));
    if string_eq(sub, string_from("user42")) != 1 {
        println(string_from("FAIL: sub claim"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: jwt_get_claim sub"));
    }

    // Test 3: Check claim count
    let count: i64 = jwt_claim_count(p2);
    if count != 2 {
        println(string_from("FAIL: claim count should be 2"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: jwt_claim_count"));
    }

    // Test 4: Encode to a JWT token string
    let token: i64 = jwt_encode(p2, string_from("secret-key"));
    let token_len: i64 = string_len(token);
    if token_len < 10 {
        println(string_from("FAIL: token too short"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: jwt_encode produces token"));
    }

    // Test 5: Verify the token
    let valid: i64 = jwt_verify(token, string_from("secret-key"));
    if valid != 1 {
        println(string_from("FAIL: token should verify"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: jwt_verify"));
    }

    // Test 6: Verify with wrong key fails
    let invalid: i64 = jwt_verify(token, string_from("wrong-key"));
    if invalid == 1 {
        println(string_from("FAIL: wrong key should not verify"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: jwt_verify wrong key rejected"));
    }

    if failures == 0 {
        println(string_from("All JWT tests passed"));
    }
    failures
}
