use oauth;

fn main() -> i64 {
    println(string_from("=== OAuth Library Integration Test ==="));
    var failures: i64 = 0;

    // Test 1: Create an OAuth config
    let config: i64 = oauth_config_new(
        string_from("my-client-id"),
        string_from("my-secret"),
        string_from("https://auth.example.com/authorize"),
        string_from("https://auth.example.com/token"),
        string_from("http://localhost:8080/callback")
    );

    // Test 2: Get client ID back
    let cid: i64 = oauth_client_id(config);
    if string_eq(cid, string_from("my-client-id")) != 1 {
        println(string_from("FAIL: client id mismatch"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: oauth_client_id"));
    }

    // Test 3: Add scopes
    let c2: i64 = oauth_add_scope(config, string_from("openid"));
    let c3: i64 = oauth_add_scope(c2, string_from("profile"));

    // Test 4: Generate auth URL
    let url: i64 = oauth_auth_url(c3, string_from("csrf-state-123"));
    let url_len: i64 = string_len(url);
    if url_len < 50 {
        println(string_from("FAIL: auth URL too short"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: oauth_auth_url produces URL"));
    }

    // Test 5: Get redirect URI
    let redir: i64 = oauth_redirect_uri(config);
    if string_eq(redir, string_from("http://localhost:8080/callback")) != 1 {
        println(string_from("FAIL: redirect uri mismatch"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: oauth_redirect_uri"));
    }

    // Test 6: URL encode helper
    let encoded: i64 = url_encode(string_from("hello world"));
    if string_eq(encoded, string_from("hello%20world")) != 1 {
        println(string_from("FAIL: url_encode space"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: url_encode"));
    }

    if failures == 0 {
        println(string_from("All OAuth tests passed"));
    }
    failures
}
