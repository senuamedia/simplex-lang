use csv;

fn main() -> i64 {
    println(string_from("=== CSV Library Integration Test ==="));
    var failures: i64 = 0;

    // Test 1: Parse simple CSV
    let input: i64 = string_from("name,age,city\nAlice,30,NYC\nBob,25,LA");
    let config: i64 = csv_config_new();
    let table: i64 = csv_parse(input, config);

    let rows: i64 = csv_row_count(table);
    if rows != 2 {
        println(string_from("FAIL: expected 2 data rows"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: row count"));
    }

    // Test 2: Get cell value
    let cell: i64 = csv_get_cell(table, 0, 0);
    if string_eq(cell, string_from("Alice")) != 1 {
        println(string_from("FAIL: first cell should be Alice"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: cell value"));
    }

    // Test 3: Get second row
    let cell2: i64 = csv_get_cell(table, 1, 2);
    if string_eq(cell2, string_from("LA")) != 1 {
        println(string_from("FAIL: row 2 col 2 should be LA"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: second row cell"));
    }

    // Test 4: Column count
    let cols: i64 = csv_col_count(table);
    if cols != 3 {
        println(string_from("FAIL: expected 3 columns"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: column count"));
    }

    // Test 5: Roundtrip - stringify then parse
    let output: i64 = csv_stringify(table, config);
    if string_len(output) < 10 {
        println(string_from("FAIL: stringify too short"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: csv stringify"));
    }

    if failures == 0 {
        println(string_from("All CSV integration tests passed!"));
    }
    failures
}
