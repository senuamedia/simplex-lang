use dotenv;

fn main() -> i64 {
    println(string_from("=== Dotenv Library Integration Test ==="));
    var failures: i64 = 0;

    // Test 1: Parse key=value pairs
    let content: i64 = string_from("HOST=localhost\nPORT=8080\nDEBUG=true");
    let entries: i64 = dotenv_parse(content);

    let host: i64 = dotenv_get(entries, string_from("HOST"));
    if string_eq(host, string_from("localhost")) != 1 {
        println(string_from("FAIL: HOST should be localhost"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: dotenv_get HOST"));
    }

    // Test 2: Get another value
    let port: i64 = dotenv_get(entries, string_from("PORT"));
    if string_eq(port, string_from("8080")) != 1 {
        println(string_from("FAIL: PORT should be 8080"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: dotenv_get PORT"));
    }

    // Test 3: Check entry count
    let count: i64 = dotenv_count(entries);
    if count != 3 {
        println(string_from("FAIL: should have 3 entries"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: dotenv_count"));
    }

    // Test 4: Check key existence
    let has_debug: i64 = dotenv_has(entries, string_from("DEBUG"));
    if has_debug != 1 {
        println(string_from("FAIL: should have DEBUG"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: dotenv_has"));
    }

    // Test 5: Missing key returns empty string
    let missing: i64 = dotenv_get(entries, string_from("MISSING"));
    if string_len(missing) != 0 {
        println(string_from("FAIL: missing key should return empty"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: dotenv_get missing key"));
    }

    if failures == 0 {
        println(string_from("All dotenv tests passed"));
    }
    failures
}
