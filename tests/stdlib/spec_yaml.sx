use yaml;

fn main() -> i64 {
    println(string_from("=== YAML Library Integration Test ==="));
    var failures: i64 = 0;

    // Test 1: Parse a simple YAML mapping
    let input: i64 = string_from("name: Alice\nage: 30\ncity: NYC");
    let doc: i64 = yaml_parse(input);
    if yaml_is_mapping(doc) != 1 {
        println(string_from("FAIL: doc should be a mapping"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: yaml_is_mapping"));
    }

    // Test 2: Get a value by key
    let name_node: i64 = yaml_get(doc, string_from("name"));
    let name_val: i64 = yaml_scalar_value(name_node);
    if string_eq(name_val, string_from("Alice")) != 1 {
        println(string_from("FAIL: name should be Alice"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: yaml_get name"));
    }

    // Test 3: Get another key
    let city_node: i64 = yaml_get(doc, string_from("city"));
    let city_val: i64 = yaml_scalar_value(city_node);
    if string_eq(city_val, string_from("NYC")) != 1 {
        println(string_from("FAIL: city should be NYC"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: yaml_get city"));
    }

    // Test 4: Parse a sequence
    let seq_input: i64 = string_from("items:\n  - alpha\n  - beta\n  - gamma");
    let seq_doc: i64 = yaml_parse(seq_input);
    let items_node: i64 = yaml_get(seq_doc, string_from("items"));
    if yaml_is_sequence(items_node) != 1 {
        println(string_from("FAIL: items should be a sequence"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: yaml_is_sequence"));
    }

    // Test 5: Get sequence element by index
    let first: i64 = yaml_get_index(items_node, 0);
    let first_val: i64 = yaml_scalar_value(first);
    if string_eq(first_val, string_from("alpha")) != 1 {
        println(string_from("FAIL: first item should be alpha"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: yaml_get_index"));
    }

    if failures == 0 {
        println(string_from("All YAML tests passed"));
    }
    failures
}
