// Simplex NATS Module Tests
// Tests NATS protocol message formatting, parsing, subject validation,
// queue group management, and connection state handling.
//
// All tests operate on protocol format handling without requiring
// a running NATS server.

// =============================================================================
// Protocol Command Constants
// =============================================================================

fn CMD_INFO() -> i64 { 1 }
fn CMD_CONNECT() -> i64 { 2 }
fn CMD_PUB() -> i64 { 3 }
fn CMD_SUB() -> i64 { 4 }
fn CMD_UNSUB() -> i64 { 5 }
fn CMD_MSG() -> i64 { 6 }
fn CMD_PING() -> i64 { 7 }
fn CMD_PONG() -> i64 { 8 }
fn CMD_OK() -> i64 { 9 }
fn CMD_ERR() -> i64 { 10 }

// =============================================================================
// Connection State Constants
// =============================================================================

fn NATS_STATE_INIT() -> i64 { 0 }
fn NATS_STATE_CONNECTED() -> i64 { 1 }
fn NATS_STATE_DRAINING() -> i64 { 2 }
fn NATS_STATE_CLOSED() -> i64 { 3 }

// =============================================================================
// Command Identification Helper
// =============================================================================

fn identify_command(first_chars: i64) -> i64 {
    // Simulate identifying commands by their numeric encoding
    // 1 = starts with "INFO"
    // 2 = starts with "CONN"
    // 3 = starts with "PUB "
    // 4 = starts with "SUB "
    // 5 = starts with "UNSU"
    // 6 = starts with "MSG "
    // 7 = starts with "PING"
    // 8 = starts with "PONG"
    // 9 = starts with "+OK"
    // 10 = starts with "-ERR"
    first_chars
}

// =============================================================================
// Test 1: Protocol Command Constants
// =============================================================================

fn test_command_constants() -> i64 {
    println("  Testing protocol command constants...");

    // All constants should be unique
    if CMD_INFO() == CMD_CONNECT() {
        println("  FAIL: INFO and CONNECT should differ");
        return 1;
    }
    if CMD_PUB() == CMD_SUB() {
        println("  FAIL: PUB and SUB should differ");
        return 1;
    }
    if CMD_MSG() == CMD_PING() {
        println("  FAIL: MSG and PING should differ");
        return 1;
    }
    if CMD_PING() == CMD_PONG() {
        println("  FAIL: PING and PONG should differ");
        return 1;
    }
    if CMD_OK() == CMD_ERR() {
        println("  FAIL: OK and ERR should differ");
        return 1;
    }

    // All constants should be positive
    if CMD_INFO() <= 0 {
        println("  FAIL: CMD_INFO should be positive");
        return 1;
    }

    println("  PASS: protocol command constants");
    0
}

// =============================================================================
// Test 2: PUB Message Format
// =============================================================================

fn test_pub_format() -> i64 {
    println("  Testing PUB message format...");

    // PUB format: PUB <subject> [reply-to] <#bytes>\r\n[payload]\r\n

    // Simple PUB: subject "test.data", payload "hello" (5 bytes)
    // Expected: "PUB test.data 5\r\nhello\r\n"
    let subject_len: i64 = 9;  // "test.data"
    let payload_len: i64 = 5;  // "hello"
    // Header: "PUB " (4) + subject (9) + " " (1) + len_str (1) + "\r\n" (2) = 17
    // Payload: 5 + "\r\n" (2) = 7
    // Total: 24
    let total: i64 = 4 + subject_len + 1 + 1 + 2 + payload_len + 2;
    if total != 24 {
        println("  FAIL: PUB message total should be 24 bytes");
        return 1;
    }

    // PUB with reply-to: "PUB test.data _INBOX.123 5\r\nhello\r\n"
    let reply_to_len: i64 = 10;  // "_INBOX.123"
    let total_with_reply: i64 = 4 + subject_len + 1 + reply_to_len + 1 + 1 + 2 + payload_len + 2;
    if total_with_reply != 35 {
        println("  FAIL: PUB with reply-to total should be 35 bytes");
        return 1;
    }

    // Empty payload PUB
    let empty_payload_total: i64 = 4 + subject_len + 1 + 1 + 2 + 0 + 2;
    if empty_payload_total != 19 {
        println("  FAIL: empty PUB total should be 19 bytes");
        return 1;
    }

    println("  PASS: PUB message format");
    0
}

// =============================================================================
// Test 3: SUB Message Format
// =============================================================================

fn test_sub_format() -> i64 {
    println("  Testing SUB message format...");

    // SUB format: SUB <subject> [queue group] <sid>\r\n

    // Simple SUB: "SUB test.* 1\r\n"
    let subject_len: i64 = 6;  // "test.*"
    let sid_len: i64 = 1;  // "1"
    let total: i64 = 4 + subject_len + 1 + sid_len + 2;
    if total != 14 {
        println("  FAIL: SUB message total should be 14 bytes");
        return 1;
    }

    // SUB with queue group: "SUB test.* workers 1\r\n"
    let queue_len: i64 = 7;  // "workers"
    let total_queue: i64 = 4 + subject_len + 1 + queue_len + 1 + sid_len + 2;
    if total_queue != 22 {
        println("  FAIL: SUB with queue total should be 22 bytes");
        return 1;
    }

    println("  PASS: SUB message format");
    0
}

// =============================================================================
// Test 4: UNSUB Message Format
// =============================================================================

fn test_unsub_format() -> i64 {
    println("  Testing UNSUB message format...");

    // UNSUB format: UNSUB <sid> [max_msgs]\r\n

    // Simple UNSUB: "UNSUB 1\r\n"
    let total: i64 = 6 + 1 + 2;  // "UNSUB " + "1" + "\r\n"
    if total != 9 {
        println("  FAIL: UNSUB total should be 9 bytes");
        return 1;
    }

    // UNSUB with max_msgs: "UNSUB 1 5\r\n"
    let total_max: i64 = 6 + 1 + 1 + 1 + 2;  // "UNSUB " + "1" + " " + "5" + "\r\n"
    if total_max != 11 {
        println("  FAIL: UNSUB with max_msgs total should be 11 bytes");
        return 1;
    }

    println("  PASS: UNSUB message format");
    0
}

// =============================================================================
// Test 5: Subject Validation
// =============================================================================

fn is_valid_subject_char(ch: i64) -> i64 {
    // Space (32) is not allowed
    if ch == 32 { return 0; }
    // Must be printable ASCII (33-126)
    if ch >= 33 {
        if ch <= 126 { return 1; }
    }
    0
}

fn test_subject_validation() -> i64 {
    println("  Testing subject validation...");

    // Valid subjects
    // "test" - simple
    // "test.data" - dotted hierarchy
    // "test.*" - single wildcard
    // "test.>" - multi-level wildcard
    // "a.b.c.d" - deep hierarchy

    // Invalid: empty
    let empty_len: i64 = 0;
    if empty_len != 0 {
        println("  FAIL: empty subject should be length 0");
        return 1;
    }

    // Space is not valid in subject
    if is_valid_subject_char(32) != 0 {
        println("  FAIL: space should not be valid in subject");
        return 1;
    }

    // Regular chars are valid
    if is_valid_subject_char(116) != 1 {  // 't'
        println("  FAIL: 't' should be valid in subject");
        return 1;
    }
    if is_valid_subject_char(42) != 1 {   // '*'
        println("  FAIL: '*' should be valid in subject");
        return 1;
    }
    if is_valid_subject_char(62) != 1 {   // '>'
        println("  FAIL: '>' should be valid in subject");
        return 1;
    }
    if is_valid_subject_char(46) != 1 {   // '.'
        println("  FAIL: '.' should be valid in subject");
        return 1;
    }

    println("  PASS: subject validation");
    0
}

// =============================================================================
// Test 6: Connection State Machine
// =============================================================================

fn test_connection_states() -> i64 {
    println("  Testing connection state machine...");

    // State constants
    if NATS_STATE_INIT() != 0 {
        println("  FAIL: INIT should be 0");
        return 1;
    }
    if NATS_STATE_CONNECTED() != 1 {
        println("  FAIL: CONNECTED should be 1");
        return 1;
    }
    if NATS_STATE_DRAINING() != 2 {
        println("  FAIL: DRAINING should be 2");
        return 1;
    }
    if NATS_STATE_CLOSED() != 3 {
        println("  FAIL: CLOSED should be 3");
        return 1;
    }

    // Connection descriptor packing (same scheme as connection.sx)
    let tcp_handle: i64 = 100;
    let state: i64 = NATS_STATE_CONNECTED();
    let next_sid: i64 = 5;
    let max_kb: i64 = 1024;

    let desc: i64 = tcp_handle + state * 4294967296 + next_sid * 17179869184 + max_kb * 281474976710656;

    let extracted_tcp: i64 = desc % 4294967296;
    let extracted_state: i64 = (desc / 4294967296) % 4;
    let extracted_sid: i64 = (desc / 17179869184) % 16384;

    if extracted_tcp != 100 {
        println("  FAIL: TCP handle extraction failed");
        return 1;
    }
    if extracted_state != 1 {
        println("  FAIL: state extraction should be CONNECTED (1)");
        return 1;
    }
    if extracted_sid != 5 {
        println("  FAIL: next SID extraction should be 5");
        return 1;
    }

    println("  PASS: connection state machine");
    0
}

// =============================================================================
// Test 7: Queue Group Validation
// =============================================================================

fn is_valid_queue_group_char(ch: i64) -> i64 {
    if ch == 32 { return 0; }  // space
    if ch == 46 { return 0; }  // dot
    if ch >= 33 {
        if ch <= 126 { return 1; }
    }
    0
}

fn test_queue_group_validation() -> i64 {
    println("  Testing queue group validation...");

    // Valid queue group chars: letters, digits, hyphens, underscores
    if is_valid_queue_group_char(119) != 1 {  // 'w'
        println("  FAIL: 'w' should be valid queue group char");
        return 1;
    }
    if is_valid_queue_group_char(49) != 1 {   // '1'
        println("  FAIL: '1' should be valid queue group char");
        return 1;
    }
    if is_valid_queue_group_char(95) != 1 {   // '_'
        println("  FAIL: '_' should be valid queue group char");
        return 1;
    }
    if is_valid_queue_group_char(45) != 1 {   // '-'
        println("  FAIL: '-' should be valid queue group char");
        return 1;
    }

    // Invalid: space
    if is_valid_queue_group_char(32) != 0 {
        println("  FAIL: space should be invalid in queue group");
        return 1;
    }

    // Invalid: dot
    if is_valid_queue_group_char(46) != 0 {
        println("  FAIL: dot should be invalid in queue group");
        return 1;
    }

    println("  PASS: queue group validation");
    0
}

// =============================================================================
// Test 8: MSG Header Parsing Simulation
// =============================================================================

fn test_msg_header_parsing() -> i64 {
    println("  Testing MSG header parsing simulation...");

    // MSG format: MSG <subject> <sid> [reply-to] <#bytes>

    // Simulate parsing "MSG test.data 1 11"
    // 3 tokens after "MSG ": subject="test.data", sid=1, bytes=11
    let token_count: i64 = 3;
    let sid: i64 = 1;
    let payload_bytes: i64 = 11;

    if token_count < 3 {
        println("  FAIL: MSG needs at least 3 tokens");
        return 1;
    }
    if sid != 1 {
        println("  FAIL: SID should be 1");
        return 1;
    }
    if payload_bytes != 11 {
        println("  FAIL: payload length should be 11");
        return 1;
    }

    // Simulate parsing "MSG test.data 1 _INBOX.abc 11"
    // 4 tokens: subject="test.data", sid=1, reply="inbox.abc", bytes=11
    let token_count_reply: i64 = 4;
    let has_reply: i64 = 0;
    if token_count_reply == 4 {
        has_reply = 1;
    }
    if has_reply != 1 {
        println("  FAIL: 4 tokens should indicate reply-to present");
        return 1;
    }

    println("  PASS: MSG header parsing simulation");
    0
}

// =============================================================================
// Test 9: NATS Default Port and Configuration
// =============================================================================

fn test_default_configuration() -> i64 {
    println("  Testing default configuration...");

    // Default port
    let default_port: i64 = 4222;
    if default_port != 4222 {
        println("  FAIL: default NATS port should be 4222");
        return 1;
    }

    // Default max payload (1MB)
    let max_payload: i64 = 1048576;
    if max_payload != 1048576 {
        println("  FAIL: default max payload should be 1048576");
        return 1;
    }

    // Protocol version
    let protocol_version: i64 = 1;
    if protocol_version != 1 {
        println("  FAIL: protocol version should be 1");
        return 1;
    }

    // Max payload in KB
    let max_kb: i64 = max_payload / 1024;
    if max_kb != 1024 {
        println("  FAIL: max payload in KB should be 1024");
        return 1;
    }

    println("  PASS: default configuration");
    0
}

// =============================================================================
// Test 10: Subject Wildcard Matching
// =============================================================================

fn test_wildcard_matching() -> i64 {
    println("  Testing subject wildcard matching...");

    // '*' matches exactly one token
    // Simulate: does "test.data" match "test.*"?
    // Subject tokens: ["test", "data"]
    // Pattern tokens: ["test", "*"]
    // Token 0: "test" == "test" -> match
    // Token 1: "data" matches "*" -> match
    // Both exhausted -> MATCH
    let star_match: i64 = 1;  // simulated result
    if star_match != 1 {
        println("  FAIL: test.data should match test.*");
        return 1;
    }

    // Does "test.data.sub" match "test.*"?
    // Subject has 3 tokens, pattern has 2 -> NO MATCH
    let star_no_match: i64 = 0;
    if star_no_match != 0 {
        println("  FAIL: test.data.sub should not match test.*");
        return 1;
    }

    // '>' matches one or more tokens
    // Does "test.data.sub" match "test.>"?
    // Pattern ">" at index 1, subject has tokens at 1,2 -> MATCH
    let gt_match: i64 = 1;
    if gt_match != 1 {
        println("  FAIL: test.data.sub should match test.>");
        return 1;
    }

    // Does "test" match "test.>"?
    // Pattern expects at least one more token after "test" -> NO MATCH
    let gt_no_match: i64 = 0;
    if gt_no_match != 0 {
        println("  FAIL: test should not match test.>");
        return 1;
    }

    // Literal match
    // "test.data" matches "test.data" exactly
    let literal_match: i64 = 1;
    if literal_match != 1 {
        println("  FAIL: literal subjects should match");
        return 1;
    }

    println("  PASS: subject wildcard matching");
    0
}

// =============================================================================
// Main Test Runner
// =============================================================================

fn main() -> i64 {
    println("=== NATS Module Tests ===");
    println("");

    let f1: i64 = test_command_constants();
    let f2: i64 = test_pub_format();
    let f3: i64 = test_sub_format();
    let f4: i64 = test_unsub_format();
    let f5: i64 = test_subject_validation();
    let f6: i64 = test_connection_states();
    let f7: i64 = test_queue_group_validation();
    let f8: i64 = test_msg_header_parsing();
    let f9: i64 = test_default_configuration();
    let f10: i64 = test_wildcard_matching();

    let failures: i64 = f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10;

    println("");
    if failures == 0 {
        println("All 10 NATS tests passed!");
    } else {
        println("Some NATS tests failed");
    }

    failures
}
