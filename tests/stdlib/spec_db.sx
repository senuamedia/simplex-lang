// Unified Database Connectivity Integration Tests
// Tests real functions from simplex-db/src/mod.sx via use import

use db;

fn test_config_creation() -> i64 {
    println("  Testing db_config_new/db_config_set/db_config_get...");
    let config: i64 = db_config_new(DRIVER_POSTGRES());
    db_config_set(config, "host", "localhost");
    db_config_set(config, "port", "5432");
    db_config_set(config, "database", "mydb");
    let driver: i64 = db_config_driver(config);
    if driver != DRIVER_POSTGRES() {
        println("  FAIL: driver should be POSTGRES");
        return 1;
    }
    let host: i64 = db_config_get(config, "host");
    if string_eq(host, "localhost") != 1 {
        println("  FAIL: host value");
        return 1;
    }
    let port: i64 = db_config_get(config, "port");
    if string_eq(port, "5432") != 1 {
        println("  FAIL: port value");
        return 1;
    }
    let missing: i64 = db_config_get(config, "nonexistent");
    if missing != 0 {
        println("  FAIL: missing key should return 0");
        return 1;
    }
    println("  PASS: db_config");
    0
}

fn test_connection_lifecycle() -> i64 {
    println("  Testing db_connect/db_is_connected/db_close...");
    let config: i64 = db_config_new(DRIVER_MYSQL());
    let conn: i64 = db_connect(config);
    if db_is_connected(conn) != 1 {
        println("  FAIL: should be connected after db_connect");
        return 1;
    }
    if db_driver(conn) != DRIVER_MYSQL() {
        println("  FAIL: driver mismatch");
        return 1;
    }
    db_close(conn);
    if db_is_connected(conn) != 0 {
        println("  FAIL: should be disconnected after db_close");
        return 1;
    }
    println("  PASS: connection lifecycle");
    0
}

fn test_transactions() -> i64 {
    println("  Testing db_begin/db_commit/db_rollback...");
    let config: i64 = db_config_new(DRIVER_SQLITE());
    let conn: i64 = db_connect(config);
    let begin_r: i64 = db_begin(conn);
    if begin_r != ERR_NONE() {
        println("  FAIL: begin should succeed");
        return 1;
    }
    if db_state(conn) != CONN_IN_TRANSACTION() {
        println("  FAIL: state should be IN_TRANSACTION");
        return 1;
    }
    let commit_r: i64 = db_commit(conn);
    if commit_r != ERR_NONE() {
        println("  FAIL: commit should succeed");
        return 1;
    }
    if db_state(conn) != CONN_CONNECTED() {
        println("  FAIL: state should be CONNECTED after commit");
        return 1;
    }
    // Begin again, then rollback
    db_begin(conn);
    let rb_r: i64 = db_rollback(conn);
    if rb_r != ERR_NONE() {
        println("  FAIL: rollback should succeed");
        return 1;
    }
    // Commit without transaction should fail
    let bad_commit: i64 = db_commit(conn);
    if bad_commit == ERR_NONE() {
        println("  FAIL: commit without transaction should fail");
        return 1;
    }
    println("  PASS: transactions");
    0
}

fn test_driver_info() -> i64 {
    println("  Testing db_driver_name/db_driver_is_sql/db_driver_is_nosql...");
    let pg_name: i64 = db_driver_name(DRIVER_POSTGRES());
    if string_eq(pg_name, "postgres") != 1 {
        println("  FAIL: postgres driver name");
        return 1;
    }
    if db_driver_is_sql(DRIVER_POSTGRES()) != 1 {
        println("  FAIL: postgres is SQL");
        return 1;
    }
    if db_driver_is_sql(DRIVER_MYSQL()) != 1 {
        println("  FAIL: mysql is SQL");
        return 1;
    }
    if db_driver_is_nosql(DRIVER_REDIS()) != 1 {
        println("  FAIL: redis is NoSQL");
        return 1;
    }
    if db_driver_is_sql(DRIVER_REDIS()) != 0 {
        println("  FAIL: redis is not SQL");
        return 1;
    }
    println("  PASS: driver info");
    0
}

fn test_connection_pool() -> i64 {
    println("  Testing db_pool_new/checkout/return/size...");
    let config: i64 = db_config_new(DRIVER_REDIS());
    let pool: i64 = db_pool_new(config, 10);
    if db_pool_size(pool) != 0 {
        println("  FAIL: empty pool should have size 0");
        return 1;
    }
    let conn1: i64 = db_pool_checkout(pool);
    if db_is_connected(conn1) != 1 {
        println("  FAIL: checked out conn should be connected");
        return 1;
    }
    if db_pool_size(pool) != 1 {
        println("  FAIL: pool should have 1 connection");
        return 1;
    }
    db_pool_return(pool, conn1);
    if db_pool_available(pool) != 1 {
        println("  FAIL: should have 1 available after return");
        return 1;
    }
    println("  PASS: connection pool");
    0
}

fn main() -> i64 {
    println("=== simplex-db Integration Tests ===");
    var failures: i64 = 0;
    failures = failures + test_config_creation();
    failures = failures + test_connection_lifecycle();
    failures = failures + test_transactions();
    failures = failures + test_driver_info();
    failures = failures + test_connection_pool();
    println("");
    if failures == 0 {
        println("All 5 simplex-db integration tests passed!");
    } else {
        println(string_concat("FAILED: ", string_concat(int_to_string(failures), " test(s) failed")));
    }
    failures
}
