fn test_object_key_override() -> i64 {
    println("  Testing object key override...");

    let obj: i64 = json_object_new();
    json_object_set(obj, "key", json_string("first"));
    json_object_set(obj, "key", json_string("second"));

    let val: i64 = json_get_sx(obj, "key");
    let val_str: i64 = json_as_string(val);
    if intrinsic_string_eq(val_str, "second") != 1 {
        println("  FAIL: overridden key should have value 'second'");
        return 1;
    }

    println("  PASS: object key override");
    0
}

// =============================================================================
// Test 15: Empty Structures
// =============================================================================

fn test_empty_structures() -> i64 {
    println("  Testing empty structures...");

    // Empty object
    let empty_obj: i64 = json_parse_simple("{}");
    if json_is_object(empty_obj) != 1 {
        println("  FAIL: should parse empty object");
        return 1;
    }
    if json_object_len(empty_obj) != 0 {
        println("  FAIL: empty object should have 0 keys");
        return 1;
    }

    // Empty array
    let empty_arr: i64 = json_parse_simple("[]");
    if json_is_array(empty_arr) != 1 {
        println("  FAIL: should parse empty array");
        return 1;
    }
    if json_array_len(empty_arr) != 0 {
        println("  FAIL: empty array should have 0 elements");
        return 1;
    }

    // Stringify empty structures
    let obj_str: i64 = json_stringify(json_object_new());
    if obj_str == 0 {
        println("  FAIL: stringify empty object should not be null");
        return 1;
    }

    let arr_str: i64 = json_stringify(json_array_new());
    if arr_str == 0 {
        println("  FAIL: stringify empty array should not be null");
        return 1;
    }

    println("  PASS: empty structures");
    0
}

// =============================================================================
// Test 16: Numeric Values
// =============================================================================

fn test_numeric_values() -> i64 {
    println("  Testing numeric values...");

    // Parse various numbers
    let pos: i64 = json_parse_simple("123");
    if json_as_i64(pos) != 123 {
        println("  FAIL: 123 should parse as 123");
        return 1;
    }

    let zero: i64 = json_parse_simple("0");
    if json_as_i64(zero) != 0 {
        println("  FAIL: 0 should parse as 0");
        return 1;
    }

    let neg: i64 = json_parse_simple("-42");
    if json_as_i64(neg) != -42 {
        println("  FAIL: -42 should parse as -42");
        return 1;
    }

    println("  PASS: numeric values");
    0
}

// =============================================================================
// Test 17: Parse String with Whitespace
// =============================================================================

fn test_whitespace_handling() -> i64 {
    println("  Testing whitespace handling...");

    let input: i64 = "  {  \"key\"  :  \"value\"  }  ";
    let obj: i64 = json_parse_simple(input);

    if json_is_object(obj) != 1 {
        println("  FAIL: should parse object with extra whitespace");
        return 1;
    }

    let val: i64 = json_get_sx(obj, "key");
    let val_str: i64 = json_as_string(val);
    if intrinsic_string_eq(val_str, "value") != 1 {
        println("  FAIL: value should be 'value' despite whitespace");
        return 1;
    }

    println("  PASS: whitespace handling");
    0
}

// =============================================================================
// Test 18: Complex Nested Structure
// =============================================================================

fn test_complex_structure() -> i64 {
    println("  Testing complex nested structure...");

    let input: i64 = "{\"users\": [{\"id\": 1, \"name\": \"Alice\"}, {\"id\": 2, \"name\": \"Bob\"}], \"count\": 2}";
    let obj: i64 = json_parse_simple(input);

    // Get count
    let count: i64 = json_get_sx(obj, "count");
    if json_as_i64(count) != 2 {
        println("  FAIL: count should be 2");
        return 1;
    }

    // Get users array
    let users: i64 = json_get_sx(obj, "users");
    if json_array_len(users) != 2 {
        println("  FAIL: users should have 2 entries");
        return 1;
    }

    // Get first user
    let user0: i64 = json_get_index(users, 0);
    let id0: i64 = json_get_sx(user0, "id");
    if json_as_i64(id0) != 1 {
        println("  FAIL: first user id should be 1");
        return 1;
    }

    let name0: i64 = json_get_sx(user0, "name");
    let name0_str: i64 = json_as_string(name0);
    if intrinsic_string_eq(name0_str, "Alice") != 1 {
        println("  FAIL: first user name should be 'Alice'");
        return 1;
    }

    // Get second user
    let user1: i64 = json_get_index(users, 1);
    let name1: i64 = json_get_sx(user1, "name");
    let name1_str: i64 = json_as_string(name1);
    if intrinsic_string_eq(name1_str, "Bob") != 1 {
        println("  FAIL: second user name should be 'Bob'");
        return 1;
    }

    println("  PASS: complex nested structure");
    0
}

// =============================================================================
// Main Test Runner
// =============================================================================

fn main() -> i64 {
    println("=== JSON Module Tests ===");
    println("");

    let f1: i64 = test_parse_simple_object();
    let f2: i64 = test_parse_nested();
    let f3: i64 = test_parse_all_types();
    let f4: i64 = test_build_stringify_object();
    let f5: i64 = test_build_stringify_array();
    let f6: i64 = test_stringify_roundtrip();
    let f7: i64 = test_malformed_json();
    let f8: i64 = test_object_accessors();
    let f9: i64 = test_array_accessors();
    let f10: i64 = test_builder_functions();
    let f11: i64 = test_object_iteration();
    let f12: i64 = test_nested_build();
    let f13: i64 = test_mixed_array();
    let f14: i64 = test_object_key_override();
    let f15: i64 = test_empty_structures();
    let f16: i64 = test_numeric_values();
    let f17: i64 = test_whitespace_handling();
    let f18: i64 = test_complex_structure();

    let failures: i64 = f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12 + f13 + f14 + f15 + f16 + f17 + f18;

    println("");
    if failures == 0 {
        println("All 18 JSON tests passed!");
    } else {
        println("Some JSON tests failed");
    }

    failures
}
