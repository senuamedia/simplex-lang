// WebSocket Module Integration Tests
// Tests real functions from simplex-std/src/websocket.sx via use import

use websocket;

fn test_opcode_validation() -> i64 {
    println("  Testing ws_is_valid_opcode...");
    if ws_is_valid_opcode(0) != 1 { println("  FAIL: continuation"); return 1; }
    if ws_is_valid_opcode(1) != 1 { println("  FAIL: text"); return 1; }
    if ws_is_valid_opcode(2) != 1 { println("  FAIL: binary"); return 1; }
    if ws_is_valid_opcode(8) != 1 { println("  FAIL: close"); return 1; }
    if ws_is_valid_opcode(9) != 1 { println("  FAIL: ping"); return 1; }
    if ws_is_valid_opcode(10) != 1 { println("  FAIL: pong"); return 1; }
    if ws_is_valid_opcode(3) != 0 { println("  FAIL: 3 invalid"); return 1; }
    if ws_is_valid_opcode(7) != 0 { println("  FAIL: 7 invalid"); return 1; }
    if ws_is_valid_opcode(15) != 0 { println("  FAIL: 15 invalid"); return 1; }
    println("  PASS: ws_is_valid_opcode");
    0
}

fn test_control_opcode() -> i64 {
    println("  Testing ws_is_control_opcode/ws_is_data_opcode...");
    if ws_is_control_opcode(8) != 1 { println("  FAIL: close is control"); return 1; }
    if ws_is_control_opcode(9) != 1 { println("  FAIL: ping is control"); return 1; }
    if ws_is_control_opcode(10) != 1 { println("  FAIL: pong is control"); return 1; }
    if ws_is_control_opcode(1) != 0 { println("  FAIL: text not control"); return 1; }
    if ws_is_data_opcode(1) != 1 { println("  FAIL: text is data"); return 1; }
    if ws_is_data_opcode(2) != 1 { println("  FAIL: binary is data"); return 1; }
    if ws_is_data_opcode(8) != 0 { println("  FAIL: close not data"); return 1; }
    println("  PASS: control/data opcode");
    0
}

fn test_close_code_validation() -> i64 {
    println("  Testing ws_is_valid_close_code...");
    if ws_is_valid_close_code(1000) != 1 { println("  FAIL: 1000"); return 1; }
    if ws_is_valid_close_code(1001) != 1 { println("  FAIL: 1001"); return 1; }
    if ws_is_valid_close_code(1011) != 1 { println("  FAIL: 1011"); return 1; }
    if ws_is_valid_close_code(3000) != 1 { println("  FAIL: 3000 app range"); return 1; }
    if ws_is_valid_close_code(4999) != 1 { println("  FAIL: 4999 app range"); return 1; }
    if ws_is_valid_close_code(999) != 0 { println("  FAIL: 999 invalid"); return 1; }
    if ws_is_valid_close_code(1004) != 0 { println("  FAIL: 1004 reserved"); return 1; }
    if ws_is_valid_close_code(5000) != 0 { println("  FAIL: 5000 invalid"); return 1; }
    println("  PASS: ws_is_valid_close_code");
    0
}

fn test_close_code_encoding() -> i64 {
    println("  Testing ws_encode_close_code/ws_decode_close_code...");
    let encoded: i64 = ws_encode_close_code(1000);
    // encoded is a vec of [high_byte, low_byte]
    let high: i64 = vec_get(encoded, 0);
    let low: i64 = vec_get(encoded, 1);
    let decoded: i64 = ws_decode_close_code(high, low);
    if decoded != 1000 {
        println("  FAIL: 1000 roundtrip");
        return 1;
    }
    let enc2: i64 = ws_encode_close_code(4001);
    let h2: i64 = vec_get(enc2, 0);
    let l2: i64 = vec_get(enc2, 1);
    let d2: i64 = ws_decode_close_code(h2, l2);
    if d2 != 4001 {
        println("  FAIL: 4001 roundtrip");
        return 1;
    }
    println("  PASS: close code encoding");
    0
}

fn test_frame_header_size() -> i64 {
    println("  Testing ws_frame_header_size...");
    // Small unmasked: 2
    let s1: i64 = ws_frame_header_size(5, 0);
    if s1 != 2 { println("  FAIL: small unmasked"); return 1; }
    // Small masked: 6
    let s2: i64 = ws_frame_header_size(5, 1);
    if s2 != 6 { println("  FAIL: small masked"); return 1; }
    // Medium unmasked: 4 (2 + 2 extended)
    let s3: i64 = ws_frame_header_size(200, 0);
    if s3 != 4 { println("  FAIL: medium unmasked"); return 1; }
    // Large unmasked: 10 (2 + 8 extended)
    let s5: i64 = ws_frame_header_size(100000, 0);
    if s5 != 10 { println("  FAIL: large unmasked"); return 1; }
    println("  PASS: ws_frame_header_size");
    0
}

fn test_protocol_constants() -> i64 {
    println("  Testing protocol constants...");
    if ws_protocol_version() != 13 {
        println("  FAIL: version should be 13");
        return 1;
    }
    if ws_max_control_payload() != 125 {
        println("  FAIL: max control payload should be 125");
        return 1;
    }
    // Opcode constants must be distinct
    if WS_OPCODE_TEXT() == WS_OPCODE_BINARY() { println("  FAIL: text vs binary"); return 1; }
    if WS_OPCODE_CLOSE() == WS_OPCODE_PING() { println("  FAIL: close vs ping"); return 1; }
    if WS_OPCODE_PING() == WS_OPCODE_PONG() { println("  FAIL: ping vs pong"); return 1; }
    // Close codes
    if WS_CLOSE_NORMAL() != 1000 { println("  FAIL: normal close"); return 1; }
    if WS_CLOSE_GOING_AWAY() != 1001 { println("  FAIL: going away"); return 1; }
    println("  PASS: protocol constants");
    0
}

fn main() -> i64 {
    println("=== WebSocket Integration Tests ===");
    var failures: i64 = 0;
    failures = failures + test_opcode_validation();
    failures = failures + test_control_opcode();
    failures = failures + test_close_code_validation();
    failures = failures + test_close_code_encoding();
    failures = failures + test_frame_header_size();
    failures = failures + test_protocol_constants();
    println("");
    if failures == 0 {
        println("All 6 WebSocket integration tests passed!");
    } else {
        println(string_concat("FAILED: ", string_concat(int_to_string(failures), " test(s) failed")));
    }
    failures
}
