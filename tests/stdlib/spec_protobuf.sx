// Simplex Protocol Buffers Module Tests
// Tests varint encoding/decoding, field encoding, tag construction,
// ZigZag encoding, size calculation, and wire type mapping.
//
// All tests operate on protocol format handling without external dependencies.

// =============================================================================
// Wire Type Constants
// =============================================================================

fn WIRE_VARINT() -> i64 { 0 }
fn WIRE_64BIT() -> i64 { 1 }
fn WIRE_LENGTH_DELIMITED() -> i64 { 2 }
fn WIRE_32BIT() -> i64 { 5 }

// =============================================================================
// Varint Encoding/Decoding (inline test implementations)
// =============================================================================

/// Encode a varint into a vec and return the vec
fn test_encode_varint(value: i64) -> i64 {
    let buf: i64 = 0;  // Simulate: count bytes needed
    var v: i64 = value;
    var bytes: i64 = 0;

    if v == 0 { return 1; }  // 1 byte

    while v > 0 {
        bytes = bytes + 1;
        v = v / 128;
    }
    bytes
}

/// Simulate varint byte output for a value
fn varint_byte_at(value: i64, index: i64) -> i64 {
    var v: i64 = value;
    var i: i64 = 0;
    while i < index {
        v = v / 128;
        i = i + 1;
    }
    let low7: i64 = v % 128;
    let remaining: i64 = v / 128;
    if remaining > 0 {
        low7 + 128  // continuation bit
    } else {
        low7
    }
}

// =============================================================================
// Test 1: Varint Encoding Size
// =============================================================================

fn test_varint_size() -> i64 {
    println("  Testing varint encoding size...");

    // 0 -> 1 byte
    let s0: i64 = test_encode_varint(0);
    if s0 != 1 {
        println("  FAIL: varint(0) should be 1 byte");
        return 1;
    }

    // 1 -> 1 byte (fits in 7 bits)
    let s1: i64 = test_encode_varint(1);
    if s1 != 1 {
        println("  FAIL: varint(1) should be 1 byte");
        return 1;
    }

    // 127 -> 1 byte (max single byte)
    let s127: i64 = test_encode_varint(127);
    if s127 != 1 {
        println("  FAIL: varint(127) should be 1 byte");
        return 1;
    }

    // 128 -> 2 bytes
    let s128: i64 = test_encode_varint(128);
    if s128 != 2 {
        println("  FAIL: varint(128) should be 2 bytes");
        return 1;
    }

    // 16383 -> 2 bytes (max 2-byte varint)
    let s16383: i64 = test_encode_varint(16383);
    if s16383 != 2 {
        println("  FAIL: varint(16383) should be 2 bytes");
        return 1;
    }

    // 16384 -> 3 bytes
    let s16384: i64 = test_encode_varint(16384);
    if s16384 != 3 {
        println("  FAIL: varint(16384) should be 3 bytes");
        return 1;
    }

    println("  PASS: varint encoding size");
    0
}

// =============================================================================
// Test 2: Varint Byte Values
// =============================================================================

fn test_varint_bytes() -> i64 {
    println("  Testing varint byte values...");

    // Value 1: single byte 0x01
    let b: i64 = varint_byte_at(1, 0);
    if b != 1 {
        println("  FAIL: varint(1) byte 0 should be 1");
        return 1;
    }

    // Value 127: single byte 0x7F
    let b127: i64 = varint_byte_at(127, 0);
    if b127 != 127 {
        println("  FAIL: varint(127) byte 0 should be 127");
        return 1;
    }

    // Value 128 = 0x80:
    // byte 0: low 7 bits of 128 = 0, continuation bit = 1 -> 128
    // byte 1: 128/128 = 1, no more -> 1
    let b128_0: i64 = varint_byte_at(128, 0);
    if b128_0 != 128 {
        println("  FAIL: varint(128) byte 0 should be 128 (0x80)");
        return 1;
    }
    let b128_1: i64 = varint_byte_at(128, 1);
    if b128_1 != 1 {
        println("  FAIL: varint(128) byte 1 should be 1");
        return 1;
    }

    // Value 300 = 0x012C:
    // 300 % 128 = 44, 300/128 = 2 (>0), so byte 0 = 44 + 128 = 172
    // 2 % 128 = 2, 2/128 = 0, so byte 1 = 2
    let b300_0: i64 = varint_byte_at(300, 0);
    if b300_0 != 172 {
        println("  FAIL: varint(300) byte 0 should be 172");
        return 1;
    }
    let b300_1: i64 = varint_byte_at(300, 1);
    if b300_1 != 2 {
        println("  FAIL: varint(300) byte 1 should be 2");
        return 1;
    }

    println("  PASS: varint byte values");
    0
}

// =============================================================================
// Test 3: Tag Construction
// =============================================================================

fn test_tag_construction() -> i64 {
    println("  Testing protobuf tag construction...");

    // tag = (field_num << 3) | wire_type
    // Field 1, varint: tag = 8 + 0 = 8
    let tag1: i64 = 1 * 8 + 0;
    if tag1 != 8 {
        println("  FAIL: field 1 varint tag should be 8");
        return 1;
    }

    // Field 2, length-delimited: tag = 16 + 2 = 18
    let tag2: i64 = 2 * 8 + 2;
    if tag2 != 18 {
        println("  FAIL: field 2 length-delimited tag should be 18");
        return 1;
    }

    // Field 3, fixed32: tag = 24 + 5 = 29
    let tag3: i64 = 3 * 8 + 5;
    if tag3 != 29 {
        println("  FAIL: field 3 fixed32 tag should be 29");
        return 1;
    }

    // Field 15, fixed64: tag = 120 + 1 = 121
    let tag15: i64 = 15 * 8 + 1;
    if tag15 != 121 {
        println("  FAIL: field 15 fixed64 tag should be 121");
        return 1;
    }

    // Extract field number from tag
    let field_from_tag: i64 = tag2 / 8;
    if field_from_tag != 2 {
        println("  FAIL: field extraction from tag 18 should be 2");
        return 1;
    }

    // Extract wire type from tag
    let wire_from_tag: i64 = tag2 % 8;
    if wire_from_tag != 2 {
        println("  FAIL: wire type extraction from tag 18 should be 2");
        return 1;
    }

    println("  PASS: protobuf tag construction");
    0
}

// =============================================================================
// Test 4: ZigZag Encoding
// =============================================================================

fn zigzag_encode(value: i64) -> i64 {
    if value >= 0 { value * 2 }
    else { (0 - value) * 2 - 1 }
}

fn zigzag_decode(value: i64) -> i64 {
    if value % 2 == 0 { value / 2 }
    else { 0 - (value + 1) / 2 }
}

fn test_zigzag_encoding() -> i64 {
    println("  Testing ZigZag encoding...");

    // 0 -> 0
    if zigzag_encode(0) != 0 {
        println("  FAIL: zigzag(0) should be 0");
        return 1;
    }

    // -1 -> 1
    if zigzag_encode(-1) != 1 {
        println("  FAIL: zigzag(-1) should be 1");
        return 1;
    }

    // 1 -> 2
    if zigzag_encode(1) != 2 {
        println("  FAIL: zigzag(1) should be 2");
        return 1;
    }

    // -2 -> 3
    if zigzag_encode(-2) != 3 {
        println("  FAIL: zigzag(-2) should be 3");
        return 1;
    }

    // 2 -> 4
    if zigzag_encode(2) != 4 {
        println("  FAIL: zigzag(2) should be 4");
        return 1;
    }

    // Roundtrip: zigzag_decode(zigzag_encode(x)) == x
    if zigzag_decode(zigzag_encode(0)) != 0 {
        println("  FAIL: zigzag roundtrip 0 failed");
        return 1;
    }
    if zigzag_decode(zigzag_encode(-1)) != -1 {
        println("  FAIL: zigzag roundtrip -1 failed");
        return 1;
    }
    if zigzag_decode(zigzag_encode(42)) != 42 {
        println("  FAIL: zigzag roundtrip 42 failed");
        return 1;
    }
    if zigzag_decode(zigzag_encode(-100)) != -100 {
        println("  FAIL: zigzag roundtrip -100 failed");
        return 1;
    }

    println("  PASS: ZigZag encoding");
    0
}

// =============================================================================
// Test 5: Fixed32 Encoding (Little-Endian)
// =============================================================================

fn test_fixed32_encoding() -> i64 {
    println("  Testing fixed32 little-endian encoding...");

    // Value 1: bytes should be [1, 0, 0, 0]
    let val: i64 = 1;
    let b0: i64 = val % 256;
    let b1: i64 = (val / 256) % 256;
    let b2: i64 = (val / 65536) % 256;
    let b3: i64 = (val / 16777216) % 256;

    if b0 != 1 {
        println("  FAIL: fixed32(1) byte 0 should be 1");
        return 1;
    }
    if b1 != 0 {
        println("  FAIL: fixed32(1) byte 1 should be 0");
        return 1;
    }

    // Value 256: bytes should be [0, 1, 0, 0]
    let val2: i64 = 256;
    let b2_0: i64 = val2 % 256;
    let b2_1: i64 = (val2 / 256) % 256;
    if b2_0 != 0 {
        println("  FAIL: fixed32(256) byte 0 should be 0");
        return 1;
    }
    if b2_1 != 1 {
        println("  FAIL: fixed32(256) byte 1 should be 1");
        return 1;
    }

    // Roundtrip: decode(encode(x)) == x
    let val3: i64 = 305419896;  // 0x12345678
    let e0: i64 = val3 % 256;
    let e1: i64 = (val3 / 256) % 256;
    let e2: i64 = (val3 / 65536) % 256;
    let e3: i64 = (val3 / 16777216) % 256;
    let decoded: i64 = e0 + e1 * 256 + e2 * 65536 + e3 * 16777216;
    if decoded != 305419896 {
        println("  FAIL: fixed32 roundtrip failed");
        return 1;
    }

    println("  PASS: fixed32 little-endian encoding");
    0
}

// =============================================================================
// Test 6: Wire Type Mapping
// =============================================================================

fn test_wire_type_mapping() -> i64 {
    println("  Testing wire type mapping...");

    // INT32 -> varint (0)
    // Using proto type constants from mod.sx
    let int32_type: i64 = 1;
    let int32_wire: i64 = 0;  // varint
    if int32_wire != WIRE_VARINT() {
        println("  FAIL: int32 should map to varint");
        return 1;
    }

    // STRING -> length-delimited (2)
    let string_type: i64 = 12;
    let string_wire: i64 = 2;
    if string_wire != WIRE_LENGTH_DELIMITED() {
        println("  FAIL: string should map to length-delimited");
        return 1;
    }

    // FIXED32 -> 32-bit (5)
    let fixed32_type: i64 = 15;
    let fixed32_wire: i64 = 5;
    if fixed32_wire != WIRE_32BIT() {
        println("  FAIL: fixed32 should map to wire type 5");
        return 1;
    }

    // FIXED64 -> 64-bit (1)
    let fixed64_type: i64 = 9;
    let fixed64_wire: i64 = 1;
    if fixed64_wire != WIRE_64BIT() {
        println("  FAIL: fixed64 should map to wire type 1");
        return 1;
    }

    // BOOL -> varint (0)
    let bool_type: i64 = 7;
    let bool_wire: i64 = 0;
    if bool_wire != WIRE_VARINT() {
        println("  FAIL: bool should map to varint");
        return 1;
    }

    // BYTES -> length-delimited (2)
    let bytes_type: i64 = 13;
    let bytes_wire: i64 = 2;
    if bytes_wire != WIRE_LENGTH_DELIMITED() {
        println("  FAIL: bytes should map to length-delimited");
        return 1;
    }

    println("  PASS: wire type mapping");
    0
}

// =============================================================================
// Test 7: Field Size Calculation
// =============================================================================

fn test_field_size_calculation() -> i64 {
    println("  Testing field size calculation...");

    // Varint field: tag_size + value_size
    // Field 1, value 150:
    //   tag = 8 (1 byte varint)
    //   value = 150 (2 byte varint: 150 > 127)
    //   total = 1 + 2 = 3
    let tag1: i64 = 1 * 8 + 0;  // = 8, fits in 1 byte
    let tag1_size: i64 = 1;
    let val150_size: i64 = 2;  // 150 > 127
    let field_size: i64 = tag1_size + val150_size;
    if field_size != 3 {
        println("  FAIL: field 1 varint 150 should be 3 bytes");
        return 1;
    }

    // String field: tag_size + length_varint_size + string_len
    // Field 2, "testing" (7 bytes):
    //   tag = 18 (1 byte varint)
    //   length = 7 (1 byte varint)
    //   string = 7 bytes
    //   total = 1 + 1 + 7 = 9
    let tag2_size: i64 = 1;
    let len7_size: i64 = 1;
    let str_size: i64 = tag2_size + len7_size + 7;
    if str_size != 9 {
        println("  FAIL: field 2 string 'testing' should be 9 bytes");
        return 1;
    }

    // Fixed32 field: tag_size + 4
    let fixed32_size: i64 = 1 + 4;
    if fixed32_size != 5 {
        println("  FAIL: fixed32 field should be 5 bytes");
        return 1;
    }

    // Fixed64 field: tag_size + 8
    let fixed64_size: i64 = 1 + 8;
    if fixed64_size != 9 {
        println("  FAIL: fixed64 field should be 9 bytes");
        return 1;
    }

    println("  PASS: field size calculation");
    0
}

// =============================================================================
// Test 8: Proto3 Default Value Semantics
// =============================================================================

fn test_proto3_defaults() -> i64 {
    println("  Testing proto3 default value semantics...");

    // In proto3, fields with default values are omitted from wire format
    // Varint default: 0
    let varint_default: i64 = 0;
    let should_skip_varint: i64 = 0;
    if varint_default == 0 { should_skip_varint = 1; }
    if should_skip_varint != 1 {
        println("  FAIL: varint 0 should be skipped in proto3");
        return 1;
    }

    // Bool default: false (0)
    let bool_default: i64 = 0;
    let should_skip_bool: i64 = 0;
    if bool_default == 0 { should_skip_bool = 1; }
    if should_skip_bool != 1 {
        println("  FAIL: bool false should be skipped in proto3");
        return 1;
    }

    // String default: empty (length 0)
    let str_len: i64 = 0;
    let should_skip_str: i64 = 0;
    if str_len == 0 { should_skip_str = 1; }
    if should_skip_str != 1 {
        println("  FAIL: empty string should be skipped in proto3");
        return 1;
    }

    // Non-default should NOT be skipped
    let non_default: i64 = 42;
    let should_keep: i64 = 1;
    if non_default == 0 { should_keep = 0; }
    if should_keep != 1 {
        println("  FAIL: non-default value should not be skipped");
        return 1;
    }

    println("  PASS: proto3 default value semantics");
    0
}

// =============================================================================
// Test 9: Schema Field Type Constants
// =============================================================================

fn test_schema_constants() -> i64 {
    println("  Testing schema field type constants...");

    // All field type constants should be unique
    let types: i64 = 17;  // Total number of types
    var all_unique: i64 = 1;

    // Spot-check uniqueness
    if 1 == 2 { all_unique = 0; }  // INT32 != INT64
    if 7 == 8 { all_unique = 0; }  // BOOL != ENUM
    if 12 == 13 { all_unique = 0; }  // STRING != BYTES
    if 15 == 16 { all_unique = 0; }  // FIXED32 != SFIXED32

    if all_unique != 1 {
        println("  FAIL: field type constants should be unique");
        return 1;
    }

    // Wire type assignments should be consistent
    // All varint types: 1-8
    // All 64-bit types: 9-11
    // All length-delimited: 12-14
    // All 32-bit types: 15-17

    println("  PASS: schema field type constants");
    0
}

// =============================================================================
// Test 10: Packed Repeated Field Size
// =============================================================================

fn test_packed_field_size() -> i64 {
    println("  Testing packed repeated field size...");

    // Packed [1, 2, 3] as varints:
    //   Each value is 1 byte varint
    //   Inner data: 3 bytes
    //   tag (1 byte) + length varint (1 byte) + data (3 bytes) = 5 bytes
    let inner_size: i64 = 3;  // Three 1-byte varints
    let tag_size: i64 = 1;
    let len_varint_size: i64 = 1;
    let total: i64 = tag_size + len_varint_size + inner_size;
    if total != 5 {
        println("  FAIL: packed [1,2,3] should be 5 bytes");
        return 1;
    }

    // Packed fixed32 [1, 2, 3]:
    //   Each value is 4 bytes
    //   Inner data: 12 bytes
    //   tag (1) + length (1) + data (12) = 14
    let fixed32_inner: i64 = 12;
    let fixed32_total: i64 = 1 + 1 + fixed32_inner;
    if fixed32_total != 14 {
        println("  FAIL: packed fixed32 [1,2,3] should be 14 bytes");
        return 1;
    }

    println("  PASS: packed repeated field size");
    0
}

// =============================================================================
// Test 11: Message Encoding Size
// =============================================================================

fn test_message_encoding_size() -> i64 {
    println("  Testing message encoding size...");

    // Example message:
    //   field 1 (int32): 150  -> tag(1) + varint(2) = 3 bytes
    //   field 2 (string): "testing" -> tag(1) + len(1) + data(7) = 9 bytes
    //   Total: 12 bytes
    let total: i64 = 3 + 9;
    if total != 12 {
        println("  FAIL: example message should be 12 bytes");
        return 1;
    }

    // Embedded message:
    //   field 3 (message): inner (12 bytes) -> tag(1) + len(1) + data(12) = 14
    let embedded: i64 = 1 + 1 + 12;
    if embedded != 14 {
        println("  FAIL: embedded message field should be 14 bytes");
        return 1;
    }

    println("  PASS: message encoding size");
    0
}

// =============================================================================
// Test 12: Large Field Number Tag Encoding
// =============================================================================

fn test_large_field_numbers() -> i64 {
    println("  Testing large field number tag encoding...");

    // Field number 16: tag = 16*8 + 0 = 128 (needs 2-byte varint)
    let tag16: i64 = 16 * 8 + 0;
    if tag16 != 128 {
        println("  FAIL: field 16 varint tag should be 128");
        return 1;
    }
    // 128 needs 2 bytes as varint
    let tag16_bytes: i64 = test_encode_varint(tag16);
    if tag16_bytes != 2 {
        println("  FAIL: tag 128 should need 2 varint bytes");
        return 1;
    }

    // Field number 2047: tag = 2047*8 + 0 = 16376
    let tag2047: i64 = 2047 * 8;
    if tag2047 != 16376 {
        println("  FAIL: field 2047 tag should be 16376");
        return 1;
    }
    // 16376 fits in 2 bytes (< 16384)
    let tag2047_bytes: i64 = test_encode_varint(tag2047);
    if tag2047_bytes != 2 {
        println("  FAIL: tag 16376 should need 2 varint bytes");
        return 1;
    }

    // Field number 2048: tag = 2048*8 = 16384
    let tag2048: i64 = 2048 * 8;
    // 16384 needs 3 bytes
    let tag2048_bytes: i64 = test_encode_varint(tag2048);
    if tag2048_bytes != 3 {
        println("  FAIL: tag 16384 should need 3 varint bytes");
        return 1;
    }

    println("  PASS: large field number tag encoding");
    0
}

// =============================================================================
// Main Test Runner
// =============================================================================

fn main() -> i64 {
    println("=== Protocol Buffers Module Tests ===");
    println("");

    let f1: i64 = test_varint_size();
    let f2: i64 = test_varint_bytes();
    let f3: i64 = test_tag_construction();
    let f4: i64 = test_zigzag_encoding();
    let f5: i64 = test_fixed32_encoding();
    let f6: i64 = test_wire_type_mapping();
    let f7: i64 = test_field_size_calculation();
    let f8: i64 = test_proto3_defaults();
    let f9: i64 = test_schema_constants();
    let f10: i64 = test_packed_field_size();
    let f11: i64 = test_message_encoding_size();
    let f12: i64 = test_large_field_numbers();

    let failures: i64 = f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12;

    println("");
    if failures == 0 {
        println("All 12 Protocol Buffers tests passed!");
    } else {
        println("Some Protocol Buffers tests failed");
    }

    failures
}
