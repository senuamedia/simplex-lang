use xml;

fn main() -> i64 {
    println(string_from("=== XML Library Integration Test ==="));
    var failures: i64 = 0;

    // Test 1: Parse a simple XML element
    let input: i64 = string_from("<root><item id=\"1\">Hello</item></root>");
    let doc: i64 = xml_parse(input);
    let tag: i64 = xml_tag(doc);
    if string_eq(tag, string_from("root")) != 1 {
        println(string_from("FAIL: root tag"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: xml_tag root"));
    }

    // Test 2: Get children
    let children: i64 = xml_children(doc);
    let n_children: i64 = vec_len(children);
    if n_children < 1 {
        println(string_from("FAIL: root should have children"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: xml_children"));
    }

    // Test 3: Get attribute from child
    let item: i64 = vec_get(children, 0);
    let id_val: i64 = xml_get_attr(item, string_from("id"));
    if string_eq(id_val, string_from("1")) != 1 {
        println(string_from("FAIL: item id should be 1"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: xml_get_attr"));
    }

    // Test 4: Find element by path
    let found: i64 = xml_find(doc, string_from("item"));
    let found_tag: i64 = xml_tag(found);
    if string_eq(found_tag, string_from("item")) != 1 {
        println(string_from("FAIL: xml_find item"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: xml_find"));
    }

    // Test 5: Parse nested XML
    let nested: i64 = string_from("<a><b><c>deep</c></b></a>");
    let ndoc: i64 = xml_parse(nested);
    let fc: i64 = xml_find(ndoc, string_from("c"));
    let fc_tag: i64 = xml_tag(fc);
    if string_eq(fc_tag, string_from("c")) != 1 {
        println(string_from("FAIL: nested find c"));
        failures = failures + 1;
    } else {
        println(string_from("PASS: nested xml_find"));
    }

    if failures == 0 {
        println(string_from("All XML tests passed"));
    }
    failures
}
