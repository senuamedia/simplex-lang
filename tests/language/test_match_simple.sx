// Simple match test without guards
fn test_match_literal() -> i64 {
    let x: i64 = 5;
    match x {
        1 => 10,
        5 => 50,
        _ => 0
    }
}

fn test_match_wildcard() -> i64 {
    let x: i64 = 5;
    match x {
        _ => 42
    }
}

fn main() -> i64 {
    let r1: i64 = test_match_literal();
    if r1 != 50 {
        print("FAIL: match_literal expected 50");
        return 1;
    }

    let r2: i64 = test_match_wildcard();
    if r2 != 42 {
        print("FAIL: match_wildcard expected 42");
        return 1;
    }

    print("PASS: match simple");
    0
}
