// Test basic actor functionality
// Expected: 42 (10 + 20 + 12)

actor Adder {
    var total: i64 = 0;

    receive Add(n: i64) {
        self.total = self.total + n;
    }

    receive Get() -> i64 {
        self.total
    }
}

fn main() -> i64 {
    print("Testing Basic actor functionality");

    let a = spawn Adder {};
    send(a, Add(10));
    send(a, Add(20));
    send(a, Add(12));
    let result: i64 = ask(a, Get());

    if result != 42 {
        print(" FAIL: actor total should be 42");
        return 1;
    }
    print(" PASS: actor accumulates values correctly");
    0
}
