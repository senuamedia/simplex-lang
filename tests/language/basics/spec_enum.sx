// Test enum with match
enum Status {
 Pending,
 Active,
 Complete
}

fn main() -> i64 {
 let s: i64 = Status::Active;
 let result: i64 = match s {
   Status::Pending => 1,
   Status::Active => 2,
   Status::Complete => 3,
   _ => 0
 };
 // Return 0 if test passes (result == 2), non-zero if it fails
 if result == 2 { 0 } else { 1 }
}
// Expected: returns 0 on success
