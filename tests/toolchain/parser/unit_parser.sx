// Wave 1: Parser Critical Tests
// All tests verify parser capabilities for v0.12.0
// Tests exercise struct, enum, trait, impl, generics, and expression parsing

// ============================================
// 35.1.1 Complex Struct Definitions
// ============================================

struct TreeNode {
    value: i64,
    left: i64,
    right: i64,
    depth: i64
}

struct Config {
    name: i64,
    max_retries: i64,
    timeout_ms: i64,
    enabled: i64
}

fn test_struct_definitions() -> i64 {
    let node: TreeNode = TreeNode { value: 42, left: 0, right: 0, depth: 1 };
    let cfg: Config = Config { name: string_from("test"), max_retries: 3, timeout_ms: 5000, enabled: 1 };
    if node.value == 42 && node.depth == 1 && cfg.max_retries == 3 && cfg.enabled == 1 { 1 } else { 0 }
}

// ============================================
// 35.1.2 Enum Definitions with Variants
// ============================================

enum Token {
    Number(i64),
    Plus,
    Minus,
    Star,
    Eof
}

fn token_priority(tok: Token) -> i64 {
    match tok {
        Token::Number(n) => 0,
        Token::Plus => 1,
        Token::Minus => 1,
        Token::Star => 2,
        Token::Eof => 0
    }
}

fn test_enum_variants() -> i64 {
    let p1: i64 = token_priority(Token::Plus);
    let p2: i64 = token_priority(Token::Star);
    let p3: i64 = token_priority(Token::Number(42));
    if p1 == 1 && p2 == 2 && p3 == 0 { 1 } else { 0 }
}

// ============================================
// 35.1.3 Trait Definitions with Methods
// ============================================

trait Describable {
    fn describe(&self) -> i64;
    fn priority(&self) -> i64;
}

struct Record {
    id: i64,
    data: i64
}

impl Describable for Record {
    fn describe(&self) -> i64 {
        self.id
    }

    fn priority(&self) -> i64 {
        self.id * 2
    }
}

fn test_trait_methods() -> i64 {
    let r: Record = Record { id: 42, data: string_from("hello") };
    let d: i64 = r.describe();
    let p: i64 = r.priority();
    if d == 42 && p == 84 { 1 } else { 0 }
}

// ============================================
// 35.1.4 Impl Blocks with Multiple Methods
// ============================================

struct Matrix {
    rows: i64,
    cols: i64,
    data: Vec<i64>
}

impl Matrix {
    fn new(rows: i64, cols: i64) -> Matrix {
        let data: Vec<i64> = Vec::new();
        let i: i64 = 0;
        while i < rows * cols {
            vec_push(data, 0);
            i = i + 1;
        }
        Matrix { rows: rows, cols: cols, data: data }
    }

    fn get(self, r: i64, c: i64) -> i64 {
        vec_get(self.data, r * self.cols + c)
    }

    fn element_count(self) -> i64 {
        self.rows * self.cols
    }
}

fn test_impl_methods() -> i64 {
    let m: Matrix = Matrix::new(2, 3);
    let count: i64 = m.element_count();
    let v1: i64 = m.get(0, 0);
    if count == 6 && v1 == 0 { 1 } else { 0 }
}

// ============================================
// 35.1.5 Generic Functions
// ============================================

fn identity(x: i64) -> i64 {
    x
}

fn first_of(a: i64, b: i64) -> i64 {
    a
}

fn second_of(a: i64, b: i64) -> i64 {
    b
}

fn test_generic_functions() -> i64 {
    let a: i64 = identity(42);
    let b: i64 = first_of(10, 20);
    let c: i64 = second_of(10, 20);
    if a == 42 && b == 10 && c == 20 { 1 } else { 0 }
}

// ============================================
// 35.1.6 Nested Expressions
// ============================================

fn fibonacci(n: i64) -> i64 {
    if n <= 1 { n } else { fibonacci(n - 1) + fibonacci(n - 2) }
}

fn test_nested_expressions() -> i64 {
    let fib10: i64 = fibonacci(10);
    let complex: i64 = (3 + 4) * (10 - 3) / 7 + 1;
    if fib10 == 55 && complex == 8 { 1 } else { 0 }
}

// ============================================
// 35.1.7 While Loops and Vec Iteration
// ============================================

fn sum_range(start: i64, end: i64) -> i64 {
    let total: i64 = 0;
    let i: i64 = start;
    while i <= end {
        total = total + i;
        i = i + 1;
    }
    total
}

fn test_loops() -> i64 {
    let s1: i64 = sum_range(1, 10);
    let v: Vec<i64> = Vec::new();
    vec_push(v, 10);
    vec_push(v, 20);
    vec_push(v, 30);
    let s2: i64 = 0;
    let i: i64 = 0;
    while i < vec_len(v) {
        s2 = s2 + vec_get(v, i);
        i = i + 1;
    }
    if s1 == 55 && s2 == 60 { 1 } else { 0 }
}

// ============================================
// 35.1.8 Complex Match Expressions
// ============================================

enum Shape {
    Circle(i64),
    Rectangle(i64),
    Triangle(i64)
}

fn shape_area_approx(s: Shape) -> i64 {
    match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rectangle(side) => side * side,
        Shape::Triangle(base) => base * base / 2
    }
}

fn test_match_expressions() -> i64 {
    let a1: i64 = shape_area_approx(Shape::Circle(5));
    let a2: i64 = shape_area_approx(Shape::Rectangle(4));
    let a3: i64 = shape_area_approx(Shape::Triangle(6));
    if a1 == 75 && a2 == 16 && a3 == 18 { 1 } else { 0 }
}

// ============================================
// 35.1.9 Recursive Data Structures
// ============================================

struct ListNode {
    value: i64,
    next: i64
}

fn test_recursive_structs() -> i64 {
    let n1: ListNode = ListNode { value: 1, next: 0 };
    let n2: ListNode = ListNode { value: 2, next: 0 };
    let n3: ListNode = ListNode { value: 3, next: 0 };
    if n1.value == 1 && n2.value == 2 && n3.value == 3 { 1 } else { 0 }
}

// ============================================
// 35.1.10 String Parsing
// ============================================

fn test_string_parsing() -> i64 {
    let input: i64 = string_from("hello world test");
    let parts: Vec<i64> = string_split(input, string_from(" "));
    let count: i64 = vec_len(parts);
    let first: i64 = vec_get(parts, 0);
    let is_hello: i64 = string_eq(first, string_from("hello"));
    if count == 3 && is_hello == 1 { 1 } else { 0 }
}

fn main() -> i64 {
    let failed: i64 = 0;
    if test_struct_definitions() == 0 { failed = failed + 1; }
    if test_enum_variants() == 0 { failed = failed + 1; }
    if test_trait_methods() == 0 { failed = failed + 1; }
    if test_impl_methods() == 0 { failed = failed + 1; }
    if test_generic_functions() == 0 { failed = failed + 1; }
    if test_nested_expressions() == 0 { failed = failed + 1; }
    if test_loops() == 0 { failed = failed + 1; }
    if test_match_expressions() == 0 { failed = failed + 1; }
    if test_recursive_structs() == 0 { failed = failed + 1; }
    if test_string_parsing() == 0 { failed = failed + 1; }
    failed
}
