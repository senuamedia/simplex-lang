// Wave 2: Codegen Critical Tests
// Tests for code generation correctness
// Tests verify COMPILE and correct RUNTIME results for v0.12.0

// ============================================
// 35.2.1 Arithmetic Code Generation
// ============================================

fn test_arithmetic() -> i64 {
    let a: i64 = 100;
    let b: i64 = 37;
    let sum: i64 = a + b;      // 137
    let diff: i64 = a - b;     // 63
    let prod: i64 = a * b;     // 3700
    let quot: i64 = a / b;     // 2
    let rem: i64 = a % b;      // 26
    if sum == 137 && diff == 63 && prod == 3700 && quot == 2 && rem == 26 { 1 } else { 0 }
}

// ============================================
// 35.2.2 Comparison and Boolean Code Generation
// ============================================

fn test_comparisons() -> i64 {
    let a: i64 = 10;
    let b: i64 = 20;
    let eq: i64 = if a == a { 1 } else { 0 };
    let ne: i64 = if a != b { 1 } else { 0 };
    let lt: i64 = if a < b { 1 } else { 0 };
    let gt: i64 = if b > a { 1 } else { 0 };
    let le: i64 = if a <= 10 { 1 } else { 0 };
    let ge: i64 = if b >= 20 { 1 } else { 0 };
    if eq == 1 && ne == 1 && lt == 1 && gt == 1 && le == 1 && ge == 1 { 1 } else { 0 }
}

fn test_boolean_logic() -> i64 {
    let t: i64 = 1;
    let f: i64 = 0;
    let and_tt: i64 = if t == 1 && t == 1 { 1 } else { 0 };
    let and_tf: i64 = if t == 1 && f == 1 { 1 } else { 0 };
    let or_tf: i64 = if t == 1 || f == 1 { 1 } else { 0 };
    let or_ff: i64 = if f == 1 || f == 1 { 1 } else { 0 };
    if and_tt == 1 && and_tf == 0 && or_tf == 1 && or_ff == 0 { 1 } else { 0 }
}

// ============================================
// 35.2.3 Struct Layout and Field Access
// ============================================

struct Point3D {
    x: i64,
    y: i64,
    z: i64
}

impl Point3D {
    fn new(x: i64, y: i64, z: i64) -> Point3D {
        Point3D { x: x, y: y, z: z }
    }

    fn manhattan_distance(self) -> i64 {
        let ax: i64 = if self.x < 0 { 0 - self.x } else { self.x };
        let ay: i64 = if self.y < 0 { 0 - self.y } else { self.y };
        let az: i64 = if self.z < 0 { 0 - self.z } else { self.z };
        ax + ay + az
    }

    fn dot(self, other: Point3D) -> i64 {
        self.x * other.x + self.y * other.y + self.z * other.z
    }
}

fn test_struct_codegen() -> i64 {
    let p1: Point3D = Point3D::new(3, -4, 5);
    let p2: Point3D = Point3D::new(1, 2, 3);
    let dist: i64 = p1.manhattan_distance();
    let d: i64 = p1.dot(p2);
    // manhattan: 3+4+5=12, dot: 3*1 + (-4)*2 + 5*3 = 3-8+15=10
    if dist == 12 && d == 10 { 1 } else { 0 }
}

// ============================================
// 35.2.4 Method Dispatch via Traits
// ============================================

trait Measurable {
    fn measure(self) -> i64;
}

struct Segment {
    start: i64,
    end: i64
}

struct Box2D {
    width: i64,
    height: i64
}

impl Measurable for Segment {
    fn measure(self) -> i64 {
        let diff: i64 = self.end - self.start;
        if diff < 0 { 0 - diff } else { diff }
    }
}

impl Measurable for Box2D {
    fn measure(self) -> i64 {
        2 * (self.width + self.height)
    }
}

fn test_trait_dispatch() -> i64 {
    let seg: Segment = Segment { start: 5, end: 15 };
    let box2d: Box2D = Box2D { width: 10, height: 20 };
    let seg_len: i64 = seg.measure();
    let box_perim: i64 = box2d.measure();
    if seg_len == 10 && box_perim == 60 { 1 } else { 0 }
}

// ============================================
// 35.2.5 Recursive Function Codegen
// ============================================

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn power(base: i64, exp: i64) -> i64 {
    if exp == 0 { 1 } else { base * power(base, exp - 1) }
}

fn test_recursive_codegen() -> i64 {
    let g: i64 = gcd(48, 18);
    let p: i64 = power(2, 10);
    if g == 6 && p == 1024 { 1 } else { 0 }
}

// ============================================
// 35.2.6 Vec Operations Codegen
// ============================================

fn local_vec_sum(v: Vec<i64>) -> i64 {
    let total: i64 = 0;
    let i: i64 = 0;
    while i < vec_len(v) {
        total = total + vec_get(v, i);
        i = i + 1;
    }
    total
}

fn vec_max(v: Vec<i64>) -> i64 {
    let mx: i64 = vec_get(v, 0);
    let i: i64 = 1;
    while i < vec_len(v) {
        let val: i64 = vec_get(v, i);
        if val > mx {
            mx = val;
        }
        i = i + 1;
    }
    mx
}

fn test_vec_codegen() -> i64 {
    let v: Vec<i64> = Vec::new();
    vec_push(v, 5);
    vec_push(v, 12);
    vec_push(v, 3);
    vec_push(v, 8);
    vec_push(v, 1);
    let s: i64 = local_vec_sum(v);
    let m: i64 = vec_max(v);
    if s == 29 && m == 12 { 1 } else { 0 }
}

// ============================================
// 35.2.7 String Operations Codegen
// ============================================

fn test_string_codegen() -> i64 {
    let greeting: i64 = string_from("hello");
    let name: i64 = string_from("world");
    let space: i64 = string_from(" ");
    let full: i64 = string_concat(string_concat(greeting, space), name);

    let len: i64 = string_len(full);
    let eq: i64 = string_eq(full, string_from("hello world"));
    let contains: i64 = string_contains(full, string_from("lo wo"));

    if len == 11 && eq == 1 && contains == 1 { 1 } else { 0 }
}

// ============================================
// 35.2.8 Control Flow Codegen
// ============================================

fn collatz_steps(n: i64) -> i64 {
    let steps: i64 = 0;
    let val: i64 = n;
    while val != 1 {
        if val % 2 == 0 {
            val = val / 2;
        } else {
            val = val * 3 + 1;
        }
        steps = steps + 1;
    }
    steps
}

fn test_control_flow_codegen() -> i64 {
    // collatz(6): 6->3->10->5->16->8->4->2->1 = 8 steps
    let steps: i64 = collatz_steps(6);
    if steps == 8 { 1 } else { 0 }
}

// ============================================
// 35.2.9 Nested Function Calls
// ============================================

fn square(x: i64) -> i64 { x * x }
fn double(x: i64) -> i64 { x * 2 }
fn add(a: i64, b: i64) -> i64 { a + b }

fn test_nested_calls() -> i64 {
    // add(square(3), double(5)) = add(9, 10) = 19
    let result: i64 = add(square(3), double(5));
    // square(add(2, 3)) = square(5) = 25
    let result2: i64 = square(add(2, 3));
    if result == 19 && result2 == 25 { 1 } else { 0 }
}

// ============================================
// 35.2.10 HashMap Codegen
// ============================================

fn test_hashmap_codegen() -> i64 {
    let map: HashMap<i64, i64> = HashMap::new();
    hashmap_insert(map, string_from("alpha"), 1);
    hashmap_insert(map, string_from("beta"), 2);
    hashmap_insert(map, string_from("gamma"), 3);

    let a: i64 = option_unwrap(hashmap_get(map, string_from("alpha")));
    let b: i64 = option_unwrap(hashmap_get(map, string_from("beta")));
    let g: i64 = option_unwrap(hashmap_get(map, string_from("gamma")));
    let has: i64 = hashmap_contains(map, string_from("beta"));
    let no: i64 = hashmap_contains(map, string_from("delta"));

    if a == 1 && b == 2 && g == 3 && has == 1 && no == 0 { 1 } else { 0 }
}

fn main() -> i64 {
    let failed: i64 = 0;
    if test_arithmetic() == 0 { failed = failed + 1; }
    if test_comparisons() == 0 { failed = failed + 1; }
    if test_boolean_logic() == 0 { failed = failed + 1; }
    if test_struct_codegen() == 0 { failed = failed + 1; }
    if test_trait_dispatch() == 0 { failed = failed + 1; }
    if test_recursive_codegen() == 0 { failed = failed + 1; }
    if test_vec_codegen() == 0 { failed = failed + 1; }
    if test_string_codegen() == 0 { failed = failed + 1; }
    if test_control_flow_codegen() == 0 { failed = failed + 1; }
    if test_nested_calls() == 0 { failed = failed + 1; }
    if test_hashmap_codegen() == 0 { failed = failed + 1; }
    failed
}
