// ========================================
// Version Consistency Tests
// ========================================

// Canonical version — all tools must match this
fn EXPECTED_VERSION() -> i64 { string_from("0.17.0") }

fn test_sxc_version() -> i64 {
    println("  Testing sxc version consistency...");
    let version: i64 = string_from("0.17.0");
    if string_eq(version, EXPECTED_VERSION()) {
        println("  PASS: sxc version matches 0.17.0");
        return 0;
    }
    println("  FAIL: sxc version mismatch");
    1
}

