// ========================================
// Version Parsing Tests
// ========================================

fn test_version_format() -> i64 {
    println("  Testing version format (semver)...");
    let version: i64 = EXPECTED_VERSION();

    // Verify semver format: major.minor.patch
    let parts: i64 = string_split(version, string_from("."));
    if vec_len(parts) == 3 {
        println("  PASS: version has 3 semver components");
        return 0;
    }
    println("  FAIL: version not in semver format");
    1
}

fn test_version_parse_numeric() -> i64 {
    println("  Testing version numeric parsing...");
    // parse_version from simplex-core/src/version.sx: major * 10000 + minor * 100 + patch
    // 0.17.0 -> 0 * 10000 + 17 * 100 + 0 = 1700
    let expected_numeric: i64 = 1700;

    let parts: i64 = string_split(EXPECTED_VERSION(), string_from("."));
    let major: i64 = string_to_int(vec_get(parts, 0));
    let minor: i64 = string_to_int(vec_get(parts, 1));
    let patch: i64 = string_to_int(vec_get(parts, 2));
    let numeric: i64 = major * 10000 + minor * 100 + patch;

    if numeric == expected_numeric {
        println("  PASS: version parses to 1400");
        return 0;
    }
    println("  FAIL: version numeric parse mismatch");
    1
}

// ========================================
// Cursus VM Stack Overflow Test
// ========================================

fn test_cvm_stack_overflow_caught() -> i64 {
    println("  Testing cursus VM stack overflow protection...");

    // Simulate the bounds check from cvm_push:
    // if sp >= 1024 { error; return sp; }
    let stack_size: i64 = 1024;
    let sp: i64 = 1024;  // At capacity

    if sp >= stack_size {
        // Stack overflow would be caught — push is rejected
        println("  PASS: VM stack overflow detected at sp=1024");
        return 0;
    }
    println("  FAIL: stack overflow not detected");
    1
}

fn test_cvm_stack_within_bounds() -> i64 {
    println("  Testing cursus VM push within bounds...");

    let stack_size: i64 = 1024;
    let sp: i64 = 0;  // Empty stack

    if sp < stack_size {
        // Push is allowed
        let new_sp: i64 = sp + 1;
        if new_sp == 1 {
            println("  PASS: VM push succeeds with sp=0");
            return 0;
        }
    }
    println("  FAIL: valid push rejected");
    1
}

fn test_cvm_stack_near_limit() -> i64 {
    println("  Testing cursus VM push near limit...");

    let stack_size: i64 = 1024;
    let sp: i64 = 1023;  // One slot remaining

    if sp < stack_size {
        // Last push is allowed
        let new_sp: i64 = sp + 1;
        if new_sp == 1024 {
            // Next push would be rejected
            if new_sp >= stack_size {
                println("  PASS: VM allows sp=1023, rejects sp=1024");
                return 0;
            }
        }
    }
    println("  FAIL: near-limit behavior incorrect");
    1
}

// ========================================
// Platform Detection Consistency Tests
// ========================================

fn test_os_detection_returns_known() -> i64 {
    println("  Testing OS detection returns known value...");

    // Simulate unified get_os_name logic from simplex-core/src/platform.sx
    // On any real system, result should be one of: windows, linux, macos, unknown
    let windir: i64 = env_get(string_from("WINDIR"));
    let home: i64 = env_get(string_from("HOME"));
    let valid: i64 = 0;

    if windir != 0 {
        valid = 1;  // Would return "windows"
    } else if home != 0 {
        valid = 1;  // Would return "macos" or "linux"
    }
    // Even "unknown" is a valid return

    println("  PASS: OS detection produces valid result");
    0
}

// ========================================
// Test Runner
// ========================================

fn main() -> i64 {
    println("=== Toolchain Integration Tests ===");
    println("");
    let failures: i64 = 0;

    println("[Version Consistency]");
    failures = failures + test_sxc_version();
    failures = failures + test_sxpm_version();
    failures = failures + test_sxfmt_version();
    failures = failures + test_sxlint_version();
    failures = failures + test_sxlsp_version();
    failures = failures + test_sxdoc_version();
    failures = failures + test_cursus_version();

    println("");
    println("[Version Parsing]");
    failures = failures + test_version_format();
    failures = failures + test_version_parse_numeric();

    println("");
    println("[Cursus VM Safety]");
    failures = failures + test_cvm_stack_overflow_caught();
    failures = failures + test_cvm_stack_within_bounds();
    failures = failures + test_cvm_stack_near_limit();

    println("");
    println("[Platform Detection]");
    failures = failures + test_os_detection_returns_known();

    println("");
    if failures == 0 {
        println("All 13 toolchain integration tests passed.");
    } else {
        println(string_concat(int_to_string(failures), " test(s) FAILED"));
    }
    failures
}
