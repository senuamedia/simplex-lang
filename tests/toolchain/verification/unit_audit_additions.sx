// Validation: Audit Additions (Section 34.11)
// Tests for items discovered during comprehensive phase 1-33 audit
// v0.12.0: Validates core language features, type system, and stdlib

// ============================================
// 34.11.1 Struct Fields and Method Dispatch
// ============================================

struct AuditEntry {
    id: i64,
    severity: i64,
    category: i64
}

impl AuditEntry {
    fn new(id: i64, sev: i64, cat: i64) -> AuditEntry {
        AuditEntry { id: id, severity: sev, category: cat }
    }

    fn is_critical(self) -> i64 {
        if self.severity >= 4 { 1 } else { 0 }
    }

    fn score(self) -> i64 {
        self.severity * 10 + self.category
    }
}

fn test_struct_methods() -> i64 {
    let entry: AuditEntry = AuditEntry::new(1, 5, 3);
    let critical: i64 = entry.is_critical();
    let score: i64 = entry.score();
    if critical == 1 && score == 53 { 1 } else { 0 }
}

// ============================================
// 34.11.2 Trait Definition and Implementation
// ============================================

trait Scorable {
    fn compute_score(self) -> i64;
}

struct Finding {
    weight: i64,
    count: i64
}

impl Scorable for Finding {
    fn compute_score(self) -> i64 {
        self.weight * self.count
    }
}

fn test_trait_implementation() -> i64 {
    let f: Finding = Finding { weight: 3, count: 7 };
    let score: i64 = f.compute_score();
    if score == 21 { 1 } else { 0 }
}

// ============================================
// 34.11.3 Enum and Pattern Matching
// ============================================

enum Severity {
    Low,
    Medium,
    High,
    Critical(i64)
}

fn severity_value(s: Severity) -> i64 {
    match s {
        Severity::Low => 1,
        Severity::Medium => 2,
        Severity::High => 3,
        Severity::Critical(code) => 10 + code
    }
}

fn test_enum_matching() -> i64 {
    let v1: i64 = severity_value(Severity::Low);
    let v2: i64 = severity_value(Severity::High);
    let v3: i64 = severity_value(Severity::Critical(5));
    if v1 == 1 && v2 == 3 && v3 == 15 { 1 } else { 0 }
}

// ============================================
// 34.11.4 Generic Functions
// ============================================

fn max_val<T>(a: T, b: T) -> T {
    if a > b { a } else { b }
}

fn min_val<T>(a: T, b: T) -> T {
    if a < b { a } else { b }
}

fn test_generics() -> i64 {
    let mx: i64 = max_val(10, 20);
    let mn: i64 = min_val(10, 20);
    if mx == 20 && mn == 10 { 1 } else { 0 }
}

// ============================================
// 34.11.5 Vec Audit Trail
// ============================================

fn test_vec_operations() -> i64 {
    let trail: Vec<i64> = Vec::new();
    vec_push(trail, 100);
    vec_push(trail, 200);
    vec_push(trail, 300);

    let len: i64 = vec_len(trail);
    let first: i64 = vec_get(trail, 0);
    let last: i64 = vec_get(trail, 2);
    let sum: i64 = first + vec_get(trail, 1) + last;

    if len == 3 && sum == 600 { 1 } else { 0 }
}

// ============================================
// 34.11.6 String Operations
// ============================================

fn test_string_ops() -> i64 {
    let prefix: i64 = string_from("AUDIT");
    let sep: i64 = string_from("-");
    let id: i64 = string_from("001");
    let result: i64 = string_concat(string_concat(prefix, sep), id);
    let len: i64 = string_len(result);
    // "AUDIT-001" = 9 chars
    if len == 9 { 1 } else { 0 }
}

// ============================================
// 34.11.7 Option/Result Types
// ============================================

fn lookup_entry(id: i64) -> i64 {
    if id > 0 { option_some(id * 100) } else { option_none() }
}

fn test_option_handling() -> i64 {
    let found: i64 = lookup_entry(5);
    let missing: i64 = lookup_entry(0);
    let val: i64 = option_unwrap(found);
    if option_is_some(found) == 1 && option_is_none(missing) == 1 && val == 500 { 1 } else { 0 }
}

// ============================================
// 34.11.8 HashMap Config Store
// ============================================

fn test_hashmap_config() -> i64 {
    let config: HashMap<i64, i64> = HashMap::new();
    hashmap_insert(config, string_from("max_severity"), 5);
    hashmap_insert(config, string_from("min_entries"), 10);
    hashmap_insert(config, string_from("timeout"), 30);

    let max_sev: i64 = option_unwrap(hashmap_get(config, string_from("max_severity")));
    let has_timeout: i64 = hashmap_contains(config, string_from("timeout"));

    if max_sev == 5 && has_timeout == 1 { 1 } else { 0 }
}

// ============================================
// 34.11.9 Nested Struct Composition
// ============================================

struct AuditReport {
    total: i64,
    critical_count: i64,
    pass_rate: i64
}

impl AuditReport {
    fn new() -> AuditReport {
        AuditReport { total: 0, critical_count: 0, pass_rate: 0 }
    }

    fn add_finding(self, severity: i64) -> AuditReport {
        let new_critical: i64 = self.critical_count;
        if severity >= 4 {
            new_critical = new_critical + 1;
        }
        let new_total: i64 = self.total + 1;
        let rate: i64 = (new_total - new_critical) * 100 / new_total;
        AuditReport { total: new_total, critical_count: new_critical, pass_rate: rate }
    }
}

fn test_struct_composition() -> i64 {
    let report: AuditReport = AuditReport::new();
    let report: AuditReport = report.add_finding(2);
    let report: AuditReport = report.add_finding(5);
    let report: AuditReport = report.add_finding(1);
    // total=3, critical=1, pass_rate = (3-1)*100/3 = 66
    if report.total == 3 && report.critical_count == 1 && report.pass_rate == 66 { 1 } else { 0 }
}

// ============================================
// 34.11.10 Complex Control Flow
// ============================================

fn count_violations(entries: Vec<i64>, threshold: i64) -> i64 {
    let count: i64 = 0;
    let i: i64 = 0;
    while i < vec_len(entries) {
        let val: i64 = vec_get(entries, i);
        if val > threshold {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

fn test_control_flow() -> i64 {
    let entries: Vec<i64> = Vec::new();
    vec_push(entries, 1);
    vec_push(entries, 5);
    vec_push(entries, 3);
    vec_push(entries, 8);
    vec_push(entries, 2);
    let violations: i64 = count_violations(entries, 4);
    if violations == 2 { 1 } else { 0 }
}

fn main() -> i64 {
    let failed: i64 = 0;
    if test_struct_methods() == 0 { failed = failed + 1; }
    if test_trait_implementation() == 0 { failed = failed + 1; }
    if test_enum_matching() == 0 { failed = failed + 1; }
    if test_generics() == 0 { failed = failed + 1; }
    if test_vec_operations() == 0 { failed = failed + 1; }
    if test_string_ops() == 0 { failed = failed + 1; }
    if test_option_handling() == 0 { failed = failed + 1; }
    if test_hashmap_config() == 0 { failed = failed + 1; }
    if test_struct_composition() == 0 { failed = failed + 1; }
    if test_control_flow() == 0 { failed = failed + 1; }
    failed
}
