// Integration Verification Suite
// End-to-end tests combining multiple language features
// v0.12.0: Validates feature integration across the compiler pipeline

// ============================================
// Integration 1: Type System + Methods + Traits
// ============================================

trait Renderable {
    fn render(self) -> i64;
    fn priority(self) -> i64;
}

struct Widget {
    id: i64,
    kind: i64,
    content: i64,
    visible: i64
}

impl Widget {
    fn new(id: i64, kind: i64, content: i64) -> Widget {
        Widget { id: id, kind: kind, content: content, visible: 1 }
    }

    fn hide(self) -> Widget {
        Widget { id: self.id, kind: self.kind, content: self.content, visible: 0 }
    }
}

impl Renderable for Widget {
    fn render(self) -> i64 {
        if self.visible == 1 { self.content } else { string_from("") }
    }

    fn priority(self) -> i64 {
        self.kind * 10 + self.id
    }
}

fn test_type_integration() -> i64 {
    let w1: Widget = Widget::new(1, 2, string_from("Button"));
    let w2: Widget = Widget::new(2, 1, string_from("Label"));
    let w3: Widget = w1.hide();

    let p1: i64 = w1.priority();
    let p2: i64 = w2.priority();
    let r3: i64 = w3.render();

    // w1 priority: 2*10+1=21, w2: 1*10+2=12, w3 hidden: empty string
    if p1 == 21 && p2 == 12 && string_len(r3) == 0 { 1 } else { 0 }
}

// ============================================
// Integration 2: Vec + Struct + Processing Pipeline
// ============================================

struct DataPoint {
    x: i64,
    y: i64,
    label: i64
}

impl DataPoint {
    fn new(x: i64, y: i64, label: i64) -> DataPoint {
        DataPoint { x: x, y: y, label: label }
    }

    fn distance_sq(self) -> i64 {
        self.x * self.x + self.y * self.y
    }
}

fn process_dataset(points: Vec<i64>) -> i64 {
    let total_dist: i64 = 0;
    let i: i64 = 0;
    while i < vec_len(points) {
        let p: DataPoint = vec_get(points, i);
        total_dist = total_dist + p.distance_sq();
        i = i + 1;
    }
    total_dist
}

fn test_pipeline_integration() -> i64 {
    let points: Vec<i64> = Vec::new();
    vec_push(points, DataPoint::new(3, 4, 0));   // dist_sq = 25
    vec_push(points, DataPoint::new(1, 1, 1));   // dist_sq = 2
    vec_push(points, DataPoint::new(5, 0, 0));   // dist_sq = 25

    let total: i64 = process_dataset(points);
    if total == 52 { 1 } else { 0 }
}

// ============================================
// Integration 3: Enum + HashMap + State Machine
// ============================================

enum State {
    Idle,
    Running(i64),
    Paused(i64),
    Done(i64)
}

fn state_name(s: State) -> i64 {
    match s {
        State::Idle => string_from("idle"),
        State::Running(id) => string_from("running"),
        State::Paused(id) => string_from("paused"),
        State::Done(result) => string_from("done")
    }
}

fn state_transition(s: State) -> State {
    match s {
        State::Idle => State::Running(1),
        State::Running(id) => State::Paused(id),
        State::Paused(id) => State::Running(id + 1),
        State::Done(r) => State::Done(r)
    }
}

fn test_state_machine() -> i64 {
    let s: State = State::Idle;
    let s: State = state_transition(s);  // Running(1)
    let n1: i64 = state_name(s);
    let s: State = state_transition(s);  // Paused(1)
    let n2: i64 = state_name(s);
    let s: State = state_transition(s);  // Running(2)
    let n3: i64 = state_name(s);

    if string_eq(n1, string_from("running")) == 1 &&
       string_eq(n2, string_from("paused")) == 1 &&
       string_eq(n3, string_from("running")) == 1 { 1 } else { 0 }
}

// ============================================
// Integration 4: Builder Pattern
// ============================================

struct QueryBuilder {
    table: i64,
    conditions: Vec<i64>,
    limit: i64,
    offset: i64
}

impl QueryBuilder {
    fn new(table: i64) -> QueryBuilder {
        QueryBuilder { table: table, conditions: Vec::new(), limit: 0, offset: 0 }
    }

    fn where_clause(self, condition: i64) -> QueryBuilder {
        vec_push(self.conditions, condition);
        QueryBuilder { table: self.table, conditions: self.conditions, limit: self.limit, offset: self.offset }
    }

    fn with_limit(self, n: i64) -> QueryBuilder {
        QueryBuilder { table: self.table, conditions: self.conditions, limit: n, offset: self.offset }
    }

    fn with_offset(self, n: i64) -> QueryBuilder {
        QueryBuilder { table: self.table, conditions: self.conditions, limit: self.limit, offset: n }
    }

    fn condition_count(self) -> i64 {
        vec_len(self.conditions)
    }
}

fn test_builder_pattern() -> i64 {
    let q: QueryBuilder = QueryBuilder::new(string_from("users"));
    let q: QueryBuilder = q.where_clause(string_from("age > 18"));
    let q: QueryBuilder = q.where_clause(string_from("active = true"));
    let q: QueryBuilder = q.with_limit(10);
    let q: QueryBuilder = q.with_offset(20);

    let conds: i64 = q.condition_count();
    if conds == 2 && q.limit == 10 && q.offset == 20 { 1 } else { 0 }
}

// ============================================
// Integration 5: String Processing Pipeline
// ============================================

fn count_words(text: i64) -> i64 {
    let words: Vec<i64> = string_split(text, string_from(" "));
    vec_len(words)
}

fn build_csv_row(fields: Vec<i64>) -> i64 {
    let result: i64 = string_from("");
    let i: i64 = 0;
    while i < vec_len(fields) {
        if i > 0 {
            result = string_concat(result, string_from(","));
        }
        result = string_concat(result, vec_get(fields, i));
        i = i + 1;
    }
    result
}

fn test_string_pipeline() -> i64 {
    let text: i64 = string_from("the quick brown fox jumps");
    let wc: i64 = count_words(text);

    let fields: Vec<i64> = Vec::new();
    vec_push(fields, string_from("name"));
    vec_push(fields, string_from("age"));
    vec_push(fields, string_from("city"));
    let csv: i64 = build_csv_row(fields);

    if wc == 5 && string_eq(csv, string_from("name,age,city")) == 1 { 1 } else { 0 }
}

// ============================================
// Integration 6: Config + Struct + Validation
// ============================================

struct AppConfig {
    host: i64,
    port: i64,
    max_connections: i64,
    debug: i64
}

impl AppConfig {
    fn from_map(map: HashMap<i64, i64>) -> AppConfig {
        let host: i64 = option_unwrap(hashmap_get(map, string_from("host")));
        let port: i64 = option_unwrap(hashmap_get(map, string_from("port")));
        let max_conn: i64 = option_unwrap(hashmap_get(map, string_from("max_connections")));
        let debug: i64 = option_unwrap(hashmap_get(map, string_from("debug")));
        AppConfig { host: host, port: port, max_connections: max_conn, debug: debug }
    }

    fn is_valid(self) -> i64 {
        if self.port > 0 && self.port < 65536 && self.max_connections > 0 { 1 } else { 0 }
    }
}

fn test_config_integration() -> i64 {
    let map: HashMap<i64, i64> = HashMap::new();
    hashmap_insert(map, string_from("host"), string_from("localhost"));
    hashmap_insert(map, string_from("port"), 8080);
    hashmap_insert(map, string_from("max_connections"), 100);
    hashmap_insert(map, string_from("debug"), 1);

    let cfg: AppConfig = AppConfig::from_map(map);
    let valid: i64 = cfg.is_valid();

    if valid == 1 && cfg.port == 8080 && cfg.max_connections == 100 { 1 } else { 0 }
}

// ============================================
// Integration 7: Error Propagation with Option
// ============================================

fn parse_int_safe(s: i64) -> i64 {
    let val: i64 = string_to_int(s);
    if val == 0 && string_eq(s, string_from("0")) == 0 {
        option_none()
    } else {
        option_some(val)
    }
}

fn add_parsed(a: i64, b: i64) -> i64 {
    let va: i64 = parse_int_safe(a);
    let vb: i64 = parse_int_safe(b);
    if option_is_some(va) == 1 && option_is_some(vb) == 1 {
        option_some(option_unwrap(va) + option_unwrap(vb))
    } else {
        option_none()
    }
}

fn test_error_propagation() -> i64 {
    let r1: i64 = add_parsed(string_from("10"), string_from("20"));
    let r2: i64 = add_parsed(string_from("abc"), string_from("20"));

    if option_is_some(r1) == 1 && option_unwrap(r1) == 30 && option_is_none(r2) == 1 { 1 } else { 0 }
}

// ============================================
// Integration 8: Generic + Trait + Vec
// ============================================

fn vec_count_matching(v: Vec<i64>, predicate_val: i64) -> i64 {
    let count: i64 = 0;
    let i: i64 = 0;
    while i < vec_len(v) {
        if vec_get(v, i) == predicate_val {
            count = count + 1;
        }
        i = i + 1;
    }
    count
}

fn test_generic_collection() -> i64 {
    let v: Vec<i64> = Vec::new();
    vec_push(v, 1);
    vec_push(v, 2);
    vec_push(v, 1);
    vec_push(v, 3);
    vec_push(v, 1);

    let ones: i64 = vec_count_matching(v, 1);
    let twos: i64 = vec_count_matching(v, 2);
    let fours: i64 = vec_count_matching(v, 4);

    if ones == 3 && twos == 1 && fours == 0 { 1 } else { 0 }
}

fn main() -> i64 {
    let failed: i64 = 0;
    if test_type_integration() == 0 { failed = failed + 1; }
    if test_pipeline_integration() == 0 { failed = failed + 1; }
    if test_state_machine() == 0 { failed = failed + 1; }
    if test_builder_pattern() == 0 { failed = failed + 1; }
    if test_string_pipeline() == 0 { failed = failed + 1; }
    if test_config_integration() == 0 { failed = failed + 1; }
    if test_error_propagation() == 0 { failed = failed + 1; }
    if test_generic_collection() == 0 { failed = failed + 1; }
    failed
}
