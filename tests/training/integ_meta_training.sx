// Integration tests for meta-training pipeline (self-contained)
//
// Tests the core meta-optimization logic using inline stubs to avoid
// importing simplex_training and simplex_std which cause xrealloc overflow
// from deep generic type instantiation.
//
// Verified concepts:
// - MetaOptimizer updating schedule parameters via gradient descent
// - Curriculum ordering by difficulty weights
// - Compression pipeline stage execution with quality gates
// - Quality gate enforcement preventing excessive degradation
// - Meta-loss convergence tracking

// =============================================================================
// Helpers: simple abs/min
// =============================================================================

fn fabs(x: i64) -> i64 {
    if x < 0 { return 0 - x; }
    x
}

// We use i64 scaled by 1000 to simulate f64 arithmetic without generics.
// E.g., 0.95 -> 950, 0.01 -> 10, 1.0 -> 1000

// =============================================================================
// Test 1: MetaOptimizer updates all schedule parameters
// =============================================================================

fn test_meta_optimizer_updates_all() -> i64 {
    println("  Testing meta optimizer updates all 5 schedules...");

    // Schedules: [lr, distill_temp, prune_sparsity, quant_bits, curriculum_w0]
    // Initial values (scaled x1000)
    let sched: i64 = vec_new();
    vec_push(sched, 100);   // lr = 0.100
    vec_push(sched, 5000);  // distill_temp = 5.0
    vec_push(sched, 500);   // prune_sparsity = 0.5
    vec_push(sched, 8000);  // quant_bits = 8.0
    vec_push(sched, 200);   // curriculum_w0 = 0.2

    let initial_lr: i64 = vec_get(sched, 0);
    let initial_temp: i64 = vec_get(sched, 1);
    let initial_sparsity: i64 = vec_get(sched, 2);
    let initial_bits: i64 = vec_get(sched, 3);
    let initial_cw0: i64 = vec_get(sched, 4);

    // Gradients (scaled x1000)
    let grad: i64 = vec_new();
    vec_push(grad, 1000);  // d_lr = 1.0
    vec_push(grad, 2000);  // d_temp = 2.0
    vec_push(grad, 500);   // d_sparsity = 0.5
    vec_push(grad, 3000);  // d_bits = 3.0
    vec_push(grad, 1000);  // d_cw0 = 1.0

    // Apply gradient step: param = param - meta_lr * grad
    // meta_lr = 0.1 -> scaled = 100
    let meta_lr: i64 = 100;
    var i: i64 = 0;
    while i < 5 {
        let param: i64 = vec_get(sched, i);
        let g: i64 = vec_get(grad, i);
        // param - (meta_lr * g) / 1000  (rescale from double-scaled)
        let update: i64 = (meta_lr * g) / 1000;
        vec_set(sched, i, param - update);
        i = i + 1;
    }

    // Verify all 5 changed
    if vec_get(sched, 0) == initial_lr {
        println("  FAIL: LR should be updated");
        return 1;
    }
    if vec_get(sched, 1) == initial_temp {
        println("  FAIL: distill temp should be updated");
        return 1;
    }
    if vec_get(sched, 2) == initial_sparsity {
        println("  FAIL: prune sparsity should be updated");
        return 1;
    }
    if vec_get(sched, 3) == initial_bits {
        println("  FAIL: quant bits should be updated");
        return 1;
    }
    if vec_get(sched, 4) == initial_cw0 {
        println("  FAIL: curriculum weight should be updated");
        return 1;
    }

    println("  PASS: meta optimizer updates all 5 schedules");
    0
}

// =============================================================================
// Test 2: Gradient clipping
// =============================================================================

fn test_gradient_clipping() -> i64 {
    println("  Testing gradient clipping...");

    // Gradient with very large norm
    let grad: i64 = vec_new();
    vec_push(grad, 100000); // huge gradient
    vec_push(grad, 0);
    vec_push(grad, 0);

    // Compute norm (simplified: just abs of largest)
    let norm: i64 = 100000;
    let clip_threshold: i64 = 500; // 0.5 scaled

    // Clip: scale = threshold / norm
    if norm > clip_threshold {
        var j: i64 = 0;
        while j < vec_len(grad) {
            let g: i64 = vec_get(grad, j);
            let clipped: i64 = (g * clip_threshold) / norm;
            vec_set(grad, j, clipped);
            j = j + 1;
        }
    }

    let clipped_val: i64 = vec_get(grad, 0);
    if clipped_val >= 100000 {
        println("  FAIL: gradient should have been clipped");
        return 1;
    }
    if clipped_val != 500 {
        // clip_threshold * 100000 / 100000 = 500
        println("  FAIL: clipped value should be 500");
        return 1;
    }

    println("  PASS: gradient clipping");
    0
}

// =============================================================================
// Test 3: Curriculum ordering changes with difficulty weights
// =============================================================================

fn test_curriculum_ordering() -> i64 {
    println("  Testing curriculum ordering by difficulty...");

    // 4 tasks with difficulty weights
    let weights: i64 = vec_new();
    vec_push(weights, 500);   // task 0: 0.5
    vec_push(weights, 300);   // task 1: 0.3
    vec_push(weights, 800);   // task 2: 0.8
    vec_push(weights, 100);   // task 3: 0.1

    // Sort by weight ascending to get ordering (easiest first)
    let ordering: i64 = vec_new();
    vec_push(ordering, 0);
    vec_push(ordering, 1);
    vec_push(ordering, 2);
    vec_push(ordering, 3);

    // Bubble sort by weight
    var sorted: i64 = 0;
    while sorted == 0 {
        sorted = 1;
        var k: i64 = 0;
        while k < 3 {
            let idx_a: i64 = vec_get(ordering, k);
            let idx_b: i64 = vec_get(ordering, k + 1);
            let w_a: i64 = vec_get(weights, idx_a);
            let w_b: i64 = vec_get(weights, idx_b);
            if w_a > w_b {
                vec_set(ordering, k, idx_b);
                vec_set(ordering, k + 1, idx_a);
                sorted = 0;
            }
            k = k + 1;
        }
    }

    // Easiest (task 3, weight 100) should be first
    if vec_get(ordering, 0) != 3 {
        println("  FAIL: easiest task should be first");
        return 1;
    }
    // Hardest (task 2, weight 800) should be last
    if vec_get(ordering, 3) != 2 {
        println("  FAIL: hardest task should be last");
        return 1;
    }

    // Now apply a gradient that decreases task 2's weight significantly
    let new_w2: i64 = 800 - 900; // goes negative -> becomes easiest
    vec_set(weights, 2, new_w2);

    // Re-sort
    sorted = 0;
    while sorted == 0 {
        sorted = 1;
        var k2: i64 = 0;
        while k2 < 3 {
            let idx_a: i64 = vec_get(ordering, k2);
            let idx_b: i64 = vec_get(ordering, k2 + 1);
            let w_a: i64 = vec_get(weights, idx_a);
            let w_b: i64 = vec_get(weights, idx_b);
            if w_a > w_b {
                vec_set(ordering, k2, idx_b);
                vec_set(ordering, k2 + 1, idx_a);
                sorted = 0;
            }
            k2 = k2 + 1;
        }
    }

    // Task 2 should now be first (lowest weight after gradient)
    if vec_get(ordering, 0) != 2 {
        println("  FAIL: task 2 should move to first after gradient reduces its weight");
        return 1;
    }

    println("  PASS: curriculum ordering");
    0
}

// =============================================================================
// Test 4: Compression stages execute in order
// =============================================================================

fn test_compression_stages_order() -> i64 {
    println("  Testing compression stages execute in order...");

    // Stages: 0=Distillation, 1=Pruning, 2=Quantization
    let stages: i64 = vec_new();
    vec_push(stages, 0);
    vec_push(stages, 1);
    vec_push(stages, 2);

    let executed: i64 = vec_new();
    var model_size: i64 = 1000000;
    var model_loss: i64 = 500; // 0.5 scaled x1000

    var si: i64 = 0;
    while si < vec_len(stages) {
        let stage: i64 = vec_get(stages, si);
        vec_push(executed, stage);

        if stage == 0 {
            // Distillation: slightly improve loss
            model_loss = (model_loss * 990) / 1000;
        }
        if stage == 1 {
            // Pruning: reduce size, slightly degrade loss
            model_size = (model_size * 95) / 100;
            model_loss = (model_loss * 1001) / 1000;
        }
        if stage == 2 {
            // Quantization: reduce size more, slightly degrade loss
            model_size = model_size / 4;
            model_loss = (model_loss * 1002) / 1000;
        }
        si = si + 1;
    }

    if vec_len(executed) != 3 {
        println("  FAIL: should have executed 3 stages");
        return 1;
    }
    if vec_get(executed, 0) != 0 {
        println("  FAIL: first stage should be Distillation (0)");
        return 1;
    }
    if vec_get(executed, 1) != 1 {
        println("  FAIL: second stage should be Pruning (1)");
        return 1;
    }
    if vec_get(executed, 2) != 2 {
        println("  FAIL: third stage should be Quantization (2)");
        return 1;
    }
    if model_size >= 1000000 {
        println("  FAIL: model should be smaller after compression");
        return 1;
    }

    println("  PASS: compression stages execute in order");
    0
}

// =============================================================================
// Test 5: Quality gate prevents degradation
// =============================================================================

fn test_quality_gate_enforcement() -> i64 {
    println("  Testing quality gate enforcement...");

    // Baseline: accuracy=950 (0.95), loss=500 (0.5)
    let baseline_acc: i64 = 950;
    let baseline_loss: i64 = 500;

    // Thresholds: max 1% accuracy drop (10), max 5% loss increase (25)
    let max_acc_drop: i64 = 10;
    let max_loss_increase: i64 = 25;

    // Small degradation: should pass
    let small_acc: i64 = 940;   // 0.94 -> drop = 10 -> at threshold
    let small_loss: i64 = 520;  // 0.52 -> increase = 20 -> under threshold
    let acc_drop_1: i64 = baseline_acc - small_acc;
    let loss_inc_1: i64 = small_loss - baseline_loss;
    let pass_1: i64 = 1;
    if acc_drop_1 > max_acc_drop { println("  FAIL: small acc drop should pass"); return 1; }
    if loss_inc_1 > max_loss_increase { println("  FAIL: small loss inc should pass"); return 1; }

    // Large degradation: should fail
    let big_acc: i64 = 800;    // 0.80 -> drop = 150 -> way over
    let big_loss: i64 = 1000;  // 1.0 -> increase = 500 -> way over
    let acc_drop_2: i64 = baseline_acc - big_acc;
    let loss_inc_2: i64 = big_loss - baseline_loss;
    if acc_drop_2 <= max_acc_drop {
        println("  FAIL: large acc drop should fail gate");
        return 1;
    }
    if loss_inc_2 <= max_loss_increase {
        println("  FAIL: large loss increase should fail gate");
        return 1;
    }

    // Pipeline with quality gate: should exit early after bad stage
    let stages: i64 = vec_new();
    vec_push(stages, 0); // distillation
    vec_push(stages, 1); // pruning
    vec_push(stages, 2); // quantization

    var cur_acc: i64 = baseline_acc;
    var cur_loss: i64 = baseline_loss;
    var stages_completed: i64 = 0;
    var gate_failed: i64 = 0;

    var pi: i64 = 0;
    while pi < vec_len(stages) {
        if gate_failed == 1 {
            pi = pi + 1;
            continue;
        }
        let stage: i64 = vec_get(stages, pi);

        // Simulate distillation causing massive quality drop
        if stage == 0 {
            cur_acc = 800;
            cur_loss = 2000;
        }

        // Check quality gate
        let a_drop: i64 = baseline_acc - cur_acc;
        let l_inc: i64 = cur_loss - baseline_loss;
        if a_drop > max_acc_drop {
            gate_failed = 1;
        }
        if l_inc > max_loss_increase {
            gate_failed = 1;
        }

        stages_completed = stages_completed + 1;
        pi = pi + 1;
    }

    if gate_failed != 1 {
        println("  FAIL: gate should have detected degradation");
        return 1;
    }
    // Only 1 stage should have run before gate triggered
    if stages_completed != 1 {
        println("  FAIL: should have completed only 1 stage before gate failure");
        return 1;
    }

    println("  PASS: quality gate enforcement");
    0
}

// =============================================================================
// Test 6: Meta-loss convergence tracking
// =============================================================================

fn test_meta_loss_convergence() -> i64 {
    println("  Testing meta-loss convergence tracking...");

    // Simulate 20 meta-training steps where loss decreases
    let losses: i64 = vec_new();
    var step: i64 = 0;
    while step < 20 {
        // loss = 1000 / (1 + step/5) = 1000, 833, 714, ...
        let loss: i64 = 1000000 / (1000 + step * 200);
        vec_push(losses, loss);
        step = step + 1;
    }

    // Early average (first 3)
    let early_sum: i64 = vec_get(losses, 0) + vec_get(losses, 1) + vec_get(losses, 2);
    let early_avg: i64 = early_sum / 3;

    // Late average (last 3)
    let n: i64 = vec_len(losses);
    let late_sum: i64 = vec_get(losses, n - 3) + vec_get(losses, n - 2) + vec_get(losses, n - 1);
    let late_avg: i64 = late_sum / 3;

    // Late should be less than early (loss should decrease)
    if late_avg >= early_avg {
        println("  FAIL: late average should be less than early average");
        return 1;
    }

    // Meta loss should not diverge: late < 2 * early
    if late_avg >= early_avg * 2 {
        println("  FAIL: meta loss diverged");
        return 1;
    }

    println("  PASS: meta-loss convergence");
    0
}

// =============================================================================
// Test 7: Convergence detection on plateau
// =============================================================================

fn test_convergence_detection() -> i64 {
    println("  Testing convergence detection on plateau...");

    let losses: i64 = vec_new();
    // First: converging sequence
    var i: i64 = 0;
    while i < 10 {
        let loss: i64 = 1000000 / (1000 + i * 200);
        vec_push(losses, loss);
        i = i + 1;
    }
    // Then: plateau (nearly identical losses around 170)
    var j: i64 = 0;
    while j < 10 {
        let loss: i64 = 170 + j;  // 170, 171, 172, ...
        vec_push(losses, loss);
        j = j + 1;
    }

    // Check if the last N losses form a plateau (variance < threshold)
    let window: i64 = 5;
    let n: i64 = vec_len(losses);
    var sum: i64 = 0;
    var wi: i64 = n - window;
    while wi < n {
        sum = sum + vec_get(losses, wi);
        wi = wi + 1;
    }
    let mean: i64 = sum / window;

    // Check max deviation from mean
    var max_dev: i64 = 0;
    wi = n - window;
    while wi < n {
        let dev: i64 = vec_get(losses, wi) - mean;
        let abs_dev: i64 = fabs(dev);
        if abs_dev > max_dev {
            max_dev = abs_dev;
        }
        wi = wi + 1;
    }

    // Threshold for convergence: deviation < 10 (i.e., < 0.01 scaled x1000)
    let converged: i64 = 0;
    if max_dev < 10 {
        // converged
    } else {
        println("  FAIL: should detect convergence on plateau");
        return 1;
    }

    println("  PASS: convergence detection");
    0
}

// =============================================================================
// Test 8: Custom compression stage order
// =============================================================================

fn test_custom_stage_order() -> i64 {
    println("  Testing custom compression stage order...");

    // Only Pruning (1) then Quantization (2), no Distillation
    let stages: i64 = vec_new();
    vec_push(stages, 1);
    vec_push(stages, 2);

    let executed: i64 = vec_new();
    var si: i64 = 0;
    while si < vec_len(stages) {
        vec_push(executed, vec_get(stages, si));
        si = si + 1;
    }

    if vec_len(executed) != 2 {
        println("  FAIL: should have 2 stages");
        return 1;
    }
    if vec_get(executed, 0) != 1 {
        println("  FAIL: first stage should be Pruning (1)");
        return 1;
    }
    if vec_get(executed, 1) != 2 {
        println("  FAIL: second stage should be Quantization (2)");
        return 1;
    }

    println("  PASS: custom compression stage order");
    0
}

// =============================================================================
// Test 9: Selective schedule updates
// =============================================================================

fn test_selective_updates() -> i64 {
    println("  Testing selective schedule updates...");

    // Schedule params: [lr, temp, sparsity, bits, curriculum]
    let sched: i64 = vec_new();
    vec_push(sched, 100);
    vec_push(sched, 5000);
    vec_push(sched, 500);
    vec_push(sched, 8000);
    vec_push(sched, 200);

    let initial_lr: i64 = vec_get(sched, 0);
    let initial_temp: i64 = vec_get(sched, 1);

    // Enabled flags: only LR (index 0) is enabled
    let enabled: i64 = vec_new();
    vec_push(enabled, 1); // lr: enabled
    vec_push(enabled, 0); // temp: disabled
    vec_push(enabled, 0);
    vec_push(enabled, 0);
    vec_push(enabled, 0);

    let grad: i64 = vec_new();
    vec_push(grad, 500);
    vec_push(grad, 500);
    vec_push(grad, 500);
    vec_push(grad, 500);
    vec_push(grad, 500);

    let meta_lr: i64 = 10;
    var i: i64 = 0;
    while i < 5 {
        if vec_get(enabled, i) == 1 {
            let param: i64 = vec_get(sched, i);
            let g: i64 = vec_get(grad, i);
            let update: i64 = (meta_lr * g) / 1000;
            vec_set(sched, i, param - update);
        }
        i = i + 1;
    }

    if vec_get(sched, 0) == initial_lr {
        println("  FAIL: LR should be updated (enabled)");
        return 1;
    }
    if vec_get(sched, 1) != initial_temp {
        println("  FAIL: temp should NOT be updated (disabled)");
        return 1;
    }

    println("  PASS: selective schedule updates");
    0
}

// =============================================================================
// Test 10: Grad norm tracking
// =============================================================================

fn test_grad_norm_tracking() -> i64 {
    println("  Testing gradient norm tracking...");

    let norms: i64 = vec_new();
    var i: i64 = 0;
    while i < 10 {
        // Simulate increasing gradient norms
        let norm: i64 = (i + 1) * 100;
        vec_push(norms, norm);
        i = i + 1;
    }

    if vec_len(norms) != 10 {
        println("  FAIL: should have 10 recorded norms");
        return 1;
    }

    // Average norm
    var total: i64 = 0;
    var j: i64 = 0;
    while j < vec_len(norms) {
        total = total + vec_get(norms, j);
        j = j + 1;
    }
    let avg: i64 = total / vec_len(norms);
    if avg <= 0 {
        println("  FAIL: average norm should be positive");
        return 1;
    }

    // Recent norm (last 5)
    var recent_total: i64 = 0;
    var k: i64 = 5;
    while k < 10 {
        recent_total = recent_total + vec_get(norms, k);
        k = k + 1;
    }
    let recent_avg: i64 = recent_total / 5;
    if recent_avg <= 0 {
        println("  FAIL: recent norm should be positive");
        return 1;
    }

    println("  PASS: gradient norm tracking");
    0
}

// =============================================================================
// Main
// =============================================================================

fn main() -> i64 {
    println("=== Meta-Training Pipeline Integration Tests ===");
    var failures: i64 = 0;
    failures = failures + test_meta_optimizer_updates_all();
    failures = failures + test_gradient_clipping();
    failures = failures + test_curriculum_ordering();
    failures = failures + test_compression_stages_order();
    failures = failures + test_quality_gate_enforcement();
    failures = failures + test_meta_loss_convergence();
    failures = failures + test_convergence_detection();
    failures = failures + test_custom_stage_order();
    failures = failures + test_selective_updates();
    failures = failures + test_grad_norm_tracking();
    println("");
    if failures == 0 {
        println("All 10 meta-training integration tests passed!");
    } else {
        println(string_concat("FAILED: ", string_concat(int_to_string(failures), " test(s) failed")));
    }
    failures
}
