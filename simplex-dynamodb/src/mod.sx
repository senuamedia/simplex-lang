            return parse_query_response(resp_body);
        }
    }
    parse_dynamo_error(resp_body)
}

/// Delete an item from a DynamoDB table.
///
/// # Arguments
/// - `table`: Table name string
/// - `key`: Key JSON object with typed attributes
/// - `config`: AWS config vec
///
/// # Returns
/// Result vec: [1, 1, "", ""] on success
pub fn dynamo_delete(table: i64, key: i64, config: i64) -> i64 {
    let body: i64 = build_delete_request(table, key);
    let resp: i64 = dynamo_request("DynamoDB_20120810.DeleteItem", body, config);
    let status: i64 = vec_get(resp, 0);
    let resp_body: i64 = vec_get(resp, 1);

    if status >= 200 {
        if status < 300 {
            return parse_delete_response(resp_body);
        }
    }
    parse_dynamo_error(resp_body)
}

/// Update an item in a DynamoDB table.
///
/// # Arguments
/// - `table`: Table name string
/// - `key`: Key JSON object
/// - `update_expr`: Update expression (e.g. "SET #n = :name")
/// - `values`: Expression attribute values
/// - `config`: AWS config vec
///
/// # Returns
/// Result vec with data being the updated item attributes
pub fn dynamo_update(table: i64, key: i64, update_expr: i64, values: i64, config: i64) -> i64 {
    let body: i64 = build_update_request(table, key, update_expr, values);
    let resp: i64 = dynamo_request("DynamoDB_20120810.UpdateItem", body, config);
    let status: i64 = vec_get(resp, 0);
    let resp_body: i64 = vec_get(resp, 1);

    if status >= 200 {
        if status < 300 {
            return parse_update_response(resp_body);
        }
    }
    parse_dynamo_error(resp_body)
}

/// Update an item with expression attribute name mapping.
///
/// Use this when attribute names conflict with DynamoDB reserved words.
///
/// # Arguments
/// - `names`: JSON object mapping placeholders to real names (e.g. {"#n": "name"})
pub fn dynamo_update_with_names(table: i64, key: i64, update_expr: i64, values: i64, names: i64, config: i64) -> i64 {
    let body: i64 = build_update_with_names(table, key, update_expr, values, names);
    let resp: i64 = dynamo_request("DynamoDB_20120810.UpdateItem", body, config);
    let status: i64 = vec_get(resp, 0);
    let resp_body: i64 = vec_get(resp, 1);

    if status >= 200 {
        if status < 300 {
            return parse_update_response(resp_body);
        }
    }
    parse_dynamo_error(resp_body)
}

/// Scan all items in a table (expensive, use sparingly).
pub fn dynamo_scan(table: i64, config: i64) -> i64 {
    let body: i64 = build_scan_request(table);
    let resp: i64 = dynamo_request("DynamoDB_20120810.Scan", body, config);
    let status: i64 = vec_get(resp, 0);
    let resp_body: i64 = vec_get(resp, 1);

    if status >= 200 {
        if status < 300 {
            return parse_query_response(resp_body);
        }
    }
    parse_dynamo_error(resp_body)
}

/// Scan with a filter expression.
pub fn dynamo_scan_filtered(table: i64, filter: i64, values: i64, config: i64) -> i64 {
    let body: i64 = build_scan_filtered(table, filter, values);
    let resp: i64 = dynamo_request("DynamoDB_20120810.Scan", body, config);
    let status: i64 = vec_get(resp, 0);
    let resp_body: i64 = vec_get(resp, 1);

    if status >= 200 {
        if status < 300 {
            return parse_query_response(resp_body);
        }
    }
    parse_dynamo_error(resp_body)
}

/// Batch get items from a table (up to 100 keys).
pub fn dynamo_batch_get(table: i64, keys: i64, config: i64) -> i64 {
    let body: i64 = build_batch_get_request(table, keys);
    let resp: i64 = dynamo_request("DynamoDB_20120810.BatchGetItem", body, config);
    let status: i64 = vec_get(resp, 0);
    let resp_body: i64 = vec_get(resp, 1);

    if status >= 200 {
        if status < 300 {
            return parse_batch_get_response(resp_body, table);
        }
    }
    parse_dynamo_error(resp_body)
}

/// Batch put items into a table (up to 25 items).
pub fn dynamo_batch_put(table: i64, items: i64, config: i64) -> i64 {
    let count: i64 = vec_len(items);
    if count > 25 {
        return result_err("ValidationError", "Batch write exceeds 25 items");
    }

    let body: i64 = build_batch_put_request(table, items);
    let resp: i64 = dynamo_request("DynamoDB_20120810.BatchWriteItem", body, config);
    let status: i64 = vec_get(resp, 0);
    let resp_body: i64 = vec_get(resp, 1);

    if status >= 200 {
        if status < 300 {
            return result_ok(1);
        }
    }
    parse_dynamo_error(resp_body)
}

// =============================================================================
// Query Result Accessors
// =============================================================================

/// Get items array from query result data
pub fn query_items(query_data: i64) -> i64 {
    vec_get(query_data, 0)
}

/// Get count from query result data
pub fn query_count(query_data: i64) -> i64 {
    vec_get(query_data, 1)
}

/// Get scanned count from query result data
pub fn query_scanned_count(query_data: i64) -> i64 {
    vec_get(query_data, 2)
}

/// Get last evaluated key from query result data (0 if no more pages)
pub fn query_last_key(query_data: i64) -> i64 {
    if vec_len(query_data) > 3 {
        return vec_get(query_data, 3);
    }
    0
}

/// Check if query has more pages
pub fn query_has_more(query_data: i64) -> i64 {
    let last: i64 = query_last_key(query_data);
    if last != 0 { 1 } else { 0 }
}
