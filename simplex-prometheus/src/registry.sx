// simplex-prometheus::registry - Global Metric Registry
//
// The registry stores all registered metrics and provides lookup
// by name. It is used by the exposition module to iterate over
// all metrics when generating output.
//
// # Registry Vec Layout
//   The registry is a vec of metric vec handles.
//   Each registered metric is appended to this vec.
//
// # Example
//
// ```simplex
// let reg = prom_registry_new();
// let ctr = prom_counter_new("requests", "Total requests");
// prom_register(reg, ctr);
// let found = prom_registry_get(reg, "requests");
// ```
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

extern fn vec_new() -> i64;
extern fn vec_push(v: i64, val: i64) -> i64;
extern fn vec_get(v: i64, idx: i64) -> i64;
extern fn vec_set(v: i64, idx: i64, val: i64) -> i64;
extern fn vec_len(v: i64) -> i64;
extern fn intrinsic_string_eq(a: i64, b: i64) -> i64;

// =============================================================================
// Registry Creation
// =============================================================================

/// Create a new metric registry.
///
/// Returns a vec handle that stores registered metrics.
///
/// # Returns
/// Registry vec handle (i64)
pub fn prom_registry_new() -> i64 {
    vec_new()
}

// =============================================================================
// Registration
// =============================================================================

/// Register a metric in the registry.
///
/// The metric (counter, gauge, or histogram) is added to the registry.
/// Metrics can be looked up by name using prom_registry_get.
///
/// # Arguments
/// - `reg`: Registry vec handle
/// - `metric`: Metric vec handle (counter, gauge, or histogram)
///
/// # Returns
/// 0 on success
pub fn prom_register(reg: i64, metric: i64) -> i64 {
    vec_push(reg, metric);
    0
}

/// Unregister a metric by name.
///
/// Removes the first metric with the given name from the registry.
/// Note: This sets the slot to 0 (null), it does not compact the vec.
///
/// # Arguments
/// - `reg`: Registry vec handle
/// - `name`: Metric name to remove (string handle)
///
/// # Returns
/// 1 if found and removed, 0 if not found
pub fn prom_unregister(reg: i64, name: i64) -> i64 {
    let n: i64 = vec_len(reg);
    let i: i64 = 0;
    loop {
        if i >= n {
            break;
        }
        let metric: i64 = vec_get(reg, i);
        if metric != 0 {
            let mname: i64 = vec_get(metric, 1);
            if intrinsic_string_eq(mname, name) == 1 {
                vec_set(reg, i, 0);
                return 1;
            }
        }
        let i: i64 = i + 1;
    }
    0
}

// =============================================================================
// Lookup
// =============================================================================

/// Get a metric from the registry by name.
///
/// Searches the registry for a metric with the given name.
///
/// # Arguments
/// - `reg`: Registry vec handle
/// - `name`: Metric name to find (string handle)
///
/// # Returns
/// Metric vec handle if found, 0 if not found
pub fn prom_registry_get(reg: i64, name: i64) -> i64 {
    let n: i64 = vec_len(reg);
    let i: i64 = 0;
    loop {
        if i >= n {
            break;
        }
        let metric: i64 = vec_get(reg, i);
        if metric != 0 {
            let mname: i64 = vec_get(metric, 1);
            if intrinsic_string_eq(mname, name) == 1 {
                return metric;
            }
        }
        let i: i64 = i + 1;
    }
    0
}

/// Get the number of registered metrics.
///
/// Counts only non-null entries (unregistered metrics are skipped).
///
/// # Arguments
/// - `reg`: Registry vec handle
///
/// # Returns
/// Number of active metrics (i64)
pub fn prom_registry_count(reg: i64) -> i64 {
    let n: i64 = vec_len(reg);
    let count: i64 = 0;
    let i: i64 = 0;
    loop {
        if i >= n {
            break;
        }
        let metric: i64 = vec_get(reg, i);
        if metric != 0 {
            let count: i64 = count + 1;
        }
        let i: i64 = i + 1;
    }
    count
}

/// Get a metric by index in the registry.
///
/// # Arguments
/// - `reg`: Registry vec handle
/// - `idx`: Index in the registry
///
/// # Returns
/// Metric vec handle, or 0 if index is out of bounds
pub fn prom_registry_at(reg: i64, idx: i64) -> i64 {
    let n: i64 = vec_len(reg);
    if idx < 0 {
        return 0;
    }
    if idx >= n {
        return 0;
    }
    vec_get(reg, idx)
}

/// Get the raw length of the registry (including null entries).
///
/// # Arguments
/// - `reg`: Registry vec handle
///
/// # Returns
/// Raw registry length (i64)
pub fn prom_registry_len(reg: i64) -> i64 {
    vec_len(reg)
}

// =============================================================================
// Global Default Registry
// =============================================================================

/// Global default registry, lazily initialized.
///
/// Call prom_default_registry() to get or create the global registry.
/// All prom_global_* functions operate on this registry.

static mut GLOBAL_REGISTRY: i64 = 0;

/// Get or create the global default registry.
///
/// # Returns
/// Global registry vec handle (i64)
pub fn prom_default_registry() -> i64 {
    unsafe {
        if GLOBAL_REGISTRY == 0 {
            GLOBAL_REGISTRY = prom_registry_new();
        }
        GLOBAL_REGISTRY
    }
}

/// Register a metric in the global default registry.
///
/// # Arguments
/// - `metric`: Metric vec handle
pub fn prom_global_register(metric: i64) -> i64 {
    let reg: i64 = prom_default_registry();
    prom_register(reg, metric)
}

/// Get a metric from the global registry by name.
///
/// # Arguments
/// - `name`: Metric name (string handle)
///
/// # Returns
/// Metric vec handle if found, 0 if not found
pub fn prom_global_get(name: i64) -> i64 {
    let reg: i64 = prom_default_registry();
    prom_registry_get(reg, name)
}
