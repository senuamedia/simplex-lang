// simplex-prometheus - Prometheus Metrics for Simplex
//
// Provides Prometheus-compatible metric collection and exposition.
// All metrics are stored as vec handles (i64). Supports counters,
// gauges, and histograms with labels and the standard Prometheus
// text exposition format.
//
// # Modules
//
// - `counter`: Monotonically increasing counters
// - `gauge`: Values that can go up and down
// - `histogram`: Observation distribution with buckets
// - `registry`: Global metric registry
// - `exposition`: Prometheus text format output
// - `server`: HTTP /metrics endpoint
//
// # Example
//
// ```simplex
// use simplex_prometheus::counter::*;
// use simplex_prometheus::registry::*;
// use simplex_prometheus::exposition::*;
//
// fn main() {
//     let reg = prom_registry_new();
//     let ctr = prom_counter_new("http_requests_total", "Total HTTP requests");
//     prom_counter_inc(ctr);
//     prom_register(reg, ctr);
//     let output = prom_export(reg);
//     println(output);
// }
// ```
//
