// simplex-vectordb::filter - Metadata Filtering
//
// Filter search results based on metadata values.
// Supports combining vector similarity search with metadata constraints.
//
// Filter layout (vec of i64):
//   [0] filter_type   - FILTER_EQ, FILTER_NEQ, FILTER_GT, FILTER_LT, FILTER_AND, FILTER_OR
//   [1] field_key     - metadata field key (string handle or 0)
//   [2] field_value   - expected value (i64)
//   [3] sub_filter_a  - handle to first sub-filter (for AND/OR)
//   [4] sub_filter_b  - handle to second sub-filter (for AND/OR)
//
// Copyright (c) 2025-2026 Rod Higgins
// Licensed under AGPL-3.0

// =============================================================================
// Filter Type Constants
// =============================================================================

fn FILTER_EQ() -> i64    { 1 }
fn FILTER_NEQ() -> i64   { 2 }
fn FILTER_GT() -> i64    { 3 }
fn FILTER_LT() -> i64    { 4 }
fn FILTER_GTE() -> i64   { 5 }
fn FILTER_LTE() -> i64   { 6 }
fn FILTER_AND() -> i64   { 7 }
fn FILTER_OR() -> i64    { 8 }

// Filter field offsets
fn FILT_TYPE() -> i64       { 0 }
fn FILT_KEY() -> i64        { 1 }
fn FILT_VALUE() -> i64      { 2 }
fn FILT_SUB_A() -> i64      { 3 }
fn FILT_SUB_B() -> i64      { 4 }

// =============================================================================
// Filter Construction
// =============================================================================

/// Create an equality filter: metadata == value.
fn filter_eq(key: i64, value: i64) -> i64 {
    let f = vec_new();
    vec_push(f, FILTER_EQ());
    vec_push(f, key);
    vec_push(f, value);
    vec_push(f, 0);
    vec_push(f, 0);
    f
}

/// Create a not-equal filter: metadata != value.
fn filter_neq(key: i64, value: i64) -> i64 {
    let f = vec_new();
    vec_push(f, FILTER_NEQ());
    vec_push(f, key);
    vec_push(f, value);
    vec_push(f, 0);
    vec_push(f, 0);
    f
}

/// Create a greater-than filter: metadata > value.
fn filter_gt(key: i64, value: i64) -> i64 {
    let f = vec_new();
    vec_push(f, FILTER_GT());
    vec_push(f, key);
    vec_push(f, value);
    vec_push(f, 0);
    vec_push(f, 0);
    f
}

/// Create a less-than filter: metadata < value.
fn filter_lt(key: i64, value: i64) -> i64 {
    let f = vec_new();
    vec_push(f, FILTER_LT());
    vec_push(f, key);
    vec_push(f, value);
    vec_push(f, 0);
    vec_push(f, 0);
    f
}

/// Create an AND filter: both sub-filters must pass.
fn filter_and(a: i64, b: i64) -> i64 {
    let f = vec_new();
    vec_push(f, FILTER_AND());
    vec_push(f, 0);
    vec_push(f, 0);
    vec_push(f, a);
    vec_push(f, b);
    f
}

/// Create an OR filter: either sub-filter must pass.
fn filter_or(a: i64, b: i64) -> i64 {
    let f = vec_new();
    vec_push(f, FILTER_OR());
    vec_push(f, 0);
    vec_push(f, 0);
    vec_push(f, a);
    vec_push(f, b);
    f
}

// =============================================================================
// Filter Evaluation
// =============================================================================

/// Check if a metadata value passes a filter.
///
/// For simple filters (EQ, NEQ, GT, LT), metadata is treated as an i64.
/// For compound filters (AND, OR), recursively evaluates sub-filters.
///
/// Arguments:
///   filter   - filter handle
///   metadata - metadata value to check
///
/// Returns: 1 if passes, 0 if fails
fn filter_check(filter: i64, metadata: i64) -> i64 {
    if filter == 0 { return 1; }  // no filter = pass

    let ftype: i64 = vec_get(filter, FILT_TYPE());
    let value: i64 = vec_get(filter, FILT_VALUE());

    if ftype == FILTER_EQ() {
        if metadata == value { return 1; }
        return 0;
    }

    if ftype == FILTER_NEQ() {
        if metadata != value { return 1; }
        return 0;
    }

    if ftype == FILTER_GT() {
        if metadata > value { return 1; }
        return 0;
    }

    if ftype == FILTER_LT() {
        if metadata < value { return 1; }
        return 0;
    }

    if ftype == FILTER_GTE() {
        if metadata >= value { return 1; }
        return 0;
    }

    if ftype == FILTER_LTE() {
        if metadata <= value { return 1; }
        return 0;
    }

    if ftype == FILTER_AND() {
        let a: i64 = vec_get(filter, FILT_SUB_A());
        let b: i64 = vec_get(filter, FILT_SUB_B());
        let ra: i64 = filter_check(a, metadata);
        if ra == 0 { return 0; }
        return filter_check(b, metadata);
    }

    if ftype == FILTER_OR() {
        let a: i64 = vec_get(filter, FILT_SUB_A());
        let b: i64 = vec_get(filter, FILT_SUB_B());
        let ra: i64 = filter_check(a, metadata);
        if ra == 1 { return 1; }
        return filter_check(b, metadata);
    }

    0
}

// =============================================================================
// Filtered Search
// =============================================================================

/// Search with metadata filtering.
///
/// Performs a flat scan, checking both similarity and metadata filter.
///
/// Arguments:
///   store     - store handle
///   query_vec - handle to vec of f64_to_bits values
///   top_k     - number of results to return
///   filter    - filter handle (or 0 for no filter)
///
/// Returns: handle to result vec [ids_vec, scores_vec, count]
fn vdb_search_filtered(store: i64, query_vec: i64, top_k: i64, filter: i64) -> i64 {
    let dimension: i64 = vec_get(store, STORE_DIMENSION());
    let ids: i64 = vec_get(store, STORE_IDS());
    let embeddings: i64 = vec_get(store, STORE_EMBEDDINGS());
    let metadata_vec: i64 = vec_get(store, STORE_METADATA());
    let n_slots: i64 = vec_len(ids);

    let all_scores = vec_new();
    let all_indices = vec_new();
    var n_active: i64 = 0;

    var i: i64 = 0;
    while i < n_slots {
        let id: i64 = vec_get(ids, i);
        if id != -1 {
            let emb: i64 = vec_get(embeddings, i);
            if emb != 0 {
                // Check metadata filter
                let meta: i64 = vec_get(metadata_vec, i);
                let passes: i64 = filter_check(filter, meta);
                if passes == 1 {
                    let sim: i64 = cosine_similarity(query_vec, emb, dimension);
                    vec_push(all_scores, sim);
                    vec_push(all_indices, i);
                    n_active = n_active + 1;
                }
            }
        }
        i = i + 1;
    }

    // Select top-k
    var k: i64 = top_k;
    if k > n_active { k = n_active; }

    let result_ids = vec_new();
    let result_scores = vec_new();

    var found: i64 = 0;
    while found < k {
        var best_j: i64 = -1;
        var best_score: f64 = -999999.0;

        var j: i64 = 0;
        while j < n_active {
            let score: f64 = bits_to_f64(vec_get(all_scores, j));
            if score > best_score {
                best_score = score;
                best_j = j;
            }
            j = j + 1;
        }

        if best_j == -1 {
            found = k;
        } else {
            let internal_idx: i64 = vec_get(all_indices, best_j);
            let original_id: i64 = vec_get(ids, internal_idx);
            vec_push(result_ids, original_id);
            vec_push(result_scores, vec_get(all_scores, best_j));
            vec_set(all_scores, best_j, f64_to_bits(-1000000.0));
            found = found + 1;
        }
    }

    let result = vec_new();
    vec_push(result, result_ids);
    vec_push(result, result_scores);
    vec_push(result, found);
    result
}
