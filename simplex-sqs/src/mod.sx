// =============================================================================
// Batch Operations
// =============================================================================

/// Send a batch of messages (up to 10).
///
/// # Arguments
/// - `queue_url`: Full SQS queue URL
/// - `bodies`: Vec of message body strings
/// - `config`: AWS config
///
/// # Returns
/// Result vec with data being a vec of message IDs
pub fn sqs_send_batch(queue_url: i64, bodies: i64, config: i64) -> i64 {
    let count: i64 = vec_len(bodies);
    if count == 0 { return result_ok(vec_new()); }
    if count > 10 { return result_err("ValidationError", "Batch size exceeds 10"); }

    let sb: i64 = sb_new();
    sb_append(sb, "Action=SendMessageBatch");
    sb_append(sb, "&QueueUrl=");
    sb_append(sb, sqs_url_encode(queue_url));

    var i: i64 = 0;
    while i < count {
        let idx: i64 = i + 1;
        sb_append(sb, "&SendMessageBatchRequestEntry.");
        sb_append(sb, int_to_string(idx));
        sb_append(sb, ".Id=msg");
        sb_append(sb, int_to_string(idx));
        sb_append(sb, "&SendMessageBatchRequestEntry.");
        sb_append(sb, int_to_string(idx));
        sb_append(sb, ".MessageBody=");
        sb_append(sb, sqs_url_encode(vec_get(bodies, i)));
        i = i + 1;
    }
    sb_append(sb, "&Version=2012-11-05");

    let request_body: i64 = sb_to_string(sb);
    let host: i64 = sqs_host_from_url(queue_url);

    let req: i64 = http_request_new("POST", queue_url);
    http_request_header(req, "Content-Type", "application/x-www-form-urlencoded");
    http_request_header(req, "Host", host);
    http_request_body(req, request_body);

    let resp: i64 = http_request_send(req);
    let status: i64 = http_response_status(resp);
    let resp_body: i64 = http_response_body(resp);

    if status >= 200 {
        if status < 300 {
            // Parse batch response - extract all MessageId tags
            let ids: i64 = vec_new();
            var pos: i64 = 0;
            while pos >= 0 {
                let result: i64 = xml_extract_tag_pos(resp_body, "MessageId", pos);
                let msg_id: i64 = vec_get(result, 0);
                let next: i64 = vec_get(result, 1);
                if next < 0 {
                    pos = -1;
                    continue;
                }
                vec_push(ids, msg_id);
                pos = next;
            }
            return result_ok(ids);
        }
    }
    if xml_has_error(resp_body) == 1 {
        return result_err(xml_error_code(resp_body), xml_error_message(resp_body));
    }
    result_err("HttpError", string_concat("HTTP ", int_to_string(status)))
}

/// Delete a batch of messages (up to 10).
///
/// # Arguments
/// - `queue_url`: Full SQS queue URL
/// - `receipts`: Vec of receipt handle strings
/// - `config`: AWS config
pub fn sqs_delete_batch(queue_url: i64, receipts: i64, config: i64) -> i64 {
    let count: i64 = vec_len(receipts);
    if count == 0 { return result_ok(1); }
    if count > 10 { return result_err("ValidationError", "Batch size exceeds 10"); }

    let sb: i64 = sb_new();
    sb_append(sb, "Action=DeleteMessageBatch");
    sb_append(sb, "&QueueUrl=");
    sb_append(sb, sqs_url_encode(queue_url));

    var i: i64 = 0;
    while i < count {
        let idx: i64 = i + 1;
        sb_append(sb, "&DeleteMessageBatchRequestEntry.");
        sb_append(sb, int_to_string(idx));
        sb_append(sb, ".Id=msg");
        sb_append(sb, int_to_string(idx));
        sb_append(sb, "&DeleteMessageBatchRequestEntry.");
        sb_append(sb, int_to_string(idx));
        sb_append(sb, ".ReceiptHandle=");
        sb_append(sb, sqs_url_encode(vec_get(receipts, i)));
        i = i + 1;
    }
    sb_append(sb, "&Version=2012-11-05");

    let request_body: i64 = sb_to_string(sb);
    let host: i64 = sqs_host_from_url(queue_url);

    let req: i64 = http_request_new("POST", queue_url);
    http_request_header(req, "Content-Type", "application/x-www-form-urlencoded");
    http_request_header(req, "Host", host);
    http_request_body(req, request_body);

    let resp: i64 = http_request_send(req);
    let status: i64 = http_response_status(resp);
    let resp_body: i64 = http_response_body(resp);

    if status >= 200 {
        if status < 300 {
            return result_ok(1);
        }
    }
    if xml_has_error(resp_body) == 1 {
        return result_err(xml_error_code(resp_body), xml_error_message(resp_body));
    }
    result_err("HttpError", string_concat("HTTP ", int_to_string(status)))
}
